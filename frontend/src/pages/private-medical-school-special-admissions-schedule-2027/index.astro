---
import AdmissionsBrandDivider from "../../components/admissions/AdmissionsBrandDivider.astro";
import AdmissionsScheduleSwitcher from "../../components/admissions/AdmissionsScheduleSwitcher.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
  privateMedicalSpecialAdmissionsCalendar2027,
  privateMedicalSpecialAdmissionsDeadlines2027,
  privateMedicalSpecialAdmissionsExamEvents2027,
  privateMedicalSpecialAdmissionsRoutes2027,
  privateMedicalSpecialAdmissionsSourceUrls2027,
  privateMedicalSpecialAdmissionsSummary2027,
  privateMedicalSpecialAdmissionsUniversities2027,
  specialAdmissionCategoryLabels,
  type PrivateMedicalSpecialAdmissionsUniversity2027,
  type SpecialAdmissionCategory,
  type SpecialAdmissionEvent,
  type SpecialAdmissionEventStage,
  type SpecialAdmissionPublicationStatus,
  type SpecialAdmissionRoute,
} from "../../data/privateMedicalSpecialAdmissions2027";
import { privateMedicalSpecialAdmissions2027Metadata } from "../../data/privateMedicalSpecialAdmissions2027Metadata";
import "../../styles/special-admissions-2027.css";

const metadata = privateMedicalSpecialAdmissions2027Metadata;
const title = metadata.title;
const description = metadata.description;
const canonical = metadata.canonicalUrl;
const datasetUrl = metadata.datasetUrl;
const lastUpdated = metadata.dateModifiedLabel;

const publicationLabels: Record<SpecialAdmissionPublicationStatus, string> = {
  complete: "募集要項公表済み",
  partial: "一部要項公表済み",
  outline: "公式概要公表済み",
  unpublished: "2027年度詳細未公表",
  "previous-year-only": "前年度版のみ",
  "not-offered": "対象方式なし",
};

const scopeLabels = {
  available: "対象方式あり",
  unpublished: "2027年度未公表",
  "not-offered": "対象方式なし",
} as const;

const stageColumns: Array<{ key: SpecialAdmissionEventStage; short: string }> = [
  { key: "application-start", short: "出願開始" },
  { key: "application-deadline", short: "出願締切" },
  { key: "first-exam", short: "一次・試験" },
  { key: "first-result", short: "一次発表" },
  { key: "second-exam", short: "二次" },
  { key: "final-result", short: "最終発表" },
  { key: "procedure-deadline", short: "手続締切" },
];

const categoryDescriptions: Record<SpecialAdmissionCategory, string> = {
  comprehensive: "書類・面接・小論文などを通じて、活動実績や志望理由、人物面を総合的に評価する選抜です。大学によっては大学入学共通テストの得点も評価対象になるため、選考方法を確認しましょう。",
  recommendation: "学校長などの推薦を受けて出願する、公募制を中心とした選抜です。専願・併願の別、評定、卒業年度などの出願条件を確認しましょう。",
  designated: "大学が指定する高校や系列校の生徒を対象とする選抜です。対象校や出願条件は高校を通じて案内されることもあるため、早めに進路指導の先生へ確認しましょう。",
  regional: "出身地や居住地などの地域要件があり、卒業後の地域勤務や修学資金の利用を伴うこともある選抜です。勤務先・勤務期間や返還条件を含めて確認しましょう。",
  returnee: "海外での在学歴や帰国時期を出願条件とする、帰国生向けの選抜です。対象となる教育課程、海外在学期間、帰国後の経過年数を確認しましょう。",
  ib: "国際バカロレア（IB）などの国際資格を利用する選抜です。資格の取得時期、指定科目、スコア、英語資格の要件を確認しましょう。",
  international: "外国籍の受験生や外国の学校教育を受けた人などを対象とする選抜です。国籍、修学歴、在留資格、日本語力の要件を確認しましょう。",
  special: "卒業生の子女、研究医志望、英語資格、特定診療科志望など、大学独自の条件を設けた選抜です。対象者や必要資格、卒業後の進路条件を確認しましょう。",
};

const jpDate = (iso: string, includeYear = false) => {
  const date = new Date(`${iso}T00:00:00+09:00`);
  return new Intl.DateTimeFormat("ja-JP", {
    ...(includeYear ? { year: "numeric" as const } : {}),
    month: "numeric",
    day: "numeric",
    weekday: "short",
    timeZone: "Asia/Tokyo",
  }).format(date);
};

const shortUniversityName = (name: string) =>
  name === "日本大学" ? "日大" : name.replace(/大学$/, "");

const calendarDateParts = (iso: string) => {
  const [year, month, day] = iso.split("-").map(Number);
  const weekday = new Intl.DateTimeFormat("ja-JP", {
    weekday: "short",
    timeZone: "Asia/Tokyo",
  }).format(new Date(`${iso}T00:00:00+09:00`));

  return {
    year,
    monthDay: `${month}/${day}`,
    weekday,
  };
};

type DeadlineFlatEvent = (typeof privateMedicalSpecialAdmissionsDeadlines2027)[number];
type DeadlineRouteBundle = {
  date: string;
  universityId: string;
  university: string;
  routeId: string;
  routeName: string;
  eventsBySignature: Map<string, DeadlineFlatEvent>;
};
type DeadlineDisplayEntry = {
  universityId: string;
  university: string;
  routeKeys: string[];
  routeNames: string[];
  details: DeadlineFlatEvent[];
  sourceUrls: string[];
};

const deadlineEventSignature = (entry: DeadlineFlatEvent) =>
  JSON.stringify([
    entry.label,
    entry.time ?? null,
    entry.deadlineRule ?? null,
    entry.sourceUrl,
  ]);
const deadlineEventSort = (a: DeadlineFlatEvent, b: DeadlineFlatEvent) =>
  a.label.localeCompare(b.label, "ja") ||
  (a.time ?? "").localeCompare(b.time ?? "") ||
  (a.deadlineRule ?? "").localeCompare(b.deadlineRule ?? "") ||
  a.sourceUrl.localeCompare(b.sourceUrl);

const deadlineRouteBundles = new Map<string, DeadlineRouteBundle>();
privateMedicalSpecialAdmissionsDeadlines2027.forEach((entry) => {
  const routeKey = JSON.stringify([entry.date, entry.universityId, entry.routeId]);
  const routeBundle = deadlineRouteBundles.get(routeKey) ?? {
    date: entry.date,
    universityId: entry.universityId,
    university: entry.university,
    routeId: entry.routeId,
    routeName: entry.routeName,
    eventsBySignature: new Map<string, DeadlineFlatEvent>(),
  };
  routeBundle.eventsBySignature.set(deadlineEventSignature(entry), entry);
  deadlineRouteBundles.set(routeKey, routeBundle);
});

const deadlineDateBuckets = new Map<
  string,
  Map<
    string,
    {
      universityId: string;
      university: string;
      entriesByEventSet: Map<string, DeadlineDisplayEntry>;
    }
  >
>();

deadlineRouteBundles.forEach((routeBundle) => {
  const events = [...routeBundle.eventsBySignature.values()].sort(deadlineEventSort);
  const eventSetKey = JSON.stringify(events.map(deadlineEventSignature));
  const universityBuckets = deadlineDateBuckets.get(routeBundle.date) ?? new Map();
  const universityBucket = universityBuckets.get(routeBundle.universityId) ?? {
    universityId: routeBundle.universityId,
    university: routeBundle.university,
    entriesByEventSet: new Map<string, DeadlineDisplayEntry>(),
  };
  const displayEntry = universityBucket.entriesByEventSet.get(eventSetKey) ?? {
    universityId: routeBundle.universityId,
    university: routeBundle.university,
    routeKeys: [],
    routeNames: [],
    details: events,
    sourceUrls: [...new Set(events.map((entry) => entry.sourceUrl))],
  };

  const routeKey = `${routeBundle.universityId}/${routeBundle.routeId}`;
  if (!displayEntry.routeKeys.includes(routeKey)) {
    displayEntry.routeKeys.push(routeKey);
  }
  if (!displayEntry.routeNames.includes(routeBundle.routeName)) {
    displayEntry.routeNames.push(routeBundle.routeName);
  }
  universityBucket.entriesByEventSet.set(eventSetKey, displayEntry);
  universityBuckets.set(routeBundle.universityId, universityBucket);
  deadlineDateBuckets.set(routeBundle.date, universityBuckets);
});

const deadlineGroups = [...deadlineDateBuckets.entries()]
  .sort(([dateA], [dateB]) => dateA.localeCompare(dateB))
  .map(([date, universityBuckets]) => {
    const entries = [...universityBuckets.values()]
      .sort((a, b) => a.university.localeCompare(b.university, "ja"))
      .flatMap((universityBucket) =>
        [...universityBucket.entriesByEventSet.values()].map((entry) => ({
          ...entry,
          routeKeys: [...entry.routeKeys].sort((a, b) => a.localeCompare(b)),
          routeNames: [...entry.routeNames].sort((a, b) => a.localeCompare(b, "ja")),
        })),
      );

    return {
      date,
      dateLabel: jpDate(date, true),
      dateParts: calendarDateParts(date),
      entries,
      routeCount: entries.reduce((sum, entry) => sum + entry.routeNames.length, 0),
    };
  });

const mostCrowdedDeadlineGroup = [...deadlineGroups].sort(
  (a, b) => b.routeCount - a.routeCount || a.date.localeCompare(b.date),
)[0];

type ExamDisplayEntry = {
  universityId: string;
  university: string;
  routeKeys: string[];
  routeNames: string[];
  stage: "first-exam" | "second-exam";
  column: "single-exam" | "first-exam" | "second-exam";
  category: SpecialAdmissionCategory;
  label: string;
  sequence?: number;
  choiceRule?: string;
  sourceUrl: string;
};
type ExamDateBucket = {
  single: Map<string, ExamDisplayEntry>;
  first: Map<string, ExamDisplayEntry>;
  second: Map<string, ExamDisplayEntry>;
};

const examRouteKey = (entry: (typeof privateMedicalSpecialAdmissionsExamEvents2027)[number]) =>
  `${entry.universityId}/${entry.routeId}`;
const routesWithSecondExam = new Set(
  privateMedicalSpecialAdmissionsExamEvents2027
    .filter((entry) => entry.stage === "second-exam")
    .map(examRouteKey),
);

const examDateBuckets = new Map<string, ExamDateBucket>();
privateMedicalSpecialAdmissionsExamEvents2027.forEach((entry) => {
  const stage = entry.stage === "first-exam" ? "first-exam" : "second-exam";
  const routeKey = examRouteKey(entry);
  const column = routesWithSecondExam.has(routeKey) ? stage : "single-exam";
  const dateBucket = examDateBuckets.get(entry.date) ?? {
    single: new Map<string, ExamDisplayEntry>(),
    first: new Map<string, ExamDisplayEntry>(),
    second: new Map<string, ExamDisplayEntry>(),
  };
  const eventKey = JSON.stringify([
    entry.universityId,
    stage,
    column,
    entry.category,
    entry.label,
    entry.sequence ?? null,
    entry.choiceRule ?? null,
    entry.sourceUrl,
  ]);
  const stageBucket =
    column === "single-exam"
      ? dateBucket.single
      : column === "first-exam"
        ? dateBucket.first
        : dateBucket.second;
  const displayEntry: ExamDisplayEntry = stageBucket.get(eventKey) ?? {
    universityId: entry.universityId,
    university: entry.university,
    routeKeys: [],
    routeNames: [],
    stage,
    column,
    category: entry.category,
    label: entry.label,
    sequence: entry.sequence,
    choiceRule: entry.choiceRule,
    sourceUrl: entry.sourceUrl,
  };

  if (!displayEntry.routeKeys.includes(routeKey)) {
    displayEntry.routeKeys.push(routeKey);
  }
  if (!displayEntry.routeNames.includes(entry.routeName)) {
    displayEntry.routeNames.push(entry.routeName);
  }
  stageBucket.set(eventKey, displayEntry);
  examDateBuckets.set(entry.date, dateBucket);
});

const examEntrySort = (a: ExamDisplayEntry, b: ExamDisplayEntry) =>
  a.university.localeCompare(b.university, "ja") ||
  a.label.localeCompare(b.label, "ja") ||
  a.routeNames[0].localeCompare(b.routeNames[0], "ja");

const examGroups = [...examDateBuckets.entries()]
  .sort(([dateA], [dateB]) => dateA.localeCompare(dateB))
  .map(([date, entries]) => ({
    date,
    ...calendarDateParts(date),
    single: [...entries.single.values()]
      .map((entry) => ({
        ...entry,
        routeKeys: [...entry.routeKeys].sort((a, b) => a.localeCompare(b)),
        routeNames: [...entry.routeNames].sort((a, b) => a.localeCompare(b, "ja")),
      }))
      .sort(examEntrySort),
    first: [...entries.first.values()]
      .map((entry) => ({
        ...entry,
        routeKeys: [...entry.routeKeys].sort((a, b) => a.localeCompare(b)),
        routeNames: [...entry.routeNames].sort((a, b) => a.localeCompare(b, "ja")),
      }))
      .sort(examEntrySort),
    second: [...entries.second.values()]
      .map((entry) => ({
        ...entry,
        routeKeys: [...entry.routeKeys].sort((a, b) => a.localeCompare(b)),
        routeNames: [...entry.routeNames].sort((a, b) => a.localeCompare(b, "ja")),
      }))
      .sort(examEntrySort),
  }));

const categoryEntries = (Object.keys(specialAdmissionCategoryLabels) as SpecialAdmissionCategory[]).map(
  (category) => {
    const routes = privateMedicalSpecialAdmissionsRoutes2027.filter(({ route }) => route.category === category);
    const universityGroups = new Map<
      string,
      { university: PrivateMedicalSpecialAdmissionsUniversity2027; routes: SpecialAdmissionRoute[] }
    >();

    routes.forEach(({ university, route }) => {
      const existing = universityGroups.get(university.id);
      if (existing) {
        existing.routes.push(route);
        return;
      }
      universityGroups.set(university.id, { university, routes: [route] });
    });

    return {
      category,
      label: specialAdmissionCategoryLabels[category],
      description: categoryDescriptions[category],
      universities: [...universityGroups.values()],
    };
  },
);

const milestoneEvents = (events: SpecialAdmissionEvent[], stage: SpecialAdmissionEventStage) =>
  events.filter((entry) => entry.stage === stage);

