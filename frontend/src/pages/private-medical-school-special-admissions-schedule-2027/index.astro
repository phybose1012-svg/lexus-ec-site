const organizationId = "https://lexus-ec.com/#organization";
const websiteId = "https://lexus-ec.com/#website";
const webpageId = `${canonical}#webpage`;
const datasetId = metadata.datasetIdentifier;
const breadcrumbId = `${canonical}#breadcrumb`;
const itemListId = `${canonical}#universities`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": organizationId,
      name: metadata.publisher.name,
      alternateName: metadata.publisher.alternateName,
      url: metadata.publisher.url,
      logo: { "@type": "ImageObject", url: "https://lexus-ec.com/assets/optimized/header-logo-900.webp" },
    },
    { "@type": "WebSite", "@id": websiteId, url: "https://lexus-ec.com/", name: "医学部予備校 レクサス E.C.", inLanguage: "ja" },
    {
      "@type": "CollectionPage",
      "@id": webpageId,
      name: title,
      description,
      url: canonical,
      inLanguage: "ja",
      datePublished: metadata.datePublished,
      dateModified: metadata.dateModified,
      isPartOf: { "@id": websiteId },
      breadcrumb: { "@id": breadcrumbId },
      mainEntity: { "@id": datasetId },
      hasPart: { "@id": itemListId },
    },
    {
      "@type": "Dataset",
      "@id": datasetId,
      name: metadata.name,
      description,
      url: canonical,
      identifier: datasetId,
      inLanguage: "ja",
      datePublished: metadata.datePublished,
      dateModified: metadata.dateModified,
      version: metadata.version,
      creator: { "@id": organizationId },
      publisher: { "@id": organizationId },
      isAccessibleForFree: true,
      spatialCoverage: { "@type": "Country", name: "日本" },
      temporalCoverage: privateMedicalSpecialAdmissionsCalendar2027.length
        ? `${privateMedicalSpecialAdmissionsCalendar2027[0].date}/${privateMedicalSpecialAdmissionsCalendar2027.at(-1)?.date}`
        : undefined,
      isBasedOn: privateMedicalSpecialAdmissionsSourceUrls2027,
      distribution: { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: datasetUrl },
    },
    {
      "@type": "ItemList",
      "@id": itemListId,
      name: "2027年度 私立医学部 総合型・学校推薦型選抜等 31大学一覧",
      numberOfItems: privateMedicalSpecialAdmissionsSummary2027.universityCount,
      itemListElement: privateMedicalSpecialAdmissionsUniversities2027.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: { "@type": "CollegeOrUniversity", name: entry.name, url: `${canonical}#${entry.id}` },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": breadcrumbId,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ホーム", item: "https://lexus-ec.com/" },
        { "@type": "ListItem", position: 2, name: "私立医学部情報", item: "https://lexus-ec.com/top/information-shiritsu/" },
        { "@type": "ListItem", position: 3, name: "2027年度 総合型・学校推薦型選抜日程", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<SiteLayout title={title} description={description} canonical={canonical} ogImage="/og/private-medical-special-admissions-2027.png">
  <Fragment slot="head">
    <meta name="author" content={metadata.publisher.name} />
    <meta property="og:updated_time" content={metadata.dateModified} />
    <meta property="og:image:alt" content="2027年度 私立医学部 総合型・学校推薦型選抜 入試日程" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="application/json" title="2027年度 私立医学部 総合型・学校推薦型選抜 JSONデータ" href={datasetUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <main class="admissions-page special-admissions-page">
    <header class="admissions-print-branding" aria-label="医学部予備校レクサスE.C.">
      <img class="admissions-print-branding__character" src="/illustrations/characters/lexus-kun-exp.png" alt="レクサスくん" width="1170" height="1170" />
      <div>
        <img class="admissions-print-branding__logo" src="/assets/optimized/footer-logo-760.webp" alt="鬼特訓する医学部予備校レクサスE.C." width="760" height="300" />
        <p data-print-document-title>2027年度 総合型・学校推薦型選抜日程｜最終更新：{lastUpdated}</p>
      </div>
      <img class="admissions-print-branding__character" src="/illustrations/characters/yuki-sensei-default.png" alt="ゆうき先生" width="395" height="395" />
    </header>

    <section class="admissions-hero special-admissions-hero">
      <div class="content admissions-hero__inner">
        <nav class="admissions-breadcrumb admissions-breadcrumb--with-switcher" aria-label="パンくずリスト">
          <a href="/">ホーム</a><span aria-hidden="true">/</span>
          <a href="/top/information-shiritsu/">私立医学部情報</a><span aria-hidden="true">/</span>
          <span aria-current="page">2027年度 総合型・学校推薦型</span>
        </nav>
        <AdmissionsScheduleSwitcher current="special" />
        <div class="admissions-hero__grid">
          <div class="admissions-hero__copy">
            <p class="admissions-kicker"><span>2027</span> SPECIAL ADMISSIONS</p>
            <h1>2027年度 私立医学部 <br /><strong>総合型・学校推薦型選抜 入試日程</strong></h1>
            <p class="admissions-hero__lead">
              全国31大学の総合型・学校推薦型・地域枠・帰国生・IBなどを、<b>日程と出願条件</b>から確認できます。
              一般選抜・通常の共通テスト利用選抜は別ページに分けています。
            </p>
            <div class="admissions-hero__actions">
              <a class="admissions-primary-button" href="#deadlines">出願締切を見る</a>
              <a class="admissions-secondary-button" href="#universities">31大学から探す</a>
            </div>
          </div>
          <aside class="special-admissions-hero__summary" aria-label="掲載状況">
            <p>2027年度 調査対象</p>
            <strong><span>{privateMedicalSpecialAdmissionsSummary2027.universityCount}</span>大学</strong>
            <dl>
              <div><dt>掲載方式</dt><dd>{privateMedicalSpecialAdmissionsSummary2027.routeCount}方式</dd></div>
              <div><dt>対象方式あり</dt><dd>{privateMedicalSpecialAdmissionsSummary2027.availableUniversityCount}大学</dd></div>
              <div><dt>完成要項あり</dt><dd>{privateMedicalSpecialAdmissionsSummary2027.completeUniversityCount}大学</dd></div>
            </dl>
