const faqItems = [
  {
    question: "共通テストを使う総合型選抜は掲載されていますか？",
    answer: "はい。総合型・推薦型・特別選抜として実施され、選考の一部に共通テストを使う方式は掲載しています。通常の共通テスト利用選抜は対象外です。",
  },
  {
    question: "日程が「未公表」の大学は前年の日程を参考表示していますか？",
    answer: "いいえ。2027年度の公式資料で確認できない日付は、前年値や推測で補わず「未公表」と表示しています。",
  },
  {
    question: "指定校推薦は誰でも出願できますか？",
