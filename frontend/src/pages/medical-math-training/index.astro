---
import LegacyArticlePage from "../../components/fixed/LegacyArticlePage.astro";

const scrollHint = /<div\b[^>]*\bclass="[^"]*\belementor-element-eb93a02\b[^"]*"[^>]*>\s*<div\b[^>]*>\s*<p>\s*←\s*ｓｃｒｏｌｌ\s*→\s*<\/p>\s*<\/div>\s*<\/div>/u;
---

<LegacyArticlePage
  path="/medical-math-training/"
  eyebrow="ABOUT"
  heading="医学部数学を完全攻略する“鬼特訓”"
  fromHeading="学習の流れ"
  transformContent={(body) => body.replace(scrollHint, "")}
/>

<style>
  :global(.legacy-article-body .elementor-icon-list-item:has(> a[href="tel:0334771306"])) {
    border-inline-start: 0;
    text-align: center;
  }
</style>
