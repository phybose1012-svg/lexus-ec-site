---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import "../../../styles/past-exam-library.css";
import "../../../styles/past-exam-university.css";

const title = "岩手医科大学 医学部の過去問｜年度・科目から探す｜レクサス教育センター";
const description =
  "岩手医科大学医学部の過去問を年度・科目別に整理しています。2025年度一般選抜の問題・解答の公開状況と、科目別分析をご案内します。";
const canonical = "https://lexus-ec.com/past-exam-library/iwate-medical/";

const librarySteps = [
  { number: "01", label: "年度", value: "2025年度", href: "#year-2025", tone: "selected" },
  { number: "02", label: "科目", value: "4科目", href: "#subjects", tone: "selected" },
  { number: "03", label: "問題", value: "確認中", href: "#subjects", tone: "waiting" },
  { number: "04", label: "解答", value: "準備中", href: "#subjects", tone: "waiting" },
  { number: "05", label: "分析", value: "閲覧可", href: "#subjects", tone: "ready" },
] as const;

const subjects = [
  {
    index: "01",
    name: "数学",
    english: "MATHEMATICS",
    tone: "mathematics",
    problem: "確認中",
    problemTone: "waiting",
    answer: "準備中",
    answerTone: "waiting",
    analysisPath: "/iwateika-university-entrance-exam-measures2027/#数学",
  },
  {
    index: "02",
    name: "化学",
    english: "CHEMISTRY",
    tone: "chemistry",
    problem: "権利確認中",
    problemTone: "waiting",
    answer: "準備中",
    answerTone: "waiting",
    analysisPath: "/iwateika-university-entrance-exam-measures2027/#化学",
  },
  {
    index: "03",
    name: "物理",
    english: "PHYSICS",
    tone: "physics",
    problem: "図版確認中",
    problemTone: "waiting",
    answer: "準備中",
    answerTone: "waiting",
    analysisPath: "/iwateika-university-entrance-exam-measures2027/#物理",
  },
  {
    index: "04",
    name: "生物",
    english: "BIOLOGY",
    tone: "biology",
    problem: "未収録",
    problemTone: "empty",
    answer: "未収録",
    answerTone: "empty",
    analysisPath: "/iwateika-university-entrance-exam-measures2027/#生物",
  },
] as const;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: "ja",
      isPartOf: {
        "@type": "WebSite",
        "@id": "https://lexus-ec.com/#website",
        url: "https://lexus-ec.com/",
        name: "医学部予備校 レクサス E.C.",
      },
      publisher: {
        "@type": "EducationalOrganization",
        "@id": "https://lexus-ec.com/#organization",
        name: "レクサス教育センター",
        url: "https://lexus-ec.com/",
      },
      breadcrumb: { "@id": `${canonical}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ホーム", item: "https://lexus-ec.com/" },
        {
          "@type": "ListItem",
          position: 2,
          name: "私立医学部情報",
          item: "https://lexus-ec.com/top/information-shiritsu/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "過去問ライブラリー",
          item: "https://lexus-ec.com/past-exam-library/",
        },
        { "@type": "ListItem", position: 4, name: "岩手医科大学", item: canonical },
      ],
    },
  ],
};
---

<SiteLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="/assets/legacy/wp-content/uploads/2024/09/新レクサス1-e1726564535383.png"
>
  <Fragment slot="head">
    <meta name="author" content="医学部予備校 レクサス E.C." />
    <meta name="robots" content="noindex,follow" />
    <meta property="og:image:alt" content="医学部予備校レクサス E.C.のキャラクター" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <main class="exam-library-page exam-university-page">
    <header class="exam-university-header">
      <div class="content exam-university-header__inner">
        <nav class="exam-library-breadcrumb" aria-label="パンくずリスト">
          <a href="/">ホーム</a>
          <span aria-hidden="true">/</span>
          <a href="/past-exam-library/">過去問ライブラリー</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">岩手医科大学</span>
        </nav>

        <div class="exam-university-header__grid">
          <div>
            <p class="exam-university-kicker">PAST EXAM LIBRARY</p>
            <h1>
              岩手医科大学
              <span>過去問ライブラリー</span>
            </h1>
            <p class="exam-university-header__meta">2025年度　一般選抜・一次試験</p>
          </div>

          <aside class="exam-university-current" aria-label="現在の公開状況">
            <span>現在の公開状況</span>
            <strong>3科目を準備中・生物は未収録</strong>
            <small>科目別分析は閲覧できます</small>
          </aside>
        </div>
      </div>
    </header>

    <nav class="exam-university-map" aria-label="過去問ライブラリーの構成">
      <div class="content exam-university-map__inner">
        {
          librarySteps.map((step) => (
            <a class={`is-${step.tone}`} href={step.href}>
              <span>{step.number}</span>
              <strong>{step.label}</strong>
              <small>{step.value}</small>
            </a>
          ))
        }
      </div>
    </nav>

    <section class="exam-university-browser" id="year-2025" aria-labelledby="year-2025-title">
      <div class="content">
        <header class="exam-university-toolbar">
          <div class="exam-university-year-label">
            <span>年度</span>
            <h2 id="year-2025-title">2025年度</h2>
          </div>
          <dl>
            <div>
              <dt>試験区分</dt>
              <dd>一般選抜</dd>
            </div>
            <div>
              <dt>試験段階</dt>
              <dd>一次試験</dd>
            </div>
          </dl>
          <a href="/past-exam-library/">大学一覧へ戻る</a>
        </header>

        <div class="exam-university-table-wrap" id="subjects">
          <table class="exam-university-table">
            <caption>2025年度 岩手医科大学 一般選抜・一次試験の科目別公開状況</caption>
            <thead>
              <tr>
                <th scope="col">科目</th>
                <th scope="col">問題</th>
                <th scope="col">解答</th>
                <th scope="col">分析</th>
              </tr>
            </thead>
            <tbody>
              {
                subjects.map((subject) => (
                  <tr class={`is-${subject.tone}`}>
                    <th scope="row">
                      <span class="exam-university-subject">
                        <span>{subject.index}</span>
                        <span>
                          <strong>{subject.name}</strong>
                          <small>{subject.english}</small>
                        </span>
                      </span>
                    </th>
                    <td data-label="問題">
                      <span class={`exam-university-state is-${subject.problemTone}`}>{subject.problem}</span>
                    </td>
                    <td data-label="解答">
                      <span class={`exam-university-state is-${subject.answerTone}`}>{subject.answer}</span>
                    </td>
                    <td data-label="分析">
                      <a
                        class="exam-university-analysis-link"
                        href={subject.analysisPath}
                        aria-label={`${subject.name}の分析を見る`}
                      >
                        分析を見る <span aria-hidden="true">→</span>
                      </a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="exam-university-info-row">
          <aside class="exam-university-notice">
            <strong>問題・解答について</strong>
            <p>内容・権利・表示の確認が完了した科目から閲覧リンクを表示します。</p>
          </aside>
          <ul class="exam-university-checks" aria-label="公開前の確認項目">
            <li><span>01</span>内容確認</li>
            <li><span>02</span>権利確認</li>
            <li><span>03</span>表示確認</li>
          </ul>
        </div>
      </div>
    </section>

    <nav class="exam-university-links" aria-label="岩手医科大学の関連情報">
      <div class="content">
        <a href="/past-exam-library/">
          <span>大学一覧</span>
          <strong>過去問ライブラリー</strong>
        </a>
        <a href="/iwateika-university-entrance-exam-measures2027/">
          <span>傾向と対策</span>
          <strong>2027年度 一般選抜対策</strong>
        </a>
        <a href="/information-iwate/">
          <span>大学情報</span>
          <strong>岩手医科大学 入試情報</strong>
        </a>
      </div>
    </nav>
  </main>
</SiteLayout>
