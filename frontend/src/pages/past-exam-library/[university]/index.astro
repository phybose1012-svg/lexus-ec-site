---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import PastExamBreadcrumbs from "../../../components/past-exam/PastExamBreadcrumbs.astro";
import PastExamSeoHead from "../../../components/past-exam/PastExamSeoHead.astro";
import { buildPastExamPageSeo, PAST_EXAM_SOCIAL_IMAGE, PAST_EXAM_SOCIAL_IMAGE_ALT } from "../../../lib/pastExamSeo.mjs";
import {
  universityLibraries,
  subjectRowsFor,
  librarySummaryFor,
  type UniversityLibrary,
} from "../../../data/pastExamUniversities";
import "../../../styles/past-exam-library.css";
import "../../../styles/past-exam-university.css";

export const getStaticPaths = () =>
  universityLibraries.map((library) => ({ params: { university: library.id }, props: { library } }));

const { library } = Astro.props as { library: UniversityLibrary };

const examYears = library.years.map((entry) => ({ ...entry, subjects: subjectRowsFor(library, entry.year) }));
const readyYears = examYears.filter((entry) => entry.subjects.some((subject) => subject.problemPath));
const summary = librarySummaryFor(library);
const firstYear = library.years[0].year;
const lastYear = library.years[library.years.length - 1].year;
const anchorYear = readyYears[0]?.year ?? firstYear;

const title = `${library.name}医学部の過去問一覧｜レクサス教育センター`;
const publishedSubjects = examYears
  .flatMap((entry) => entry.subjects.filter((subject) => subject.problemPath).map((subject) => `${entry.year}年度${subject.name}`))
  .join("・");
const description = `${library.name}医学部の過去問を年度・科目別に探せます。${firstYear}〜${lastYear}年度の掲載状況と、${
  publishedSubjects || "掲載準備中の年度・科目"
}の問題・解答解説・分析をご案内。準備中の年度・科目も一覧で確認できます。`;
const canonical = `https://lexus-ec.com/past-exam-library/${library.id}/`;

const librarySteps = [
  { number: "01", label: "年度", value: `${summary.years}年分`, href: "#years", tone: "selected" },
  { number: "02", label: "科目", value: `${summary.subjects}科目`, href: "#subjects", tone: "selected" },
  { number: "03", label: "問題", value: `${summary.questions}科目`, href: `#year-${anchorYear}`, tone: summary.questions ? "ready" : "selected" },
  { number: "04", label: "解答", value: `${summary.answers}科目`, href: `#year-${anchorYear}`, tone: summary.answers ? "ready" : "selected" },
  { number: "05", label: "分析", value: summary.analyses ? "閲覧可" : "準備中", href: "#subjects", tone: summary.analyses ? "ready" : "selected" },
];

const { breadcrumbs, structuredData } = buildPastExamPageSeo({
  title, description, path: canonical, collection: true,
  breadcrumbs: [
    { name: "ホーム", path: "/" },
    { name: "過去問ライブラリー", path: "/past-exam-library/" },
    { name: library.name, path: `/past-exam-library/${library.id}/` },
  ],
});
---

<SiteLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={PAST_EXAM_SOCIAL_IMAGE}
  ogImageAlt={PAST_EXAM_SOCIAL_IMAGE_ALT}
  mainContentId="past-exam-content"
  noindex={true}
>
  <Fragment slot="head">
    <meta name="author" content="医学部予備校 レクサス E.C." />
    <PastExamSeoHead structuredData={structuredData} />
  </Fragment>

  <main id="past-exam-content" tabindex="-1" class="exam-library-page exam-university-page">
    <header class="exam-university-header">
      <div class="content exam-university-header__inner">
        <PastExamBreadcrumbs items={breadcrumbs} />

        <div class="exam-university-header__grid">
          <div>
            <p class="exam-university-kicker">PAST EXAM LIBRARY</p>
            <h1>
              {library.name}
              <span>過去問ライブラリー</span>
            </h1>
            <p class="exam-university-header__meta">{firstYear}〜{lastYear}年度　{summary.years}年分</p>
          </div>

          <aside class="exam-university-current" aria-label="現在の公開状況">
            <span>現在の公開状況</span>
            <strong>{summary.years}年分の掲載枠を用意しました</strong>
            <small>{library.currentStatus}</small>
          </aside>
        </div>
      </div>
    </header>

    <nav class="exam-university-map" aria-label="過去問ライブラリーの構成">
      <div class="content exam-university-map__inner">
        {
          librarySteps.map((step) => (
            <a class={`is-${step.tone}`} href={step.href}>
              <span>{step.number}</span>
              <strong>{step.label}</strong>
              <small>{step.value}</small>
            </a>
          ))
        }
      </div>
    </nav>

    <div class="exam-university-browser" id="years">
      <div class="content">
        <header class="exam-university-year-index-heading">
          <div>
            <p>YEAR INDEX</p>
            <h2 id="year-index-title">年度を選ぶ</h2>
          </div>
          <a href="/past-exam-library/">大学一覧へ戻る</a>
        </header>

        <nav class="exam-university-year-nav" aria-labelledby="year-index-title">
          {
            examYears.map((examYear) => (
              <a class={`is-${examYear.tone}`} href={`#year-${examYear.year}`}>
                <strong>{examYear.year}</strong>
                <span>年度</span>
                <small>{examYear.label}</small>
              </a>
            ))
          }
        </nav>

        <div class="exam-university-year-list" id="subjects">
          {
            examYears.map((examYear) => (
              <section
                class={`exam-university-year-section is-${examYear.tone}`}
                id={`year-${examYear.year}`}
                aria-labelledby={`year-${examYear.year}-title`}
              >
                <header class="exam-university-toolbar">
                  <div class="exam-university-year-label">
                    <span>年度</span>
                    <h3 id={`year-${examYear.year}-title`}>{examYear.year}年度</h3>
                  </div>
                  <dl>
                    <div>
                      <dt>試験区分</dt>
                      <dd>{library.examLabel}</dd>
                    </div>
                    <div>
                      <dt>試験段階</dt>
                      <dd>{library.stageLabel}</dd>
                    </div>
                  </dl>
                  <span class={`exam-university-year-status is-${examYear.tone}`}>{examYear.label}</span>
                </header>

                <div class="exam-university-table-wrap">
                  <table class="exam-university-table">
                    <caption>{examYear.year}年度 {library.name} {library.examLabel}・{library.stageLabel}の科目別公開状況</caption>
                    <thead>
                      <tr>
                        <th scope="col">科目</th>
                        <th scope="col">問題</th>
                        <th scope="col">解答</th>
                        <th scope="col">分析</th>
                      </tr>
                    </thead>
                    <tbody>
                      {examYear.subjects.map((subject) => (
                        <tr class={`is-${subject.tone}`}>
                          <th scope="row">
                            <span class="exam-university-subject">
                              <span>{subject.index}</span>
                              <span>
                                <strong>{subject.name}</strong>
                                <small>{subject.english}</small>
                              </span>
                            </span>
                          </th>
                          <td data-label="問題">
                            {subject.problemPath ? (
                              <a
                                class="exam-university-question-link"
                                href={subject.problemPath}
                                aria-label={`${examYear.year}年度 ${subject.name}の問題を見る`}
                              >
                                {subject.problem} <span aria-hidden="true">→</span>
                              </a>
                            ) : (
                              <span class={`exam-university-state is-${subject.problemTone}`}>{subject.problem}</span>
                            )}
                          </td>
                          <td data-label="解答">
                            {subject.answerPath ? (
                              <a
                                class="exam-university-answer-link"
                                href={subject.answerPath}
                                aria-label={`${examYear.year}年度 ${subject.name}の解答・解説を見る`}
                              >
                                {subject.answer} <span aria-hidden="true">→</span>
                              </a>
                            ) : (
                              <span class={`exam-university-state is-${subject.answerTone}`}>{subject.answer}</span>
                            )}
                          </td>
                          <td data-label="分析">
                            {subject.analysisPath ? (
                              <a
                                class="exam-university-analysis-link"
                                href={subject.analysisPath}
                                aria-label={`${examYear.year}年度 ${subject.name}の分析を見る`}
                              >
                                {subject.analysis} <span aria-hidden="true">→</span>
                              </a>
                            ) : (
                              <span class={`exam-university-state is-${subject.analysisTone}`}>
                                {subject.analysis}
                              </span>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            ))
          }
        </div>

        <div class="exam-university-info-row">
          <aside class="exam-university-notice">
            <strong>問題・解答について</strong>
            <p>内容・権利・表示の確認が完了した科目から閲覧リンクを表示します。</p>
          </aside>
          <ul class="exam-university-checks" aria-label="公開前の確認項目">
            <li><span>01</span>内容確認</li>
            <li><span>02</span>権利確認</li>
            <li><span>03</span>表示確認</li>
          </ul>
        </div>
      </div>
    </div>

    <nav class="exam-university-links" aria-label={`${library.name}の関連情報`}>
      <div class="content">
        <a href="/past-exam-library/">
          <span>大学一覧</span>
          <strong>過去問ライブラリー</strong>
        </a>
        <a href={library.strategyPath}>
          <span>傾向と対策</span>
          <strong>{library.strategyLabel}</strong>
        </a>
        <a href={library.informationPath}>
          <span>大学情報</span>
          <strong>{library.informationLabel}</strong>
        </a>
      </div>
    </nav>
  </main>
</SiteLayout>
