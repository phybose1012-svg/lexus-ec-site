---
import SiteLayout from "../../../../../layouts/SiteLayout.astro";
import PastExamBreadcrumbs from "../../../../../components/past-exam/PastExamBreadcrumbs.astro";
import PastExamSeoHead from "../../../../../components/past-exam/PastExamSeoHead.astro";
import { buildExamDocumentSeo, PAST_EXAM_SOCIAL_IMAGE, PAST_EXAM_SOCIAL_IMAGE_ALT } from "../../../../../lib/pastExamSeo.mjs";
import AnalysisSection from "../../../../../components/past-exam/AnalysisSection.astro";
import PastExamExamInfo from "../../../../../components/past-exam/PastExamExamInfo.astro";
import PastExamDocumentTabs from "../../../../../components/past-exam/PastExamDocumentTabs.astro";
import PastExamContents from "../../../../../components/past-exam/PastExamContents.astro";
import { analysisPages, type AnalysisPage } from "../../../../../data/pastExamAnalyses";
import { buildDifficultyPie } from "../../../../../lib/pastExamDifficultyPie.mjs";
import "../../../../../styles/past-exam-library.css";
import "../../../../../styles/past-exam-question.css";
import "../../../../../styles/past-exam-analysis.css";

export function getStaticPaths() {
  return analysisPages.map((page) => ({ params: { university: page.route.university, year: page.route.year, subject: page.route.subject }, props: { page } }));
}
const { page } = Astro.props as { page: AnalysisPage };
const { title, description, canonical, breadcrumbs, structuredData } = buildExamDocumentSeo({
  mode: "analysis",
  university: page.university,
  year: page.year,
  subject: page.subject,
  examLabel: page.examLabel,
  majorCount: page.majorQuestions.length,
  path: page.route.path,
  universityPath: page.links.university,
});
const levels = ["基本レベル", "基本＋αレベル", "標準レベル", "発展レベル"];
const priorities = ["先に解く", "後回し", "見送る"];
const total = page.majorQuestions.reduce((n, q) => n + q.subquestions.length, 0);
const totalPoints = page.majorQuestions.flatMap((q) => q.subquestions).reduce((n, q) => n + q.points, 0);
const difficultyPoints = levels.map((_, level) => page.majorQuestions.flatMap((q) => q.subquestions).filter((q) => q.difficulty === level).reduce((n, q) => n + q.points, 0));
const difficultySlices = buildDifficultyPie(difficultyPoints);
---

<SiteLayout title={title} description={description} canonical={canonical}
  ogImage={PAST_EXAM_SOCIAL_IMAGE} ogImageAlt={PAST_EXAM_SOCIAL_IMAGE_ALT}
  noindex={true} mainContentId="past-exam-content">
  <Fragment slot="head"><PastExamSeoHead structuredData={structuredData} /></Fragment>
  <main id="past-exam-content" tabindex="-1" class="past-exam-question-page past-exam-analysis-page">
    <header class="past-exam-question-header">
      <div class="content">
        <PastExamBreadcrumbs items={breadcrumbs} />
        <div class="past-exam-question-header__grid">
          <div>
            <p class="past-exam-question-kicker">PAST EXAM / ANALYSIS</p>
            <h1>{page.university}<span>{page.year}年度 {page.subject}の分析</span></h1>
          </div>
          <a class="past-exam-question-back" href={`${page.links.university}#year-${page.year}`}>← 年度・科目一覧へ</a>
        </div>
        <PastExamExamInfo fields={[
          { label: "年度", value: `${page.year}年度` },
          { label: "入試区分", value: page.examLabel },
          { label: "科目", value: page.subject },
          { label: "形式", value: page.format },
          { label: "試験時間", value: page.duration },
          { label: "大問・小問", value: `${page.majorQuestions.length}題・${total}問` },
        ]} />
      </div>
    </header>
    <div class="past-exam-question-review"><div class="content">
      <span>{page.source.approved ? "レクサスE.C.の編集評価" : "ステージング確認用 · 難易度・優先度はレクサスE.C.の編集評価です。"}</span>
    </div></div>
    <PastExamDocumentTabs current="analysis" questions={page.links.questions} answers={page.links.answers} analysis={page.route.path} />

    <div class="analysis-body">
      <div class="analysis-introduction content">
      <PastExamContents title="分析の目次" items={[
        { label: "試験概要", href: "#difficulty-distribution" },
        { label: "目標点", href: "#target-score" },
        { label: "大問ごとの特徴", href: "#overview-title" },
        { label: "解く順番", href: "#priority-title" },
        { label: "復習", href: "#practice-title" },
      ]} />
      <section class="analysis-takeaway" aria-labelledby="analysis-takeaway-title">
        <div>
          <p class="analysis-eyebrow">この年のポイント</p>
          <h2 id="analysis-takeaway-title">{page.headline}</h2>
          <p>{page.summary}</p>
        </div>
        <div class="analysis-distribution" id="difficulty-distribution">
          <h3>試験概要</h3>
          <dl class="analysis-distribution-totals">
            <div><dt>大問合計</dt><dd><strong>{page.majorQuestions.length}</strong>題</dd></div>
            <div><dt>小問合計</dt><dd><strong>{total}</strong>問</dd></div>
            <div><dt>配点合計</dt><dd><strong>{totalPoints}</strong>点{page.examTotal && <span class="analysis-exam-total"> / {page.examTotal.points}点 ({page.examTotal.subjectCount}科目合計)</span>}</dd></div>
          </dl>
          <div class="analysis-distribution-chart">
            <svg class="analysis-difficulty-pie" viewBox="0 0 220 220" width="220" height="220" role="img" aria-labelledby="difficulty-pie-title" aria-describedby="difficulty-pie-note">
              <title id="difficulty-pie-title">{`仮配点合計${totalPoints}点の難易度別割合。${difficultySlices.map((s) => `${levels[s.level]} ${page.difficultyCounts[s.level]}問、推定${s.value}点`).join("。")}`}</title>
              {difficultySlices.filter((s) => s.value > 0).map((s) => <path class={`analysis-level-fill level-${s.level}`} d={s.path} />)}
              {difficultySlices.filter((s) => s.fraction >= 0.06).map((s) => <text x={s.labelX} y={s.labelY} text-anchor="middle" dominant-baseline="central" aria-hidden="true">{s.value}点</text>)}
            </svg>
            <ul class="analysis-legend">
              {difficultySlices.map((s) => <li><i class={`analysis-level-fill level-${s.level}`} aria-hidden="true"></i><span class="analysis-legend-copy"><span>{levels[s.level]}</span><span class="analysis-legend-values"><b>{page.difficultyCounts[s.level]}問</b><small>（推定：{s.value}点）</small></span></span></li>)}
            </ul>
          </div>
          <small id="difficulty-pie-note">難易度別の仮配点割合です。大学公表の小問別配点ではありません。</small>
        </div>
      </section>
      </div>

      <AnalysisSection id="target-score" headingId="target-title" number="01" title="目標点" tone="muted" character="lexus">
        <p class="analysis-section-intro">{page.subject}に{page.targets.timeBudgetMinutes}分を使うと仮定した、レクサスの目標点です。小問別の仮配点に基づく試算で、大学公表の配点・合格最低点ではありません。</p>
        {page.targetReviewNote && <p class="analysis-small-note">{page.targetReviewNote} 苦手層の全問一巡の判断時間：{page.targets.profiles.find((profile) => profile.id === "weak")?.scanMinutes}分。</p>}
        <div class="analysis-target-grid">
          {page.targets.profiles.map((profile) => (
            <article class={`analysis-target-card is-${profile.id}`}>
              <h3>{profile.title}</h3>
              <p class="analysis-target-score"><strong>{profile.targetPoints}</strong><span>点<small>／{page.targets.totalPoints}点満点・仮配点</small></span></p>
              <p class="analysis-target-summary">{profile.summary}</p>
              <dl class="analysis-target-steps">
                <div><dt>先に解く{profile.now.questionIds.length}小問</dt><dd><strong>{profile.now.points}点</strong><span>想定{profile.now.minutes}分</span></dd></div>
                {profile.routeKind === "replacement"
                  ? <div class="analysis-target-addition"><dt>小問の組合せを変更<small>{profile.replaced?.map((q) => q.label).join("・")}を外し、{profile.additional.map((q) => q.label).join("・")}へ</small></dt><dd><strong>計{profile.route.points}点</strong><span>計{profile.route.minutes}分</span></dd></div>
                  : profile.additional.length > 0
                  ? <div class="analysis-target-addition"><dt>{profile.additional.map((q) => q.label).join("・")}を追加<small>＋{profile.route.points - profile.now.points}点</small></dt><dd><strong>計{profile.route.points}点</strong><span>計{profile.route.minutes}分</span></dd></div>
                  : <div class="analysis-target-reached"><dt>この小問構成で目標点をカバー</dt></div>}
              </dl>
              <p class="analysis-target-focus">{profile.focus}</p>
            </article>
          ))}
        </div>
        <p class="analysis-small-note">時間は全{total}小問の解く・後回しにする判断を一度行う時間を含みます。実際の所要時間や得点を保証するものではありません。</p>
      </AnalysisSection>

      <AnalysisSection headingId="overview-title" number="02" title="大問ごとの特徴">
        <div class="analysis-major-grid">
          {page.majorQuestions.map((major, i) => (
            <article class="analysis-major-card">
              <div class="analysis-major-card__head"><span>{String(i + 1).padStart(2, "0")}</span><div><small>{major.label}</small><h3>{major.title}</h3></div></div>
              <p class="analysis-major-subtitle">{major.subtitle}</p>
              <p>{major.summary}</p>
              <a href={`#${major.id}`}>小問別の優先度を見る <span aria-hidden="true">↓</span></a>
            </article>
          ))}
        </div>
      </AnalysisSection>

      <AnalysisSection headingId="priority-title" number="03" title="解く順番の目安" tone="muted" character="oni">
        <div class="analysis-profile-grid">
          {page.profiles.map((profile) => <aside class={`analysis-profile is-${profile.id}`}><h3>{profile.title}</h3><p>{profile.text}</p></aside>)}
        </div>
        <div class="analysis-priority-tables">
          {page.majorQuestions.map((major) => (
            <section class="analysis-major-detail" id={major.id} aria-labelledby={`${major.id}-title`}>
              <div class="analysis-detail-heading">
                <h3 id={`${major.id}-title`}>{major.label}<span>{major.title}</span></h3>
                <div><a href={major.questionsPath}>問題</a><a href={major.answersPath}>解答・解説</a></div>
              </div>
              <table class="analysis-priority-table">
                <caption class="analysis-sr-only">{major.label}の小問別難易度と優先度</caption>
                <thead><tr><th scope="col">小問・着眼点</th><th scope="col">難易度</th><th scope="col">苦手なら</th><th scope="col">得意なら</th></tr></thead>
                <tbody>{major.subquestions.map((s) => (
                  <tr>
                    <th scope="row"><span class="analysis-subquestion-name"><small>{s.label}</small>{s.title}</span><p>{s.note}</p></th>
                    <td><span class={`analysis-difficulty level-${s.difficulty}`}><span>{levels[s.difficulty].replace("レベル", "")}</span><span>レベル</span></span></td>
                    <td><span class={`analysis-priority priority-${s.weak}`}>{priorities[s.weak]}</span></td>
                    <td><span class={`analysis-priority priority-${s.strong}`}>{priorities[s.strong]}</span></td>
                  </tr>
                ))}</tbody>
              </table>
            </section>
          ))}
        </div>
        <p class="analysis-small-note">「先に解く」は優先して着手する小問。「見送る」は今回の演習で時間をかけすぎない判断で、学習しなくてよいという意味ではありません。</p>
      </AnalysisSection>

      <AnalysisSection headingId="practice-title" number="04" title={`復習はこの${page.majorQuestions.length}点`}>
        <ol class="analysis-practice-list">{page.majorQuestions.map((m) => <li><strong>{m.title}</strong><p>{m.studyAction}</p></li>)}</ol>
      </AnalysisSection>
    </div>
    <nav class="past-exam-question-links" aria-label="問題・解答へ戻る"><div class="content">
      <a href={page.links.questions}><span>{page.year}年度 {page.subject}</span><strong>問題を解く</strong></a>
      <a href={page.links.answers}><span>解き方を確認</span><strong>解答・解説を見る</strong></a>
    </div></nav>
  </main>
</SiteLayout>
