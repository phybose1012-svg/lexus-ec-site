---
import SiteLayout from "../../../../../layouts/SiteLayout.astro";
import PastExamPrintBranding from "../../../../../components/past-exam/PastExamPrintBranding.astro";
import PastExamPrintButton from "../../../../../components/past-exam/PastExamPrintButton.astro";
import PastExamPrintSummary from "../../../../../components/past-exam/PastExamPrintSummary.astro";
import "../../../../../styles/past-exam-library.css";
import "../../../../../styles/past-exam-question.css";
import "../../../../../styles/past-exam-answer.css";

type AnswerPageData = {
  schemaVersion: string;
  packageId: string;
  route: { university: string; year: string; subject: string; path: string };
  university: { id: string; name: string };
  exam: { year: string; label: string; stage: string; duration: string };
  subject: { id: string; name: string; english: string };
  document: {
    role: "answers";
    pageUnit: string;
    majorQuestions: Array<{ id: string; label: string; order: number; html: string }>;
  };
  source: {
    contentProvenance: string;
    restrictedSourceCopied: boolean;
    publicationCandidate: boolean;
    rightsStatus: string;
    needsHumanReview: boolean;
    reference: string;
  };
  links: {
    questions: string;
    universityLibrary: string;
    analysis: string | null;
    universityInformation: string | null;
  };
};

export function getStaticPaths() {
  const answerPageModules = import.meta.glob(
    "../../../../../data/generated/pastExamAnswers/*.json",
    { eager: true, import: "default" },
  );
  const answerPages = Object.values(answerPageModules) as AnswerPageData[];
  return answerPages.map((page) => ({
    params: {
      university: page.route.university,
      year: page.route.year,
      subject: page.route.subject,
    },
    props: { page },
  }));
}

const { page } = Astro.props as { page: AnswerPageData };
const title = `${page.university.name} ${page.exam.year}年度 ${page.subject.name}の解答・解説｜過去問ライブラリー｜レクサス教育センター`;
const description = `${page.university.name}医学部 ${page.exam.year}年度${page.exam.label}・${page.subject.name}の解答と詳しい解説です。全${page.document.majorQuestions.length}題を大問別に確認できます。`;
const canonical = `https://lexus-ec.com${page.route.path}`;
const reviewRequired = page.source.needsHumanReview;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LearningResource",
      "@id": `${canonical}#learning-resource`,
      url: canonical,
      name: title,
      description,
      inLanguage: "ja",
      learningResourceType: "解答・解説",
      about: `${page.university.name}医学部 ${page.exam.year}年度 ${page.subject.name}`,
      provider: {
        "@type": "EducationalOrganization",
        "@id": "https://lexus-ec.com/#organization",
        name: "レクサス教育センター",
        url: "https://lexus-ec.com/",
      },
      breadcrumb: { "@id": `${canonical}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ホーム", item: "https://lexus-ec.com/" },
        {
          "@type": "ListItem",
          position: 2,
          name: "過去問ライブラリー",
          item: "https://lexus-ec.com/past-exam-library/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: page.university.name,
          item: `https://lexus-ec.com${page.links.universityLibrary}`,
        },
        {
          "@type": "ListItem",
          position: 4,
          name: `${page.exam.year}年度 ${page.subject.name} 解答・解説`,
          item: canonical,
        },
      ],
    },
  ],
};
---

<SiteLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="/assets/legacy/wp-content/uploads/2024/09/新レクサス1-e1726564535383.png"
>
  <Fragment slot="head">
    <meta name="author" content="医学部予備校 レクサス E.C." />
    <meta name="robots" content="noindex,follow" />
    <meta property="og:image:alt" content="医学部予備校レクサス E.C.のキャラクター" />
    <link rel="stylesheet" href="/assets/vendor/katex/katex.min.css" />
    <script is:inline defer src="/assets/vendor/katex/katex.min.js"></script>
    <script is:inline defer src="/assets/past-exam/math-render.js"></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <main class="past-exam-question-page past-exam-answer-page">
    <PastExamPrintBranding />

    <header class="past-exam-question-header">
      <div class="content">
        <nav class="exam-library-breadcrumb" aria-label="パンくずリスト">
          <a href="/">ホーム</a>
          <span aria-hidden="true">/</span>
          <a href="/past-exam-library/">過去問ライブラリー</a>
          <span aria-hidden="true">/</span>
          <a href={page.links.universityLibrary}>{page.university.name}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{page.exam.year}年度 {page.subject.name} 解答・解説</span>
        </nav>

        <div class="past-exam-question-header__grid">
          <div>
            <p class="past-exam-question-kicker">PAST EXAM / ANSWER &amp; EXPLANATION</p>
            <h1>{page.university.name}<span>{page.exam.year}年度 {page.subject.name}の解答・解説</span></h1>
          </div>
          <div class="past-exam-question-header__actions">
            <PastExamPrintButton
              label="解答・解説を印刷"
              printTitle={`${page.university.name} ${page.exam.year}年度 ${page.subject.name} 解答・解説`}
            />
            <a class="past-exam-question-back" href={`${page.links.universityLibrary}#year-${page.exam.year}`}>
              <span aria-hidden="true">←</span> 年度・科目一覧へ
            </a>
          </div>
        </div>

        <dl class="past-exam-question-meta" aria-label="試験情報">
          <div><dt>年度</dt><dd>{page.exam.year}年度</dd></div>
          <div><dt>入試区分</dt><dd>{page.exam.label}</dd></div>
          <div><dt>試験段階</dt><dd>{page.exam.stage}</dd></div>
          <div><dt>科目</dt><dd>{page.subject.name}</dd></div>
          <div><dt>内容</dt><dd>解答・解説</dd></div>
          <div><dt>大問</dt><dd>{page.document.majorQuestions.length}題</dd></div>
        </dl>
      </div>
    </header>

    <PastExamPrintSummary
      metadata={[
        `${page.exam.year}年度`,
        page.exam.label,
        page.exam.stage,
        page.subject.name,
        "解答・解説",
        `大問${page.document.majorQuestions.length}題`,
      ]}
      notes={["掲載問題をもとに、レクサスE.C.が独自に作成した解答・解説です。"]}
    />

    <div class:list={["past-exam-question-review", { "is-required": reviewRequired }]}>
      <div class="content">
        <strong>{reviewRequired ? "ステージング確認用" : "掲載内容確認済み"}</strong>
        <span>{reviewRequired ? "解答・数式・表示の最終確認中です。" : "確認済みの解答・解説です。"}</span>
      </div>
    </div>

    <nav class="past-exam-question-mode" aria-label="問題・解答・分析">
      <div class="content">
        <a href={page.links.questions}><small>01</small><strong>問題</strong><em>閲覧する</em></a>
        <span class="is-current" aria-current="page"><small>02</small><strong>解答</strong><em>表示中</em></span>
        {
          page.links.analysis ? (
            <a href={page.links.analysis}><small>03</small><strong>分析</strong><em>閲覧する</em></a>
          ) : (
            <span><small>03</small><strong>分析</strong><em>準備中</em></span>
          )
        }
      </div>
    </nav>

    <div class="past-exam-question-reader content">
      <nav class="past-exam-question-index past-exam-answer-index" aria-label="解答・解説内の目次">
        {
          page.document.majorQuestions.map((major) => (
            <a href={`#${major.id}`}><strong>{major.label}</strong><small>解答・解説を見る</small></a>
          ))
        }
      </nav>

      <section class="past-exam-question-list past-exam-answer-list" aria-label={`${page.exam.year}年度 ${page.subject.name}の解答・解説`}>
        {page.document.majorQuestions.map((major) => <Fragment set:html={major.html} />)}
      </section>

      <aside class="past-exam-question-note">
        <strong>解答・解説について</strong>
        <p>掲載している問題をもとにレクサスE.C.が独自作成しています。元解答の文章・表・図版は転載していません。</p>
      </aside>
    </div>

    <nav class="past-exam-question-links" aria-label={`${page.university.name}の関連情報`}>
      <div class="content">
        <a href={page.links.questions}><span>過去問</span><strong>{page.subject.name}の問題</strong></a>
        {page.links.analysis && <a href={page.links.analysis}><span>傾向と対策</span><strong>{page.subject.name}の分析</strong></a>}
        {page.links.universityInformation && <a href={page.links.universityInformation}><span>大学情報</span><strong>入試情報を見る</strong></a>}
      </div>
    </nav>
  </main>
</SiteLayout>
