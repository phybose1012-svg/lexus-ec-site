---
import { parseFragment, type DefaultTreeAdapterMap } from "parse5";
import LegacyArticlePage from "../../../components/fixed/LegacyArticlePage.astro";

const admissionsLinks = [
  { label: "一般・共通テスト利用の日程", href: "/private-medical-school-admissions-schedule-2027/", image: "/assets/optimized/shiritsu-guide-general.webp?v=180a9e91" },
  { label: "総合型・学校推薦などの日程", href: "/private-medical-school-special-admissions-schedule-2027/", image: "/assets/optimized/shiritsu-guide-special.webp?v=d2663320" },
  { label: "試験会場・周辺ホテル", href: "/private-medical-school-exam-venues-hotels-2027/", image: "/assets/optimized/shiritsu-guide-venue.webp?v=7e3c8bdf" },
];

const universitySections = [
  { title: "大学別の入試情報・現役医大生の声", id: "university-guide", image: "/assets/optimized/shiritsu-guide-university.webp", legacyHeading: "現役医大生のホンネ" },
  { title: "面接・志望理由のヒント", id: "interview-guide", image: "/assets/optimized/shiritsu-guide-interview.webp", legacyHeading: "私立医学部情報面接対策｜本学志望理由のヒント" },
  { title: "入試問題の傾向と対策", id: "exam-strategy", image: "/assets/optimized/shiritsu-guide-strategy.webp", legacyHeading: "入試問題の傾向と対策" },
];

const navigation = [
  { label: "2027年度の入試情報", links: admissionsLinks },
  { label: "大学別の情報・対策", links: universitySections.map(({ title, id, image }) => ({ label: title, href: "#" + id, image })) },
];

function findSectionHeading(node: DefaultTreeAdapterMap["childNode"]): DefaultTreeAdapterMap["element"] | undefined {
  if ("tagName" in node && node.tagName === "h2") return node;
  if ("childNodes" in node) {
    for (const child of node.childNodes) {
      const heading = findSectionHeading(child);
      if (heading) return heading;
    }
  }
}

function orderDirectorySections(body: string) {
  const fragment = parseFragment(body, { sourceCodeLocationInfo: true });
  const content = fragment.childNodes.find((node): node is DefaultTreeAdapterMap["element"] =>
    "attrs" in node && node.attrs.some(({ name, value }) => name === "class" && value.split(/\s+/).includes("page-content"))
  );
  const directory = (content ?? fragment).childNodes.find((node): node is DefaultTreeAdapterMap["element"] =>
    "attrs" in node && node.attrs.some(({ name, value }) => name === "class" && value.split(/\s+/).includes("elementor"))
  );
  const endTag = directory?.sourceCodeLocation?.endTag;
  if (!directory || !endTag) return body;

  // A heading and the following heading-free siblings belong to one section.
  const sections = directory.childNodes.flatMap((node) => {
    const heading = findSectionHeading(node);
    const start = node.sourceCodeLocation?.startOffset;
    if (!heading || start === undefined) return [];
    return [{ id: heading.attrs.find(({ name }) => name === "id")?.value, start }];
  });
  const indices = universitySections.map(({ id }) => sections.findIndex((section) => section.id === id));
  const first = Math.min(...indices);
  if (first < 0 || Math.max(...indices) !== first + indices.length - 1) return body;

  const start = sections[first].start;
  const end = sections[first + indices.length]?.start ?? endTag.startOffset;
  const ordered = indices.map((index) => body.slice(sections[index].start, sections[index + 1]?.start ?? end));
  return body.slice(0, start) + ordered.join("") + body.slice(end);
}

const updateDirectory = (body: string) => orderDirectorySections(body
  .replace(/(<h2\b[^>]*?)>([\s\S]*?)<\/h2>/gi, (heading, opening: string, text: string) => {
    const label = text.replace(/<[^>]+>|\s+/g, "");
    const section = universitySections.find(({ legacyHeading }) => label === legacyHeading);
    return section ? opening + ' id="' + section.id + '" tabindex="-1">' + section.title + "</h2>" : heading;
  })
  .replace(
    "医学部予備校 レクサス教育センターが集めた、現役医大生（レクサスのOB、OG）のホンネを大学別にまとめてみました。",
    "大学を選ぶと、2026年度の入試結果や学費、カリキュラムや大学生活を確認できます。",
  ));
---

<LegacyArticlePage
  path="/top/information-shiritsu/"
  heading="私立医学部情報"
  description="2027年度の私立医学部の入試日程・試験会場と、大学別の入試情報・現役医大生の声、面接対策や入試問題の傾向を確認できます。"
  transformContent={updateDirectory}
  directory
>
  <nav slot="before-content" class="shiritsu-guide" aria-label="私立医学部情報の案内">
    {navigation.map(({ label, links }) => (
      <section class="shiritsu-guide__group">
        <h2>{label}</h2>
        <ul>
          {links.map(({ label, href, image }) => (
            <li>
              <a href={href}>
                <span class="shiritsu-guide__thumbnail" aria-hidden="true">
                  <img src={image} alt="" width="96" height="50" decoding="async" />
                </span>
                <span>{label}</span>
                <span class="shiritsu-guide__arrow" aria-hidden="true">{href.startsWith("#") ? "↓" : "→"}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
</LegacyArticlePage>

<style>
  .shiritsu-guide {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    width: min(1000px, calc(100% - 32px));
    margin: 0 auto 22px;
  }

  .shiritsu-guide__group {
    align-self: start;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #dcd2c2;
    border-radius: 12px;
    background: #fff;
  }

  .shiritsu-guide__group h2 {
    margin: 0;
    padding: 9px 14px;
    color: #613125;
    background: #f7f0e5;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.4;
  }

  .shiritsu-guide__group:nth-child(2) h2 {
    color: #204b3a;
    background: #edf3ed;
  }

  .shiritsu-guide__group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shiritsu-guide__group li + li {
    border-top: 1px solid #eee8df;
  }

  .shiritsu-guide__group a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 62px;
    padding: 6px 14px;
    color: #302922;
    font-size: clamp(0.84rem, 2.9vw, 1rem);
    font-weight: 750;
    line-height: 1.45;
    text-decoration: none;
  }

  .shiritsu-guide__group a:hover,
  .shiritsu-guide__group a:focus-visible {
    background: #f7f4ee;
    color: #752b20;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .shiritsu-guide__group a:focus-visible {
    outline: 2px solid #752b20;
    outline-offset: -2px;
  }

  .shiritsu-guide__thumbnail {
    position: relative;
    width: 96px;
    aspect-ratio: 96 / 50;
    overflow: hidden;
    border-radius: 6px;
    background: #f7f0e5;
  }

  .shiritsu-guide__group:nth-child(2) .shiritsu-guide__thumbnail {
    background: #edf3ed;
  }

  .shiritsu-guide__thumbnail img {
    display: block;
    position: absolute;
    inset: 0;
    margin: auto;
    width: 78%;
    height: 86%;
    object-fit: contain;
  }

  .shiritsu-guide__arrow {
    color: #5e4939;
    font-size: 1.05rem;
  }

  :global(.legacy-article-page:has(.shiritsu-guide) .legacy-article-hero) {
    padding-block: 14px 4px;
  }

  :global(.legacy-article-page:has(.shiritsu-guide) .legacy-article-hero :is(.page-head__strip, .page-head__label, .page-head__rule)) {
    display: none;
  }

  :global(.legacy-article-page:has(.shiritsu-guide) .page-head__title) {
    margin: 0;
    font-size: clamp(1.45rem, 4vw, 2.1rem);
  }

  :global(.legacy-article-section:has(.shiritsu-guide)) {
    padding-block-start: 12px;
  }

  :global(.legacy-article-section:has(.shiritsu-guide) .lap-sechead) {
    display: none;
  }

  :global(.legacy-article-section:has(.shiritsu-guide) .lap-sec) {
    padding-block: 14px 20px;
  }

  :global(.legacy-article-section:has(.shiritsu-guide) .lap-sec h2[id]) {
    scroll-margin-top: 16px;
  }

  @media (max-width: 680px) {
    .shiritsu-guide {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      margin-bottom: 14px;
    }

    .shiritsu-guide__group h2 {
      padding-block: 7px;
    }

    .shiritsu-guide__group a {
      min-height: 54px;
      gap: 9px;
      padding-inline: 10px;
    }

    .shiritsu-guide__thumbnail {
      width: 76px;
    }
  }
</style>
