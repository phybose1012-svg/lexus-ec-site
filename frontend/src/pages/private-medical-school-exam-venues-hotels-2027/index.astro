  <script is:inline>
    (() => {
      const form = document.querySelector("[data-venue-filters]");
      if (!(form instanceof HTMLFormElement)) return;

      const recordElement = document.getElementById("venue-filter-records");
      if (!(recordElement instanceof HTMLScriptElement)) return;
      const cards = [...document.querySelectorAll("[data-filter-card]")];
      const prefectureGroups = [...document.querySelectorAll("[data-venue-prefecture-group]")];
      const prefectureLinks = [...document.querySelectorAll("[data-prefecture-link]")];
      const prefectureCounters = [...document.querySelectorAll("[data-prefecture-count]")];
      const result = document.querySelector("[data-filter-result]");
      const normalize = (value) => String(value || "").normalize("NFKC").trim().toLocaleLowerCase("ja");
      let assignmentRecords = [];
      try {
        assignmentRecords = JSON.parse(recordElement.textContent || "[]");
      } catch {
        assignmentRecords = [];
      }

      const applyFilters = () => {
        const data = new FormData(form);
        const query = normalize(data.get("query"));
        const region = normalize(data.get("region")) || "all";
        const prefecture = normalize(data.get("prefecture")) || "all";
        const stage = normalize(data.get("stage")) || "all";
        const category = normalize(data.get("category")) || "all";
        const state = normalize(data.get("state")) || "all";
        let visibleVenues = 0;
        let visibleUniversities = 0;

        const matchesRecord = (record) =>
          (region === "all" || normalize(record.region) === region) &&
          (prefecture === "all" || record.prefectures.map(normalize).includes(prefecture)) &&
          (stage === "all" || normalize(record.stage) === stage) &&
          (category === "all" || normalize(record.category) === category) &&
          (state === "all" || normalize(record.state) === state);

        for (const card of cards) {
          if (!(card instanceof HTMLElement)) continue;
          const records = assignmentRecords.filter((record) =>
            card.dataset.kind === "venue"
              ? record.venueIds.includes(card.id.replace(/^venue-/, ""))
              : record.universityId === card.id.replace(/^university-/, ""),
          );
          const cardMatchesPrefecture =
            card.dataset.kind !== "venue" ||
            prefecture === "all" ||
            normalize(card.dataset.prefectures).split("|").includes(prefecture);
          const venueOwnQueryMatches =
            card.dataset.kind === "venue" && normalize(card.dataset.search).includes(query);
          const cardMatchesQuery =
            !query ||
            (card.dataset.kind === "venue"
              ? venueOwnQueryMatches ||
                records.some((record) => normalize(record.assignmentSearch).includes(query))
              : records.some((record) => normalize(record.search).includes(query)));
          const matchingRecords = cardMatchesPrefecture && cardMatchesQuery
            ? records.filter(
                (record) =>
                  matchesRecord(record) &&
                  (!query ||
                    (card.dataset.kind === "venue"
                      ? venueOwnQueryMatches ||
                        normalize(record.assignmentSearch).includes(query)
                      : normalize(record.search).includes(query))),
              )
            : [];
          const matchingAssignmentIds = new Set(
            matchingRecords.map((record) => record.assignmentId),
          );
          const visible = matchingRecords.length > 0;
          card.hidden = !visible;
          for (const assignmentRow of card.querySelectorAll("[data-filter-assignment-id]")) {
            if (assignmentRow instanceof HTMLElement) {
              assignmentRow.hidden = !matchingAssignmentIds.has(
                assignmentRow.dataset.filterAssignmentId,
              );
            }
          }
          if (visible && card.dataset.kind === "venue") visibleVenues += 1;
          if (visible && card.dataset.kind === "university") visibleUniversities += 1;
        }

        for (const group of prefectureGroups) {
          if (!(group instanceof HTMLElement)) continue;
          const visibleCount = [...group.querySelectorAll('[data-kind="venue"]')].filter(
            (card) => card instanceof HTMLElement && !card.hidden,
          ).length;
          group.hidden = visibleCount === 0;
          const prefectureName = group.dataset.venuePrefectureGroup;

          for (const link of prefectureLinks) {
            if (link instanceof HTMLElement && link.dataset.prefectureLink === prefectureName) {
              link.hidden = visibleCount === 0;
            }
          }
          for (const counter of prefectureCounters) {
            if (counter instanceof HTMLElement && counter.dataset.prefectureCount === prefectureName) {
              counter.textContent = `${visibleCount}会場`;
            }
          }
        }

        for (const section of ["venues", "universities"]) {
          const empty = document.querySelector(`[data-filter-empty="${section}"]`);
          if (empty instanceof HTMLElement) empty.hidden = section === "venues" ? visibleVenues > 0 : visibleUniversities > 0;
        }
        if (result) result.textContent = `会場 ${visibleVenues}件・大学 ${visibleUniversities}校を表示しています。`;
      };

      form.addEventListener("input", applyFilters);
      form.addEventListener("change", applyFilters);
      form.addEventListener("reset", () => requestAnimationFrame(applyFilters));
      applyFilters();
    })();
  </script>
</SiteLayout>
