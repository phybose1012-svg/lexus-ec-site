function hotelJourneyTime(access: HotelVenueAccess2027, publishedTime: string | undefined) {
  // A route may list individual legs. Only show an explicit total or a direct walk here.
  const total = publishedTime?.match(/^(?:ホテルから)?(?:合計)?((?:徒歩)?(?:約)?\d+(?:[〜～]\d+)?分)$/u)?.[1];
  if (total) return access.modes.length === 1 && access.modes[0] === "walk" && !total.startsWith("徒歩") ? `徒歩${total}` : total;

  if (access.reviewState.includes("official_direct")) {
    const directWalk = publishedTime?.match(/^([^／（]+まで)(?:ホテル公式)?(徒歩(?:約)?\d+分)(?=$|[／（])/u);
    if (directWalk) return `${directWalk[1]} ${directWalk[2]}`;
  }
}

