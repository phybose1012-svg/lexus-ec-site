---
import AdmissionsBrandDivider from "../../components/admissions/AdmissionsBrandDivider.astro";
import AdmissionsScheduleSwitcher from "../../components/admissions/AdmissionsScheduleSwitcher.astro";
import {
  privateMedicalExamVenueAssignments2027,
  privateMedicalExamVenueSummary2027,
  privateMedicalExamVenueUniversitySummaries2027,
  privateMedicalExamVenues2027,
  venueAssignmentConditionLabels,
  venuePublicationStateLabels,
  type PrivateMedicalExamVenueAssignment2027,
} from "../../data/privateMedicalExamVenues2027";
import {
  hotelOperatingStatusLabels2027,
  hotelVenueAccessReviewStateLabels2027,
  privateMedicalVenueHotels2027,
} from "../../data/privateMedicalVenueHotels2027";
import {
  privateMedicalExamVenuesHotels2027FieldDefinitions,
  privateMedicalExamVenuesHotels2027Metadata,
} from "../../data/privateMedicalExamVenuesHotels2027Metadata";
import { privateMedicalExamVenuesHotels2027SourceUrls } from "../../data/privateMedicalExamVenuesHotels2027Dataset";
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/admissions-2027.css";
import "../../styles/venues-hotels-2027.css";

const metadata = privateMedicalExamVenuesHotels2027Metadata;
const title = metadata.title;
const description = metadata.description;
const canonical = metadata.canonicalUrl;
const datasetUrl = metadata.datasetUrl;
const datasetPath = new URL(datasetUrl).pathname;
const publicHotels = privateMedicalVenueHotels2027.filter(
  (hotel) => hotel.operatingStatus === "official_site_active" && hotel.reviewState === "verified",
);
const venueById = new Map(privateMedicalExamVenues2027.map((venue) => [venue.venueId, venue]));
const hotelsByVenueId = new Map<string, typeof publicHotels>();
const prefectureDisplayOrder = [
  "北海道", "青森県", "岩手県", "宮城県", "秋田県", "山形県", "福島県",
  "茨城県", "栃木県", "群馬県", "埼玉県", "千葉県", "東京都", "神奈川県",
  "新潟県", "富山県", "石川県", "福井県", "山梨県", "長野県", "岐阜県", "静岡県", "愛知県",
  "三重県", "滋賀県", "京都府", "大阪府", "兵庫県", "奈良県", "和歌山県",
  "鳥取県", "島根県", "岡山県", "広島県", "山口県",
  "徳島県", "香川県", "愛媛県", "高知県",
  "福岡県", "佐賀県", "長崎県", "熊本県", "大分県", "宮崎県", "鹿児島県", "沖縄県",
] as const;
const prefectureOrderIndex = new Map<string, number>(
  prefectureDisplayOrder.map((prefecture, index) => [prefecture, index]),
);
const comparePrefectures = (left: string, right: string) =>
  (prefectureOrderIndex.get(left) ?? Number.MAX_SAFE_INTEGER) -
    (prefectureOrderIndex.get(right) ?? Number.MAX_SAFE_INTEGER) ||
  left.localeCompare(right, "ja");

for (const hotel of publicHotels) {
  for (const access of hotel.venueAccess) {
    hotelsByVenueId.set(access.venueId, [...(hotelsByVenueId.get(access.venueId) ?? []), hotel]);
  }
}

const venueCards = privateMedicalExamVenues2027
  .map((venue) => ({
    venue,
    assignments: privateMedicalExamVenueAssignments2027.filter((assignment) =>
      assignment.venueLinks.some((link) => link.venueId === venue.venueId),
    ),
    hotels: hotelsByVenueId.get(venue.venueId) ?? [],
  }))
  .filter((entry) => entry.assignments.length > 0)
  .sort(
    (left, right) =>
      comparePrefectures(left.venue.prefecture, right.venue.prefecture) ||
      left.venue.name.localeCompare(right.venue.name, "ja"),
  );

const uniqueHotelIds = new Set(publicHotels.map((hotel) => hotel.hotelId));
const hotelLinkedVenueIds = new Set(
  publicHotels.flatMap((hotel) => hotel.venueAccess.map((access) => access.venueId)),
);
const venueGroupPrefectures = [...new Set(venueCards.map((entry) => entry.venue.prefecture))].sort(comparePrefectures);
const venueFilterPrefectures = [
  ...new Set([
    ...venueGroupPrefectures,
    ...privateMedicalExamVenueAssignments2027.flatMap(
      (assignment) => assignment.announcedPrefectures,
    ),
  ]),
].sort(comparePrefectures);
const venueGroups = venueGroupPrefectures.map((prefecture, index) => ({
  prefecture,
  id: `venue-prefecture-${index + 1}`,
  entries: venueCards.filter((entry) => entry.venue.prefecture === prefecture),
}));
const venueOrderById = new Map(
  venueCards.map((entry, index) => [entry.venue.venueId, index + 1]),
);
const universityRegions = ["北海道・東北", "関東", "中部", "近畿", "中国・四国", "九州"];

const assignmentsForUniversity = (universityId: string) =>
  privateMedicalExamVenueAssignments2027.filter((assignment) => assignment.universityId === universityId);
const assignmentVenueNames = (assignment: PrivateMedicalExamVenueAssignment2027) =>
  [...new Set(
    assignment.venueLinks
      .map((link) => venueById.get(link.venueId)?.shortName)
      .filter((name): name is string => Boolean(name)),
  )];
const assignmentLinkedVenues = (assignment: PrivateMedicalExamVenueAssignment2027) =>
  [...new Map(
    assignment.venueLinks
      .map((link) => {
        const venue = venueById.get(link.venueId);
        return venue ? [venue.venueId, venue] as const : undefined;
      })
      .filter((entry): entry is readonly [string, (typeof privateMedicalExamVenues2027)[number]] => Boolean(entry)),
  ).values()];
const conditionText = (assignment: PrivateMedicalExamVenueAssignment2027) =>
  assignment.conditions.map((condition) => venueAssignmentConditionLabels[condition]).join("・");
const examPartLabels = { written: "学力試験", interview: "面接試験" } as const;
const formatRelationDate = (date: string) => {
  const match = date.match(/^\d{4}-(\d{2})-(\d{2})$/u);
  return match ? `${Number(match[1])}/${Number(match[2])}` : date;
};

const updateHistory = [
  {
    date: "2026年8月18日",
    dateTime: "2026-08-18",
