  <script is:inline>
    (() => {
      const form = document.querySelector("[data-admissions-filter]");
      const cards = [...document.querySelectorAll("[data-university-card]")];
      const count = document.querySelector("[data-filter-count]");
      const empty = document.querySelector("[data-filter-empty]");

      if (form instanceof HTMLFormElement) {
        const query = form.querySelector("[data-filter-query]");
        const region = form.querySelector("[data-filter-region]");
        const category = form.querySelector("[data-filter-category]");
        const status = form.querySelector("[data-filter-status]");

        const applyFilters = () => {
          const searchValue = query instanceof HTMLInputElement ? query.value.trim().toLowerCase() : "";
          const regionValue = region instanceof HTMLSelectElement ? region.value : "all";
          const categoryValue = category instanceof HTMLSelectElement ? category.value : "all";
          const statusValue = status instanceof HTMLSelectElement ? status.value : "all";
          let visible = 0;

          cards.forEach((card) => {
            if (!(card instanceof HTMLElement)) return;
            const matchesQuery = !searchValue || (card.dataset.name || "").toLowerCase().includes(searchValue);
            const matchesRegion = regionValue === "all" || card.dataset.region === regionValue;
            const matchesCategory =
              categoryValue === "all" || (card.dataset.categories || "").split(" ").includes(categoryValue);
            const matchesStatus =
              statusValue === "all" || (card.dataset.statuses || "").split(" ").includes(statusValue);
            const matches = matchesQuery && matchesRegion && matchesCategory && matchesStatus;
            card.hidden = !matches;
            if (matches) visible += 1;
          });

          if (count) count.textContent = String(visible);
          if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
        };

        form.addEventListener("input", applyFilters);
        form.addEventListener("change", applyFilters);
        form.addEventListener("reset", () => window.setTimeout(applyFilters, 0));
      }

      const clearPrintTarget = () => {
        document.body.classList.remove("is-printing-admissions-section");
        document.querySelector(".is-print-target")?.classList.remove("is-print-target");
      };

      document.querySelectorAll("[data-print-section]").forEach((button) => {
        button.addEventListener("click", () => {
          if (!(button instanceof HTMLButtonElement)) return;
          const targetId = button.dataset.printSection;
          const target = targetId ? document.getElementById(targetId) : null;

          if (!(target instanceof HTMLElement)) return;

          clearPrintTarget();
          target.classList.add("is-print-target");
          document.body.classList.add("is-printing-admissions-section");
          window.print();
        });
      });

      window.addEventListener("afterprint", clearPrintTarget);
    })();
  </script>
