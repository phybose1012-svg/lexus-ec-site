---
import {
  applicationDeadlineEntries2027,
  commonTestDates2027,
  examCalendar2027,
  fullScheduleCalendar2027,
  fullSchedulePendingItems2027,
  privateMedicalUniversities2027,
  type ApplicationDeadlineEntry2027,
  type AdmissionRouteStatus,
  type FullScheduleColumnKey2027,
} from "../../data/privateMedicalAdmissions2027";
import AdmissionsBrandDivider from "../../components/admissions/AdmissionsBrandDivider.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/admissions-2027.css";

const title = "【2027年度】私立医学部入試日程一覧｜一般選抜・共通テスト利用31大学";
const description =
  "2027年度（令和9年度）の私立医学部31大学の一般選抜・共通テスト利用選抜を、試験日カレンダー、大学別、出願締切別に一覧化。一次・二次試験、出願期間、入学手続まで確認できます。";
const canonical = "https://lexus-ec.com/private-medical-school-admissions-schedule-2027/";
const lastUpdated = "2026年7月31日";
const updateHistory = [
  {
    date: "2026年7月31日",
    dateTime: "2026-07-31",
    title: "出願締め切り一覧が詳しくなりました",
    details: [
      "Web登録の締め切りと、出願書類の郵送期限を分けて掲載しました。",
      "必着・消印有効・Web出願なし・終了時刻未公表を、大学・選抜方式ごとに確認できます。",
      "東北医科薬科大学は、2027年度入学者選抜ガイドの一般選抜・共通テスト利用選抜の日程に更新しました。",
      "自治医科大学は、一次面接の受験条件と、2回の入学手続の両日とも本人の手続が必要であることを追記しました。",
      "獨協医科大学は、前期・後期の合格発表と入学手続日、地域枠の日程を追加しました。",
    ],
  },
  {
    date: "2026年7月30日",
    dateTime: "2026-07-30",
    title: "試験日カレンダーが見やすくなりました",
    details: [
      "一次試験と二次試験を同じ日付の行で確認できるようにしました。",
      "試験のない日も「—」で表示し、連日か空き日があるかを見分けやすくしました。",
      "複数日程の番号と、二次試験日の指定・希望・選択の違いを追加しました。",
    ],
  },
  {
    date: "2026年7月30日",
    dateTime: "2026-07-30",
    title: "大学別の日程情報を追加しました",
    details: [
      "岩手医科大学の公表済み日程を反映しました。",
      "日本医科大学のグローバル特別選抜（共通テスト利用）を追加しました。",
    ],
  },
];
const totalUniversities = privateMedicalUniversities2027.length;
const commonTestUniversities = privateMedicalUniversities2027.filter((university) =>
  university.routes.some((route) => route.category === "common"),
);
const officialUniversities = privateMedicalUniversities2027.filter((university) =>
  university.routes.some((route) => route.status === "official"),
);
const generalRouteCount = privateMedicalUniversities2027.reduce(
  (count, university) => count + university.routes.filter((route) => route.category === "general").length,
  0,
);
const commonRouteCount = privateMedicalUniversities2027.reduce(
  (count, university) => count + university.routes.filter((route) => route.category === "common").length,
  0,
);
const applicationDeadlineGroups2027 = applicationDeadlineEntries2027.reduce<
  Array<{
    date: string;
    dateTime?: string;
    entries: ApplicationDeadlineEntry2027[];
  }>
>((groups, entry) => {
  const latestGroup = groups.at(-1);

  if (latestGroup?.date === entry.date) {
    latestGroup.entries.push(entry);
    return groups;
  }

  groups.push({
    date: entry.date,
    dateTime: entry.dateTime,
    entries: [entry],
  });
  return groups;
}, []);

const statusLabels: Record<AdmissionRouteStatus, string> = {
  official: "詳細日程あり",
  preliminary: "概要日程あり",
  pending: "日程未公表",
};

const fullScheduleColumns: Array<{
  key: FullScheduleColumnKey2027;
  label: string;
  shortLabel: string;
}> = [
  { key: "applicationStart", label: "出願開始日", shortLabel: "出願開始" },
  { key: "applicationDeadline", label: "出願締切", shortLabel: "出願締切" },
  { key: "firstExam", label: "一次試験", shortLabel: "一次試験" },
  { key: "firstResult", label: "一次合格発表", shortLabel: "一次発表" },
  { key: "secondExam", label: "二次試験", shortLabel: "二次試験" },
  { key: "finalResult", label: "合格発表", shortLabel: "合格発表" },
  { key: "procedureDeadline", label: "入学手続き締切", shortLabel: "手続締切" },
];

const fullSchedulePendingFieldLabels: Record<FullScheduleColumnKey2027, string> = {
  applicationStart: "出願開始日",
  applicationDeadline: "出願締切",
  firstExam: "一次試験",
  firstResult: "一次合格発表",
  secondExam: "二次試験",
  finalResult: "合格発表",
  procedureDeadline: "入学手続き締切",
};

const shortUniversityName = (name: string) =>
  name === "日本大学" ? "日大" : name.replace(/大学$/, "");

const faqs = [
  {
    question: "2027年度の大学入学共通テストはいつですか？",
    answer:
      "本試験は2027年1月16日（土）・17日（日）、追試験は1月23日（土）・24日（日）です。出願期間は2026年9月15日（火）から10月2日（金）までです。",
  },
  {
    question: "私立医学部の一般選抜はいつから始まりますか？",
    answer:
      "現時点の公表・予告情報では、1月21日から23日の帝京大学が早期日程にあたり、1月25日に国際医療福祉大学と自治医科大学、1月31日に近畿大学前期が続きます。2月1日から主要日程が集中します。",
  },
  {
    question: "一般選抜と共通テスト利用選抜は併願できますか？",
    answer:
      "併願できる大学が多くあります。同じ大学で二次試験や面接を共通化する場合もありますが、出願期間や必要科目が方式ごとに異なるため、必ず各大学の2027年度学生募集要項で確認してください。",
  },
  {
    question: "このページだけで出願手続きをしても大丈夫ですか？",
    answer:
      "いいえ。このページは受験計画を立てるための一覧です。締切の扱い（必着・消印有効・Web登録）や試験会場は変更される可能性があるため、出願前には必ず各大学公式サイトの学生募集要項を確認してください。",
  },
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: "https://lexus-ec.com/" },
    { "@type": "ListItem", position: 2, name: "私立医学部情報", item: "https://lexus-ec.com/top/information-shiritsu/" },
    { "@type": "ListItem", position: 3, name: "2027年度 私立医学部入試日程", item: canonical },
  ],
};

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonical,
  inLanguage: "ja",
  dateModified: "2026-07-31",
  isPartOf: { "@type": "WebSite", name: "医学部予備校 レクサス E.C.", url: "https://lexus-ec.com/" },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: totalUniversities,
    itemListElement: privateMedicalUniversities2027.map((university, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `${university.name} 医学部 2027年度入試日程`,
      url: `${canonical}#${university.id}`,
    })),
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<SiteLayout title={title} description={description} canonical={canonical} ogImage="/og/private-medical-admissions-2027.png">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <main class="admissions-page">
    <header class="admissions-print-branding" aria-label="医学部予備校レクサスE.C.">
      <img
        class="admissions-print-branding__character"
        src="/illustrations/characters/lexus-kun-exp.png"
        alt="レクサスくん"
        width="1170"
        height="1170"
        loading="eager"
        decoding="sync"
      />
      <div>
        <img
          class="admissions-print-branding__logo"
          src="/assets/optimized/footer-logo-760.webp"
          alt="鬼特訓する医学部予備校レクサスE.C."
          width="760"
          height="300"
          loading="eager"
          decoding="sync"
        />
        <p>2027年度 私立医学部入試日程｜最終更新：{lastUpdated}</p>
      </div>
      <img
        class="admissions-print-branding__character"
        src="/illustrations/characters/yuki-sensei-default.png"
        alt="ゆうき先生"
        width="395"
        height="395"
        loading="eager"
        decoding="sync"
      />
    </header>

    <section class="admissions-hero">
      <div class="content admissions-hero__inner">
        <nav class="admissions-breadcrumb" aria-label="パンくずリスト">
          <a href="/">ホーム</a>
          <span aria-hidden="true">/</span>
          <a href="/top/information-shiritsu/">私立医学部情報</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">2027年度 入試日程</span>
        </nav>

        <div class="admissions-hero__grid">
          <div class="admissions-hero__copy">
            <p class="admissions-kicker"><span>2027</span> PRIVATE MEDICAL SCHOOL EXAMS</p>
            <h1>
              私立医学部31大学<br />
              <strong>入試日程まるわかり</strong>
            </h1>
            <p class="admissions-hero__lead">
              一般選抜と共通テスト利用選抜を、<b>日付・大学・締切</b>の3方向から。
              出願から入学手続まで、受験校の組み合わせを迷わず確認できます。
            </p>
            <div class="admissions-hero__actions">
              <a class="admissions-primary-button" href="#calendar">日付から見る</a>
              <a class="admissions-secondary-button" href="#universities">大学から探す</a>
            </div>
          </div>

          <aside class="admissions-common-card" aria-label="大学入学共通テストの重要日程">
            <p class="admissions-common-card__label">共通テスト本番</p>
            <p class="admissions-common-card__date"><span>1</span>月<span>16</span>日・<span>17</span>日</p>
            <p class="admissions-common-card__year">2027 SAT — SUN</p>
            <dl>
              <div>
                <dt>出願</dt>
                <dd>2026.9.15〜10.2</dd>
              </div>
              <div>
                <dt>追試</dt>
                <dd>2027.1.23・24</dd>
              </div>
            </dl>
            <a href={commonTestDates2027.sourceUrl} target="_blank" rel="noreferrer">大学入試センターの実施要項 ↗</a>
          </aside>
        </div>

        <div class="admissions-update-row">
          <span class="admissions-live-dot" aria-hidden="true"></span>
          <span>最終更新：{lastUpdated}</span>
          <a href="#updates">更新内容を見る<span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <section class="admissions-update-history" id="updates" aria-labelledby="updates-title">
      <div class="content admissions-update-history__inner">
        <header class="admissions-update-history__header">
          <p>UPDATE HISTORY</p>
          <h2 id="updates-title">更新履歴</h2>
          <p>このページに新しく追加・改善した内容をまとめています。</p>
        </header>

        <ol class="admissions-update-history__list">
          {
            updateHistory.map((update, index) => (
              <li class:list={["admissions-update-item", { "admissions-update-item--latest": index === 0 }]}>
                <div class="admissions-update-item__meta">
                  {index === 0 && <span>NEW</span>}
                  <time datetime={update.dateTime}>{update.date}</time>
                </div>
                <div class="admissions-update-item__body">
                  <h3>{update.title}</h3>
                  <ul>
                    {update.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <nav class="admissions-jump-nav" aria-label="ページ内メニュー">
      <div class="content admissions-jump-nav__inner">
        <a href="#deadlines" aria-label="出願締切へ移動">
          <span class="admissions-jump-nav__index">01</span>
          <span class="admissions-jump-nav__label admissions-jump-nav__label--long">出願締切</span>
          <span class="admissions-jump-nav__label admissions-jump-nav__label--short">出願</span>
        </a>
        <a href="#calendar" aria-label="試験日カレンダーへ移動">
          <span class="admissions-jump-nav__index">02</span>
          <span class="admissions-jump-nav__label admissions-jump-nav__label--long">試験日カレンダー</span>
          <span class="admissions-jump-nav__label admissions-jump-nav__label--short">試験日</span>
        </a>
        <a href="#common-test" aria-label="共通テスト利用へ移動">
          <span class="admissions-jump-nav__index">03</span>
          <span class="admissions-jump-nav__label admissions-jump-nav__label--long">共テ利用</span>
          <span class="admissions-jump-nav__label admissions-jump-nav__label--short">共テ</span>
        </a>
        <a href="#universities" aria-label="大学別31校へ移動">
          <span class="admissions-jump-nav__index">04</span>
          <span class="admissions-jump-nav__label admissions-jump-nav__label--long">大学別31校</span>
          <span class="admissions-jump-nav__label admissions-jump-nav__label--short">大学別</span>
        </a>
        <a href="#full-schedule" aria-label="全日程カレンダーへ移動">
          <span class="admissions-jump-nav__index">05</span>
          <span class="admissions-jump-nav__label admissions-jump-nav__label--long">全日程カレンダー</span>
          <span class="admissions-jump-nav__label admissions-jump-nav__label--short">全日程</span>
        </a>
      </div>
    </nav>

    <section class="admissions-overview" aria-labelledby="overview-title">
      <div class="content">
        <div class="admissions-section-heading admissions-section-heading--split">
          <div>
            <p>AT A GLANCE</p>
            <h2 id="overview-title">まず、全体像を30秒で</h2>
          </div>
          <p class="admissions-heading-note">2027年度一般選抜・共通テスト利用選抜のみ掲載</p>
        </div>

        <div class="admissions-stat-grid">
          <article>
            <span>全国の私立医学部</span>
            <strong>{totalUniversities}<small>大学</small></strong>
            <p>地域・大学名で絞り込み可能</p>
          </article>
          <article>
            <span>一般選抜</span>
            <strong>{generalRouteCount}<small>方式</small></strong>
            <p>前期・後期・統一方式を含む</p>
          </article>
          <article>
            <span>共通テスト利用</span>
            <strong>{commonTestUniversities.length}<small>大学</small></strong>
            <p>前期・後期など全{commonRouteCount}方式</p>
          </article>
          <article>
            <span>確定版の募集要項が公表済み</span>
            <strong>{officialUniversities.length}<small>大学</small></strong>
            <p>出願から入学手続まで詳しく確認</p>
          </article>
        </div>

        <div class="admissions-notice" role="note">
          <span aria-hidden="true">!</span>
          <div>
            <strong>大学によって、現在公表されている情報の範囲が異なります</strong>
            <p>
              「詳細日程あり」は確定版の募集要項が公表済み、「概要日程あり」は試験日などの概要が公表済みの大学です。
              未発表の日付は公表され次第更新します。出願前には各大学の最新情報も必ずご確認ください。
            </p>
          </div>
        </div>
      </div>
    </section>

    <AdmissionsBrandDivider variant="lexus" />

    <section class="admissions-deadlines" id="deadlines" aria-labelledby="deadlines-title">
      <div class="content">
        <div class="admissions-section-heading admissions-section-heading--printable">
          <div>
            <p>APPLICATION DEADLINES</p>
            <h2 id="deadlines-title">出願締め切りを日付順に見る</h2>
            <p>Web登録と郵送書類の期限を分けて確認できます。</p>
          </div>
          <button type="button" class="admissions-print-button" data-print-section="deadlines">
            <span aria-hidden="true">⎙</span>
            このセクションを印刷
          </button>
        </div>

        <div class="admissions-deadline-layout">
          <aside class="admissions-deadline-focus">
            <span>締切が集中する日</span>
            <strong>1/15</strong>
            <p>複数大学・方式の締め切りが重なります。登録と郵送を同じ締め切りだと思い込まないことが大切です。</p>
            <ul>
              <li>「Web登録締切」は、インターネット出願の登録完了期限です。</li>
              <li>書類期限の「必着」「消印有効」を必ず確認してください。</li>
              <li>調査書の必要部数は、出願校が固まる前に確認しておきましょう。</li>
            </ul>
            <p class="admissions-deadline-focus__note">「時刻未公表」「要項公開待ち」は、現在の公式資料に詳細がない項目です。公表後に更新します。</p>
          </aside>

          <div
            class="admissions-deadline-list"
            tabindex="0"
            role="region"
            aria-label="2027年度私立医学部入試 出願締切一覧"
          >
            {applicationDeadlineGroups2027.map((group) => (
              <section class="admissions-deadline-group" aria-label={`${group.date}締切`}>
                <header>
                  {group.dateTime ? (
                    <time datetime={group.dateTime}>{group.date}</time>
                  ) : (
                    <span class="admissions-deadline-group__date">{group.date}</span>
                  )}
                  <span>{group.entries.length}件</span>
                </header>
                <div>
                  {group.entries.map((entry) => (
                    <article class="admissions-deadline-entry">
                      <div class="admissions-deadline-entry__school">
                        <strong>{entry.university}</strong>
                        <span>{entry.routes}</span>
                      </div>
                      <dl>
                        <div>
                          <dt>Web登録締切</dt>
                          <dd>{entry.webDeadline}</dd>
                        </div>
                        <div>
                          <dt>書類期限</dt>
                          <dd>{entry.documentDeadline}</dd>
                        </div>
                      </dl>
                      <a href={entry.sourceUrl} target="_blank" rel="noopener noreferrer">公式資料</a>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="admissions-calendar-section" id="calendar" aria-labelledby="calendar-title">
      <div class="content">
        <div class="admissions-section-heading admissions-section-heading--light admissions-section-heading--printable">
          <div>
            <p>EXAM CALENDAR</p>
            <h2 id="calendar-title">一次・二次試験を日付順に見る</h2>
            <p>同じ日の一次試験と二次試験を並べて、受験校の重なりを確認できます。</p>
          </div>
          <button type="button" class="admissions-print-button" data-print-section="calendar">
            <span aria-hidden="true">⎙</span>
            このセクションを印刷
          </button>
        </div>

        <div
          class="admissions-calendar-viewport"
          tabindex="0"
          role="region"
          aria-label="2027年度私立医学部入試 一次・二次試験カレンダー"
        >
          <div class="admissions-calendar-head" aria-hidden="true">
            <span>日付</span>
            <span>一次試験</span>
            <span>二次試験</span>
          </div>

          <div class="admissions-calendar-list">
            {examCalendar2027.map((event) => (
              <article
                class:list={[
                  "admissions-calendar-row",
                  {
                    "admissions-calendar-row--empty":
                      event.first.length === 0 && event.second.length === 0,
                  },
                ]}
              >
                <div class="admissions-calendar-date">
                  <strong>{event.date}</strong>
                  <span>{event.weekday}</span>
                </div>
                <div class="admissions-calendar-exams" data-heading="一次試験">
                  {event.first.length > 0 ? (
                    <ul>
                      {event.first.map((exam) => <li>{exam}</li>)}
                    </ul>
                  ) : (
                    <span class="admissions-calendar-empty">—</span>
                  )}
                </div>
                <div class="admissions-calendar-exams" data-heading="二次試験">
                  {event.second.length > 0 ? (
                    <ul>
                      {event.second.map((exam) => <li>{exam}</li>)}
                    </ul>
                  ) : (
                    <span class="admissions-calendar-empty">—</span>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>

        <p class="admissions-calendar-caption">
