        </div>

        <div class="admissions-university-list" data-university-list>
          {privateMedicalUniversities2027.map((university, index) => {
            const categories = [...new Set(university.routes.map((route) => route.category))];
            const statuses = [...new Set(university.routes.map((route) => route.status))];
            const topStatus = statuses.includes("official")
              ? "official"
              : statuses.includes("preliminary")
                ? "preliminary"
                : "pending";

            return (
              <details
                class="admissions-university"
                id={university.id}
                data-university-card
                data-name={university.name}
                data-region={university.region}
                data-categories={categories.join(" ")}
                data-statuses={statuses.join(" ")}
              >
                <summary>
                  <span class="admissions-university__number">{String(index + 1).padStart(2, "0")}</span>
                  <span class="admissions-university__identity">
                    <small>{university.region}・{university.prefecture}</small>
                    <strong>{university.name}</strong>
                  </span>
                  <span class="admissions-university__chips">
                    {categories.includes("general") && <span class="route-chip route-chip--general">一般</span>}
                    {categories.includes("common") && <span class="route-chip route-chip--common">共テ</span>}
                    <span class={`status-chip status-chip--${topStatus}`}>{statusLabels[topStatus]}</span>
                  </span>
                  <span class="admissions-university__open" aria-hidden="true"></span>
                </summary>

                <div class="admissions-university__body">
                  <div class="admissions-route-head" aria-hidden="true">
                    <span>選抜方式</span>
                    <span>出願期間・締切</span>
                    <span>一次試験</span>
                    <span>二次試験</span>
                    <span>合格発表</span>
                    <span>入学手続</span>
                  </div>

                  {university.routes.map((route) => (
                    <article class={`admissions-route admissions-route--${route.category}`}>
                      <div>
                        <span class={`route-chip route-chip--${route.category}`}>{route.category === "general" ? "一般" : "共テ"}</span>
                        <strong>{route.name}</strong>
                      </div>
                      <dl>
                        <div>
                          <dt>出願</dt>
                          <dd>{route.application}</dd>
                        </div>
                        <div>
                          <dt>一次</dt>
                          <dd>{route.firstExam}</dd>
                        </div>
                        <div>
                          <dt>二次</dt>
                          <dd>{route.secondExam}</dd>
                        </div>
                        <div>
                          <dt>発表</dt>
                          <dd>{route.result ?? "募集要項で確認"}</dd>
                        </div>
                        <div>
                          <dt>手続</dt>
                          <dd>{route.procedure}</dd>
                        </div>
                      </dl>
                      <div class="admissions-route__source">
                        <span class={`status-chip status-chip--${route.status}`}>{statusLabels[route.status]}</span>
                        {route.sourceUrl && (
                          <a href={route.sourceUrl} target="_blank" rel="noreferrer" aria-label={`${university.name}の公式入試情報`}>
                            公式情報 ↗
                          </a>
                        )}
                      </div>
                    </article>
                  ))}

                  <div class="admissions-university__footer">
                    <a href={university.strategyPath}>{university.name}の2027年度入試対策を見る →</a>
                  </div>
                </div>
              </details>
            );
          })}
        </div>

        <div class="admissions-empty" data-filter-empty hidden>
          <strong>該当する大学が見つかりませんでした</strong>
          <p>検索語や絞り込み条件を変えてお試しください。</p>
        </div>
      </div>
    </section>

    <section class="admissions-full-schedule" id="full-schedule" aria-labelledby="full-schedule-title">
      <div class="content">
        <div class="admissions-section-heading admissions-section-heading--light">
          <p>COMPLETE SCHEDULE</p>
          <h2 id="full-schedule-title">出願から入学手続きまで、すべての日程を見る</h2>
          <p>
            出願開始・締切から一次／二次試験、合格発表、入学手続き締切までを同じ日付軸で確認できます。
          </p>
        </div>

        <div class="admissions-full-schedule__guide">
          <div class="admissions-full-schedule__legend" aria-label="選抜方式の凡例">
            <span class="admissions-full-schedule__route admissions-full-schedule__route--general">一般</span>
            <span class="admissions-full-schedule__route admissions-full-schedule__route--common">共テ</span>
          </div>
          <p>
            ヘッダーと日付列は固定されています。表の中を上下・左右にスクロールしてご覧ください。
          </p>
          <span class="admissions-full-schedule__swipe" aria-hidden="true">← 左右にスクロール →</span>
        </div>

        <div
          class="admissions-full-schedule__viewport"
          tabindex="0"
          role="region"
          aria-label="2027年度私立医学部入試 全日程カレンダー"
        >
          <table class="admissions-full-schedule__table">
            <caption>
              2027年度私立医学部の一般選抜・共通テスト利用選抜について、出願から入学手続きまでの日程を日付順に掲載しています。
            </caption>
            <thead>
              <tr>
                <th scope="col" class="admissions-full-schedule__date-head">日付</th>
                {fullScheduleColumns.map((column) => (
                  <th scope="col">
                    <span>{column.label}</span>
                    <small>{column.shortLabel}</small>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {fullScheduleCalendar2027.map((day) => (
                <tr
                  class:list={[
                    {
                      "admissions-full-schedule__row--empty": !day.hasEvents,
                      "admissions-full-schedule__row--weekend": day.isWeekend,
                      "admissions-full-schedule__row--month-start": day.isMonthStart,
                    },
                  ]}
                >
                  <th scope="row" class="admissions-full-schedule__date">
                    <time datetime={day.dateTime}>
                      <strong>{day.date}</strong>
                      <span>{day.weekday}</span>
                    </time>
                  </th>
                  {fullScheduleColumns.map((column) => {
                    const entries = day.events[column.key];

                    return (
                      <td class:list={{ "admissions-full-schedule__cell--empty": entries.length === 0 }}>
                        {entries.length > 0 ? (
                          <ul class="admissions-full-schedule__entries">
                            {entries.map((entry) => (
                              <li class={`admissions-full-schedule__entry admissions-full-schedule__entry--${entry.category}`}>
                                <div>
                                  <span
                                    class={`admissions-full-schedule__route admissions-full-schedule__route--${entry.category}`}
                                  >
                                    {entry.category === "general" ? "一般" : "共テ"}
                                  </span>
                                  {entry.sourceUrl ? (
                                    <a
                                      href={entry.sourceUrl}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      title={`${entry.university}の公式情報（${statusLabels[entry.status]}）`}
                                    >
                                      {shortUniversityName(entry.university)}{entry.sequenceLabel}
                                    </a>
                                  ) : (
                                    <strong>{shortUniversityName(entry.university)}{entry.sequenceLabel}</strong>
                                  )}
                                </div>
                                <span>{entry.routes.join("／")}</span>
                                {entry.detail && <small>{entry.detail}</small>}
                              </li>
                            ))}
                          </ul>
                        ) : (
                          <span class="admissions-full-schedule__empty" aria-label="該当日程なし">—</span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="admissions-full-schedule__caption">
          出願締切は、Web登録・郵送書類などの締切が異なる場合、それぞれの日付に掲載しています。選択日・希望日・大学指定日は、候補となる各日に表示しています。
        </p>

        {fullSchedulePendingItems2027.length > 0 && (
          <details class="admissions-full-schedule__pending">
            <summary>
              <span>募集要項で日付の公表を待っている項目</span>
              <strong>{fullSchedulePendingItems2027.length}方式</strong>
            </summary>
            <div>
              {fullSchedulePendingItems2027.map((item) => (
                <article>
                  <p>
                    <span
                      class={`admissions-full-schedule__route admissions-full-schedule__route--${item.category}`}
                    >
                      {item.category === "general" ? "一般" : "共テ"}
                    </span>
                    <strong>{item.university}</strong>
                  </p>
                  <span>{item.route}</span>
                  <small>
                    {item.fields.map((field) => fullSchedulePendingFieldLabels[field]).join("・")}
                  </small>
                </article>
              ))}
            </div>
          </details>
        )}
      </div>
    </section>

    <AdmissionsBrandDivider variant="duo" />

    <section class="admissions-guide" aria-labelledby="guide-title">
      <div class="content">
        <div class="admissions-section-heading">
          <p>HOW TO USE</p>
          <h2 id="guide-title">日程表の使い方</h2>
        </div>

        <ol class="admissions-guide__steps">
          <li>
            <span>1</span>
            <div>
              <h3>一次試験の重複を確認</h3>
              <p>カレンダーで同日実施の大学を見つけ、優先順位を決めます。</p>
            </div>
          </li>
          <li>
            <span>2</span>
            <div>
              <h3>二次試験まで仮置き</h3>
              <p>一次合格後の日程も含めて、移動と宿泊の余白を確保します。</p>
            </div>
          </li>
          <li>
            <span>3</span>
            <div>
              <h3>手続締切と学納金を確認</h3>
              <p>併願校の合格発表前に入学金が必要か、必ず募集要項で確認します。</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="admissions-faq" aria-labelledby="faq-title">
      <div class="content-narrow">
        <div class="admissions-section-heading">
          <p>FAQ</p>
          <h2 id="faq-title">2027年度 私立医学部入試日程のよくある質問</h2>
        </div>
        <div class="admissions-faq__list">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>

        <aside class="admissions-data-access" aria-label="掲載データについて">
          <p>
            <strong>掲載データについて</strong>
            本ページの日程は大学公式資料を優先して確認し、未公表事項は推測で補完していません。最終更新：<time datetime={lastUpdatedIso}>{lastUpdated}</time>
          </p>
          <a href={datasetUrl} type="application/json">機械可読JSONを見る</a>
        </aside>
      </div>
    </section>

    <section class="admissions-final-cta">
      <div class="content admissions-final-cta__inner">
        <div>
          <p>受験校の組み合わせ、ひとりで悩まなくて大丈夫です。</p>
          <h2>日程と相性から、合格可能性を最大化する併願プランへ。</h2>
        </div>
        <div>
          <a class="admissions-primary-button" href="/top/reservation/">無料個別相談を予約</a>
          <a class="admissions-secondary-button" href="/request-documents/">資料を請求する</a>
        </div>
      </div>
    </section>

  </main>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-admissions-filter]");
      const cards = [...document.querySelectorAll("[data-university-card]")];
      const count = document.querySelector("[data-filter-count]");
      const empty = document.querySelector("[data-filter-empty]");

      if (form instanceof HTMLFormElement) {
        const query = form.querySelector("[data-filter-query]");
        const region = form.querySelector("[data-filter-region]");
        const category = form.querySelector("[data-filter-category]");
        const status = form.querySelector("[data-filter-status]");

        const applyFilters = () => {
          const searchValue = query instanceof HTMLInputElement ? query.value.trim().toLowerCase() : "";
          const regionValue = region instanceof HTMLSelectElement ? region.value : "all";
          const categoryValue = category instanceof HTMLSelectElement ? category.value : "all";
          const statusValue = status instanceof HTMLSelectElement ? status.value : "all";
          let visible = 0;

          cards.forEach((card) => {
            if (!(card instanceof HTMLElement)) return;
            const matchesQuery = !searchValue || (card.dataset.name || "").toLowerCase().includes(searchValue);
            const matchesRegion = regionValue === "all" || card.dataset.region === regionValue;
            const matchesCategory =
              categoryValue === "all" || (card.dataset.categories || "").split(" ").includes(categoryValue);
            const matchesStatus =
              statusValue === "all" || (card.dataset.statuses || "").split(" ").includes(statusValue);
            const matches = matchesQuery && matchesRegion && matchesCategory && matchesStatus;
            card.hidden = !matches;
            if (matches) visible += 1;
          });

          if (count) count.textContent = String(visible);
          if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
        };

        form.addEventListener("input", applyFilters);
        form.addEventListener("change", applyFilters);
        form.addEventListener("reset", () => window.setTimeout(applyFilters, 0));
      }

      let titleBeforePrint = null;

      const clearPrintTarget = () => {
        document.body.classList.remove("is-printing-admissions-section");
        document.querySelector(".is-print-target")?.classList.remove("is-print-target");
        if (titleBeforePrint !== null) {
          document.title = titleBeforePrint;
          titleBeforePrint = null;
        }
      };

      document.querySelectorAll("[data-print-section]").forEach((button) => {
        button.addEventListener("click", () => {
          if (!(button instanceof HTMLButtonElement)) return;
          const targetId = button.dataset.printSection;
          const target = targetId ? document.getElementById(targetId) : null;

          if (!(target instanceof HTMLElement)) return;

          clearPrintTarget();
          target.classList.add("is-print-target");
          document.body.classList.add("is-printing-admissions-section");
          titleBeforePrint = document.title;
          document.title = button.dataset.printTitle || document.title;
          window.print();
        });
      });

      window.addEventListener("afterprint", clearPrintTarget);
    })();
  </script>
</SiteLayout>
