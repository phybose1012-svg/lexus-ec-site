---
import {
  applicationDeadlineClusters2027,
  commonTestDates2027,
  examCalendar2027,
  privateMedicalUniversities2027,
  type AdmissionRouteStatus,
} from "../../data/privateMedicalAdmissions2027";
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/admissions-2027.css";

const title = "【2027年度】私立医学部入試日程一覧｜一般選抜・共通テスト利用31大学";
const description =
  "2027年度（令和9年度）の私立医学部31大学の一般選抜・共通テスト利用選抜を、試験日カレンダー、大学別、出願締切別に一覧化。一次・二次試験、出願期間、入学手続まで確認できます。";
const canonical = "https://lexus-ec.com/private-medical-school-admissions-schedule-2027/";
const lastUpdated = "2026年7月30日";
const totalUniversities = privateMedicalUniversities2027.length;
const commonTestUniversities = privateMedicalUniversities2027.filter((university) =>
  university.routes.some((route) => route.category === "common"),
);
const officialUniversities = privateMedicalUniversities2027.filter((university) =>
  university.routes.some((route) => route.status === "official"),
);
const generalRouteCount = privateMedicalUniversities2027.reduce(
  (count, university) => count + university.routes.filter((route) => route.category === "general").length,
  0,
);
const commonRouteCount = privateMedicalUniversities2027.reduce(
  (count, university) => count + university.routes.filter((route) => route.category === "common").length,
  0,
);

const statusLabels: Record<AdmissionRouteStatus, string> = {
  official: "詳細日程あり",
  preliminary: "概要日程あり",
  pending: "日程未公表",
};

const faqs = [
  {
    question: "2027年度の大学入学共通テストはいつですか？",
    answer:
      "本試験は2027年1月16日（土）・17日（日）、追試験は1月23日（土）・24日（日）です。出願期間は2026年9月15日（火）から10月2日（金）までです。",
  },
  {
    question: "私立医学部の一般選抜はいつから始まりますか？",
    answer:
      "現時点の公表・予告情報では、1月21日から23日の帝京大学が早期日程にあたり、1月25日に国際医療福祉大学と自治医科大学、1月31日に近畿大学前期が続きます。2月1日から主要日程が集中します。",
  },
  {
    question: "一般選抜と共通テスト利用選抜は併願できますか？",
    answer:
      "併願できる大学が多くあります。同じ大学で二次試験や面接を共通化する場合もありますが、出願期間や必要科目が方式ごとに異なるため、必ず各大学の2027年度学生募集要項で確認してください。",
  },
  {
    question: "このページだけで出願手続きをしても大丈夫ですか？",
    answer:
      "いいえ。このページは受験計画を立てるための一覧です。締切の扱い（必着・消印有効・Web登録）や試験会場は変更される可能性があるため、出願前には必ず各大学公式サイトの学生募集要項を確認してください。",
  },
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: "https://lexus-ec.com/" },
    { "@type": "ListItem", position: 2, name: "私立医学部情報", item: "https://lexus-ec.com/top/information-shiritsu/" },
    { "@type": "ListItem", position: 3, name: "2027年度 私立医学部入試日程", item: canonical },
  ],
};

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonical,
  inLanguage: "ja",
  dateModified: "2026-07-30",
  isPartOf: { "@type": "WebSite", name: "医学部予備校 レクサス E.C.", url: "https://lexus-ec.com/" },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: totalUniversities,
    itemListElement: privateMedicalUniversities2027.map((university, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `${university.name} 医学部 2027年度入試日程`,
      url: `${canonical}#${university.id}`,
    })),
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<SiteLayout title={title} description={description} canonical={canonical} ogImage="/og/private-medical-admissions-2027.png">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <main class="admissions-page">
    <section class="admissions-hero">
      <div class="content admissions-hero__inner">
        <nav class="admissions-breadcrumb" aria-label="パンくずリスト">
          <a href="/">ホーム</a>
          <span aria-hidden="true">/</span>
          <a href="/top/information-shiritsu/">私立医学部情報</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">2027年度 入試日程</span>
        </nav>

        <div class="admissions-hero__grid">
          <div class="admissions-hero__copy">
            <p class="admissions-kicker"><span>2027</span> PRIVATE MEDICAL SCHOOL EXAMS</p>
            <h1>
              私立医学部31大学<br />
              <strong>入試日程まるわかり</strong>
            </h1>
            <p class="admissions-hero__lead">
              一般選抜と共通テスト利用選抜を、<b>日付・大学・締切</b>の3方向から。
              出願から入学手続まで、受験校の組み合わせを迷わず確認できます。
            </p>
            <div class="admissions-hero__actions">
              <a class="admissions-primary-button" href="#calendar">日付から見る</a>
              <a class="admissions-secondary-button" href="#universities">大学から探す</a>
            </div>
          </div>

          <aside class="admissions-common-card" aria-label="大学入学共通テストの重要日程">
            <p class="admissions-common-card__label">共通テスト本番</p>
            <p class="admissions-common-card__date"><span>1</span>月<span>16</span>日・<span>17</span>日</p>
            <p class="admissions-common-card__year">2027 SAT — SUN</p>
            <dl>
              <div>
                <dt>出願</dt>
                <dd>2026.9.15〜10.2</dd>
              </div>
              <div>
                <dt>追試</dt>
                <dd>2027.1.23・24</dd>
              </div>
            </dl>
            <a href={commonTestDates2027.sourceUrl} target="_blank" rel="noreferrer">大学入試センターの実施要項 ↗</a>
          </aside>
        </div>

        <div class="admissions-update-row">
          <span class="admissions-live-dot" aria-hidden="true"></span>
          <span>最終更新：{lastUpdated}</span>
          <span>発表済み情報から随時更新</span>
        </div>
      </div>
    </section>

    <nav class="admissions-jump-nav" aria-label="ページ内メニュー">
      <div class="content admissions-jump-nav__inner">
        <a href="#calendar"><span>01</span>試験日カレンダー</a>
        <a href="#deadlines"><span>02</span>出願締切</a>
        <a href="#universities"><span>03</span>大学別31校</a>
        <a href="#common-test"><span>04</span>共テ利用</a>
      </div>
    </nav>

    <section class="admissions-overview" aria-labelledby="overview-title">
      <div class="content">
        <div class="admissions-section-heading admissions-section-heading--split">
          <div>
            <p>AT A GLANCE</p>
            <h2 id="overview-title">まず、全体像を30秒で</h2>
          </div>
          <p class="admissions-heading-note">2027年度一般選抜・共通テスト利用選抜のみ掲載</p>
        </div>

        <div class="admissions-stat-grid">
          <article>
            <span>全国の私立医学部</span>
            <strong>{totalUniversities}<small>大学</small></strong>
            <p>地域・大学名で絞り込み可能</p>
          </article>
          <article>
            <span>一般選抜</span>
            <strong>{generalRouteCount}<small>方式</small></strong>
            <p>前期・後期・統一方式を含む</p>
          </article>
          <article>
            <span>共通テスト利用</span>
            <strong>{commonTestUniversities.length}<small>大学</small></strong>
            <p>前期・後期など全{commonRouteCount}方式</p>
          </article>
          <article>
            <span>確定版の募集要項が公表済み</span>
            <strong>{officialUniversities.length}<small>大学</small></strong>
            <p>出願から入学手続まで詳しく確認</p>
          </article>
        </div>

        <div class="admissions-notice" role="note">
          <span aria-hidden="true">!</span>
          <div>
            <strong>大学によって、現在公表されている情報の範囲が異なります</strong>
            <p>
              「詳細日程あり」は確定版の募集要項が公表済み、「概要日程あり」は試験日などの概要が公表済みの大学です。
              未発表の日付は公表され次第更新します。出願前には各大学の最新情報も必ずご確認ください。
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="admissions-calendar-section" id="calendar" aria-labelledby="calendar-title">
      <div class="content">
        <div class="admissions-section-heading admissions-section-heading--light">
          <p>EXAM CALENDAR</p>
          <h2 id="calendar-title">一次・二次試験を日付順に見る</h2>
          <p>同じ日の一次試験と二次試験を並べて、受験校の重なりを確認できます。</p>
        </div>

        <div class="admissions-calendar-head" aria-hidden="true">
          <span>日付</span>
          <span>一次試験</span>
          <span>二次試験</span>
        </div>

        <div class="admissions-calendar-list">
          {examCalendar2027.map((event) => (
            <article
              class:list={[
                "admissions-calendar-row",
                {
                  "admissions-calendar-row--empty":
                    event.first.length === 0 && event.second.length === 0,
                },
              ]}
            >
              <div class="admissions-calendar-date">
                <strong>{event.date}</strong>
                <span>{event.weekday}</span>
              </div>
              <div class="admissions-calendar-exams" data-heading="一次試験">
                {event.first.length > 0 ? (
                  <ul>
                    {event.first.map((exam) => <li>{exam}</li>)}
                  </ul>
                ) : (
                  <span class="admissions-calendar-empty">—</span>
                )}
              </div>
              <div class="admissions-calendar-exams" data-heading="二次試験">
                {event.second.length > 0 ? (
                  <ul>
                    {event.second.map((exam) => <li>{exam}</li>)}
                  </ul>
                ) : (
                  <span class="admissions-calendar-empty">—</span>
                )}
              </div>
            </article>
          ))}
        </div>

        <p class="admissions-calendar-caption">
          ※1/16〜3/18は、試験のない日も「—」で表示しています。大学名の後ろの①②…は、同じ選抜方式に複数ある一次・二次試験日の日付順です。複数日から選択する試験・大学が受験日を指定する試験は、候補日すべてに掲載しています。
        </p>
      </div>
    </section>

    <section class="admissions-deadlines" id="deadlines" aria-labelledby="deadlines-title">
      <div class="content">
        <div class="admissions-section-heading admissions-section-heading--split">
          <div>
            <p>APPLICATION DEADLINES</p>
            <h2 id="deadlines-title">出願締切から逆算する</h2>
          </div>
          <p class="admissions-heading-note">年明けは1月15日前後に締切が集中</p>
        </div>

        <div class="admissions-deadline-layout">
          <aside class="admissions-deadline-focus">
            <span>最初の山場</span>
            <strong>1/15</strong>
            <p>杏林、関西医科、順天堂、金沢医科、北里の共テ利用などが集中します。</p>
            <ul>
              <li>Web登録の終了時刻を確認</li>
              <li>「必着」と「消印有効」を区別</li>
              <li>調査書の必要部数を早めに確保</li>
            </ul>
          </aside>

          <div class="admissions-deadline-list">
            {applicationDeadlineClusters2027.map((deadline) => (
              <article>
                <time datetime={`2027-${deadline.date.split("/").map((part) => part.padStart(2, "0")).join("-")}`}>{deadline.date}</time>
                <p>{deadline.schools}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="admissions-universities" id="universities" aria-labelledby="universities-title">
      <div class="content">
        <div class="admissions-section-heading">
          <p>ALL 31 UNIVERSITIES</p>
          <h2 id="universities-title">大学別に日程を確認</h2>
          <p>大学名・地域・選抜方式で絞り込めます。カードを開くと、出願から入学手続までを横並びで確認できます。</p>
        </div>

        <form class="admissions-filter" data-admissions-filter>
          <label class="admissions-search">
            <span>大学名を検索</span>
            <input type="search" name="query" placeholder="例：慶應、医科、福岡" autocomplete="off" data-filter-query />
          </label>
          <label>
            <span>地域</span>
            <select name="region" data-filter-region>
              <option value="all">全国</option>
              <option value="北海道・東北">北海道・東北</option>
              <option value="関東">関東</option>
              <option value="中部">中部</option>
              <option value="近畿">近畿</option>
              <option value="中国・四国">中国・四国</option>
              <option value="九州">九州</option>
            </select>
          </label>
          <label>
            <span>選抜方式</span>
            <select name="category" data-filter-category>
              <option value="all">すべて</option>
              <option value="general">一般選抜あり</option>
              <option value="common">共テ利用あり</option>
            </select>
          </label>
          <label>
            <span>日程の公表状況</span>
            <select name="status" data-filter-status>
              <option value="all">すべて</option>
              <option value="official">詳細日程あり</option>
              <option value="preliminary">概要日程あり</option>
              <option value="pending">日程未公表</option>
            </select>
          </label>
          <button type="reset" class="admissions-filter__reset">条件をクリア</button>
        </form>

        <div class="admissions-filter-result" aria-live="polite">
          <strong data-filter-count>{totalUniversities}</strong>大学を表示
        </div>

        <div class="admissions-university-list" data-university-list>
          {privateMedicalUniversities2027.map((university, index) => {
            const categories = [...new Set(university.routes.map((route) => route.category))];
            const statuses = [...new Set(university.routes.map((route) => route.status))];
            const topStatus = statuses.includes("official")
              ? "official"
              : statuses.includes("preliminary")
                ? "preliminary"
                : "pending";

            return (
              <details
                class="admissions-university"
                id={university.id}
                data-university-card
                data-name={university.name}
                data-region={university.region}
                data-categories={categories.join(" ")}
                data-statuses={statuses.join(" ")}
              >
                <summary>
                  <span class="admissions-university__number">{String(index + 1).padStart(2, "0")}</span>
                  <span class="admissions-university__identity">
                    <small>{university.region}・{university.prefecture}</small>
                    <strong>{university.name}</strong>
                  </span>
                  <span class="admissions-university__chips">
                    {categories.includes("general") && <span class="route-chip route-chip--general">一般</span>}
                    {categories.includes("common") && <span class="route-chip route-chip--common">共テ</span>}
                    <span class={`status-chip status-chip--${topStatus}`}>{statusLabels[topStatus]}</span>
                  </span>
                  <span class="admissions-university__open" aria-hidden="true"></span>
                </summary>

                <div class="admissions-university__body">
                  <div class="admissions-route-head" aria-hidden="true">
                    <span>選抜方式</span>
                    <span>出願期間・締切</span>
                    <span>一次試験</span>
                    <span>二次試験</span>
                    <span>合格発表</span>
                    <span>入学手続</span>
                  </div>

                  {university.routes.map((route) => (
                    <article class={`admissions-route admissions-route--${route.category}`}>
                      <div>
                        <span class={`route-chip route-chip--${route.category}`}>{route.category === "general" ? "一般" : "共テ"}</span>
                        <strong>{route.name}</strong>
                      </div>
                      <dl>
                        <div>
                          <dt>出願</dt>
                          <dd>{route.application}</dd>
                        </div>
                        <div>
                          <dt>一次</dt>
                          <dd>{route.firstExam}</dd>
                        </div>
                        <div>
                          <dt>二次</dt>
                          <dd>{route.secondExam}</dd>
                        </div>
                        <div>
                          <dt>発表</dt>
                          <dd>{route.result ?? "募集要項で確認"}</dd>
                        </div>
                        <div>
                          <dt>手続</dt>
                          <dd>{route.procedure}</dd>
                        </div>
                      </dl>
                      <div class="admissions-route__source">
                        <span class={`status-chip status-chip--${route.status}`}>{statusLabels[route.status]}</span>
                        {route.sourceUrl && (
                          <a href={route.sourceUrl} target="_blank" rel="noreferrer" aria-label={`${university.name}の公式入試情報`}>
                            公式情報 ↗
                          </a>
                        )}
                      </div>
                    </article>
                  ))}

                  <div class="admissions-university__footer">
                    <a href={university.strategyPath}>{university.name}の2027年度入試対策を見る →</a>
                  </div>
                </div>
              </details>
            );
          })}
        </div>

        <div class="admissions-empty" data-filter-empty hidden>
          <strong>該当する大学が見つかりませんでした</strong>
          <p>検索語や絞り込み条件を変えてお試しください。</p>
        </div>
      </div>
    </section>

    <section class="admissions-common-test" id="common-test" aria-labelledby="common-test-title">
      <div class="content">
        <div class="admissions-section-heading admissions-section-heading--light">
          <p>COMMON TEST ROUTES</p>
          <h2 id="common-test-title">共通テスト利用だけを比較</h2>
          <p>共通テスト後に大学独自の試験・面接があるかどうかを、大学ごとに確認できます。</p>
        </div>

        <div class="admissions-common-test__dates">
          <article>
            <span>マイページ作成</span>
            <strong>7/1〜10/2</strong>
            <small>2026年</small>
          </article>
          <article>
            <span>出願期間</span>
            <strong>9/15〜10/2</strong>
            <small>2026年</small>
          </article>
          <article class="is-accent">
            <span>本試験</span>
            <strong>1/16・17</strong>
            <small>2027年</small>
          </article>
          <article>
            <span>追試験</span>
            <strong>1/23・24</strong>
            <small>2027年</small>
          </article>
        </div>

        <div class="admissions-common-grid">
          {commonTestUniversities.map((university) => (
            <article>
              <div>
                <small>{university.prefecture}</small>
                <h3>{university.name}</h3>
              </div>
              <ul>
                {university.routes
                  .filter((route) => route.category === "common")
                  .map((route) => (
                    <li>
                      <strong>{route.name}</strong>
                      <span>{route.secondExam === "未公表" ? "詳細未公表" : `大学独自試験：${route.secondExam}`}</span>
                    </li>
                  ))}
              </ul>
              <a href={`#${university.id}`}>全日程を見る</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="admissions-guide" aria-labelledby="guide-title">
      <div class="content">
        <div class="admissions-section-heading admissions-section-heading--split">
          <div>
            <p>HOW TO USE</p>
            <h2 id="guide-title">日程表の使い方</h2>
          </div>
          <button type="button" class="admissions-print-button" data-print-page>このページを印刷</button>
        </div>

        <ol class="admissions-guide__steps">
          <li>
            <span>1</span>
            <div>
              <h3>一次試験の重複を確認</h3>
              <p>カレンダーで同日実施の大学を見つけ、優先順位を決めます。</p>
            </div>
          </li>
          <li>
            <span>2</span>
            <div>
              <h3>二次試験まで仮置き</h3>
              <p>一次合格後の日程も含めて、移動と宿泊の余白を確保します。</p>
            </div>
          </li>
          <li>
            <span>3</span>
            <div>
              <h3>手続締切と学納金を確認</h3>
              <p>併願校の合格発表前に入学金が必要か、必ず募集要項で確認します。</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="admissions-faq" aria-labelledby="faq-title">
      <div class="content-narrow">
        <div class="admissions-section-heading">
          <p>FAQ</p>
          <h2 id="faq-title">2027年度 私立医学部入試日程のよくある質問</h2>
        </div>
        <div class="admissions-faq__list">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="admissions-final-cta">
      <div class="content admissions-final-cta__inner">
        <div>
          <p>受験校の組み合わせ、ひとりで悩まなくて大丈夫です。</p>
          <h2>日程と相性から、合格可能性を最大化する併願プランへ。</h2>
        </div>
        <div>
          <a class="admissions-primary-button" href="/top/reservation/">無料個別相談を予約</a>
          <a class="admissions-secondary-button" href="/request-documents/">資料を請求する</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-admissions-filter]");
      const cards = [...document.querySelectorAll("[data-university-card]")];
      const count = document.querySelector("[data-filter-count]");
      const empty = document.querySelector("[data-filter-empty]");

      if (form instanceof HTMLFormElement) {
        const query = form.querySelector("[data-filter-query]");
        const region = form.querySelector("[data-filter-region]");
        const category = form.querySelector("[data-filter-category]");
        const status = form.querySelector("[data-filter-status]");

        const applyFilters = () => {
          const searchValue = query instanceof HTMLInputElement ? query.value.trim().toLowerCase() : "";
          const regionValue = region instanceof HTMLSelectElement ? region.value : "all";
          const categoryValue = category instanceof HTMLSelectElement ? category.value : "all";
          const statusValue = status instanceof HTMLSelectElement ? status.value : "all";
          let visible = 0;

          cards.forEach((card) => {
            if (!(card instanceof HTMLElement)) return;
            const matchesQuery = !searchValue || (card.dataset.name || "").toLowerCase().includes(searchValue);
            const matchesRegion = regionValue === "all" || card.dataset.region === regionValue;
            const matchesCategory =
              categoryValue === "all" || (card.dataset.categories || "").split(" ").includes(categoryValue);
            const matchesStatus =
              statusValue === "all" || (card.dataset.statuses || "").split(" ").includes(statusValue);
            const matches = matchesQuery && matchesRegion && matchesCategory && matchesStatus;
            card.hidden = !matches;
            if (matches) visible += 1;
          });

          if (count) count.textContent = String(visible);
          if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
        };

        form.addEventListener("input", applyFilters);
        form.addEventListener("change", applyFilters);
        form.addEventListener("reset", () => window.setTimeout(applyFilters, 0));
      }

      document.querySelector("[data-print-page]")?.addEventListener("click", () => window.print());
    })();
  </script>
</SiteLayout>
