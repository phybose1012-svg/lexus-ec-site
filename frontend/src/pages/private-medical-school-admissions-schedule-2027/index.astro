const commonTestUniversities = privateMedicalUniversities2027.filter((university) =>
  university.routes.some((route) => route.category === "common"),
);
const officialUniversities = privateMedicalUniversities2027.filter((university) =>
  university.routes.some((route) => route.status === "official"),
);
const earliestScheduleDay = (column: FullScheduleColumnKey2027) =>
  fullScheduleCalendar2027.find((day) => day.events[column].length > 0);
const earliestApplicationStart = earliestScheduleDay("applicationStart");
const earliestApplicationDeadline = earliestScheduleDay("applicationDeadline");
const earliestGeneralFirstExam = fullScheduleCalendar2027.find((day) =>
  day.events.firstExam.some((entry) => entry.category === "general"),
);
const overviewUniversityNames = (
  day: (typeof fullScheduleCalendar2027)[number] | undefined,
  column: FullScheduleColumnKey2027,
) =>
  [
    ...new Set(
      (day?.events[column] ?? [])
        .map((entry) => entry.university)
        .filter((name) => name !== "大学入学共通テスト")
        .map((name) => (name === "日本大学" ? "日大" : name.replace(/大学$/, ""))),
    ),
  ].join("・");
const applicationDeadlineGroups2027 = applicationDeadlineEntries2027.reduce<
  Array<{
    date: string;
    dateTime?: string;
    entries: ApplicationDeadlineEntry2027[];
  }>
>((groups, entry) => {
  const latestGroup = groups.at(-1);

  if (latestGroup?.date === entry.date) {
    latestGroup.entries.push(entry);
    return groups;
  }

  groups.push({
    date: entry.date,
    dateTime: entry.dateTime,
    entries: [entry],
  });
  return groups;
}, []);

