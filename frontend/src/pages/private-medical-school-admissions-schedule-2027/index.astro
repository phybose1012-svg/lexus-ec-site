const createUniversityUpdate = (detail: string, date: string, dateTime: string) => {
  const [university, description = "入試日程を更新しました。"] = detail.split("は、", 2);
  const firstSentence = description.split("。")[0];

  return {
    date,
    dateTime,
    university,
    summary: `${firstSentence}。`,
  };
};
const universityUpdateHistory = [
  ...updateHistory[0].details.map((detail) =>
    createUniversityUpdate(detail, updateHistory[0].date, updateHistory[0].dateTime),
  ),
  ...updateHistory[1].details.slice(2).map((detail) =>
    createUniversityUpdate(detail, updateHistory[1].date, updateHistory[1].dateTime),
