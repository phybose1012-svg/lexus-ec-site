---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { seo } from "../../data/home";
import {
  alphabeticalWaitlistSchools, waitlistAdmissionYear, waitlistCheckedAt,
  waitlistFaqs, waitlistMetricLabels, waitlistSourceLabels,
} from "../../data/medicalWaitlist";

const canonical = "https://lexus-ec.com/kuriage-information/";
const datasetPath = "/data/medical-waitlist-2026.json";
const pageTitle = "【2026年度結果】私立医学部の補欠・繰上げ合格情報｜31大学｜医学部予備校レクサス";
const pageDescription = "私立医学部31大学の2026年度繰上げ・追加合格情報を一覧に。大学公式の人数・補欠順位と、富士学院・メルリックス学院の合格報告を区別し、対象日・出典付きで掲載。補欠の意味や連絡を待つ際の注意点も解説します。";
const formatDate = (date: string) => date.replace(/^(\d{4})-(\d{2})-(\d{2})$/, (_, year, month, day) => `${year}年${Number(month)}月${Number(day)}日`);
const evidenceUrls = [...new Set(alphabeticalWaitlistSchools.flatMap((school) => [
  ...school.records.map((row) => row.source.url), ...(school.noteSources ?? []).map((source) => source.url),
]))];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "CollectionPage", "@id": `${canonical}#webpage`, url: canonical, name: pageTitle,
      description: pageDescription, inLanguage: "ja", dateModified: waitlistCheckedAt,
      mainEntity: { "@id": `${canonical}#dataset` }, breadcrumb: { "@id": `${canonical}#breadcrumb` } },
    { "@type": "Dataset", "@id": `${canonical}#dataset`, name: "2026年度 私立医学部31大学の繰上げ・追加合格情報",
      description: "大学公式の人数・順位、および予備校が報告した個別の合格例。個別の合格例は最終到達順位ではない。掲載のない方式の結果は未確認であり、0人を意味しない。",
      url: `${canonical}#school-data`, inLanguage: "ja", temporalCoverage: "2026", dateModified: waitlistCheckedAt,
      creator: { "@type": "Organization", name: "レクサス教育センター", url: "https://lexus-ec.com/" },
      citation: evidenceUrls,
      distribution: { "@type": "DataDownload", contentUrl: `https://lexus-ec.com${datasetPath}`, encodingFormat: "application/json" },
      variableMeasured: ["繰上・追加合格者数", "繰上合格連絡者数", "入学許可者数", "補欠到達順位", "個別の合格報告", "情報の対象日", "出典区分"] },
    { "@type": "FAQPage", "@id": `${canonical}#definition`, inLanguage: "ja",
      mainEntity: waitlistFaqs.map((faq) => ({ "@type": "Question", name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer } })) },
    { "@type": "BreadcrumbList", "@id": `${canonical}#breadcrumb`, itemListElement: [
      { "@type": "ListItem", position: 1, name: "レクサス教育センター", item: "https://lexus-ec.com/" },
      { "@type": "ListItem", position: 2, name: "補欠・繰上げ合格情報", item: canonical },
    ] },
  ],
};
---

<SiteLayout title={pageTitle} description={pageDescription} canonical={canonical} ogImage={seo.ogImage} mainContentId="kuriage-main">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    <link rel="alternate" type="application/json" href={datasetPath} title="2026年度 私立医学部繰上げ合格データ" />
  </Fragment>
  <main id="kuriage-main" class="kuriage-page">
    <section class="kuriage-hero" aria-labelledby="kuriage-title">
      <div class="content kuriage-hero__inner">
        <img class="kuriage-hero__logo-strip" src="/assets/legacy/wp-content/uploads/2024/11/背景ロゴだらけメニュー透明3-1024x74.png" alt="" loading="eager" width="1024" height="74" />
        <p class="kuriage-hero__eyebrow">2026年度の結果 · 私立医学部31大学</p>
        <h1 id="kuriage-title">医学部の補欠・<br class="mobile-break" />繰上げ合格情報</h1>
        <p class="kuriage-hero__lead">何番まで繰り上がった？ 何人が追加合格した？<br />数字の意味と出典を分けて、志望校の結果を確認できます。</p>
        <p class="checked-date">最終更新：<time datetime={waitlistCheckedAt}>{formatDate(waitlistCheckedAt)}</time></p>
        <div class="year-notice">
          <strong>掲載しているのは2026年度の結果です。</strong>
          <p>2027年度の補欠・繰上げ合格状況は、各大学の入試後に判明します。過去の結果は、今年の合格を保証するものではありません。</p>
          <a href="/private-medical-school-admissions-schedule-2027/">2027年度の私立医学部入試日程を見る <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <nav class="kuriage-nav" aria-label="繰上げ合格情報の目次">
      <div class="content kuriage-nav__grid">
        <a href="#school-data"><span>01</span><strong>31大学の結果を見る</strong></a>
        <a href="#definition"><span>02</span><strong>補欠・繰上げのQ&A</strong></a>
        <a href="#contact"><span>03</span><strong>連絡を待つときの注意</strong></a>
      </div>
    </nav>

    <section id="school-data" class="kuriage-section results-section" aria-labelledby="results-title">
      <div class="content">
        <div class="waitlist-heading"><p class="kuriage-kicker">UNIVERSITY RESULTS</p><h2 id="results-title">2026年度 大学別の繰上げ合格情報</h2><p>一般選抜・共通テスト利用を中心に、確認できた結果を50音順で掲載しています。</p></div>
        <div class="reading-guide">
          <div><span class="evidence-badge evidence-badge--official">大学公式</span><p>大学が公表した人数・順位・終了案内です。</p></div>
          <div><span class="evidence-badge evidence-badge--prep">予備校情報</span><p>富士学院・メルリックス学院の報告です。大学の確定結果とは区別しています。</p></div>
          <p class="reading-guide__warning"><strong>「合格例：補欠○番」は、最終到達順位ではありません。</strong><br />その番号の合格が報告されたという意味です。掲載のない方式や「未確認」は、繰上げが0人だったことを意味しません。</p>
        </div>
        <details class="source-policy"><summary>掲載情報・出典について</summary><p>大学公式の年度結果・募集要項・お知らせを優先し、公式で確認できない情報は、医学部入試を継続的に扱う富士学院・メルリックス学院の公表情報から補っています。掲載する予備校情報はこの2校に限定し、匿名掲示板、個人ブログ・個人SNSは採用していません。日付は情報が示す時点であり、人数・順位は混ぜて比較できません。</p><p>各記録には出典を付けています。対象日が記載されていない年度結果は、2026年度資料として表示しています。</p></details>
        <nav class="kuriage-school-index" aria-label="大学名から結果へ移動">
          {alphabeticalWaitlistSchools.map((school) => <a href={`#${school.id}`}>{school.name}</a>)}
        </nav>
        <div class="result-grid">
          {alphabeticalWaitlistSchools.map((school, index) => (
            <article id={school.id} class="result-card" aria-labelledby={`${school.id}-title`}>
              <header class="result-card__header"><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><h3 id={`${school.id}-title`}>{school.name}</h3><span class="result-card__year">{waitlistAdmissionYear}年度</span></header>
              <dl class="result-list">
                {school.records.map((row) => (
                  <div class:list={["result-row", { "result-row--notice": row.metric === "notice" }]}>
                    <dt>{row.route}</dt>
                    <dd>
                      <div class="result-row__badges"><span class:list={["evidence-badge", `evidence-badge--${row.source.kind}`]}>{waitlistSourceLabels[row.source.kind]}</span><span class="metric-label">{waitlistMetricLabels[row.metric]}</span></div>
                      <p class="result-row__value">{row.result}</p>
                      <p class="result-row__date">{row.asOf ? <><time datetime={row.asOf}>{formatDate(row.asOf)}</time>の情報</> : <>2026年度資料（対象日の記載なし）</>}</p>
                      <a class="source-link" href={row.source.url} target="_blank" rel="noopener noreferrer">{row.source.title}<span class="sr-only">（新しいタブで開く）</span><span aria-hidden="true"> ↗</span></a>
                      {row.note && <p class="result-note">{row.note}</p>}
                    </dd>
                  </div>
                ))}
              </dl>
              {school.note && <div class="result-card__note"><p>{school.note}</p>{school.noteSources?.map((source) => <a class="source-link" href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<span class="sr-only">（新しいタブで開く）</span><span aria-hidden="true"> ↗</span></a>)}</div>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="definition" class="kuriage-section waitlist-faq-section" aria-labelledby="faq-title">
      <div class="content">
        <div class="waitlist-heading"><p class="kuriage-kicker">WAITLIST Q&A</p><h2 id="faq-title">補欠・繰上げ合格のQ&A</h2></div>
        <div class="waitlist-faq-list">
          {waitlistFaqs.map((faq, index) => <article id={index === 1 ? "count" : undefined}><h3><span aria-hidden="true">Q.</span>{faq.question}</h3><p>{faq.answer}</p>{index === 2 && <a class="source-link" href="https://www.fujita-hu.ac.jp/admission/q-and-a.html" target="_blank" rel="noopener noreferrer">藤田医科大学の公式Q&A<span class="sr-only">（新しいタブで開く）</span><span aria-hidden="true"> ↗</span></a>}</article>)}
        </div>
      </div>
    </section>

    <section id="contact" class="kuriage-section contact-section" aria-labelledby="contact-title">
      <div class="content">
        <div class="waitlist-heading"><p class="kuriage-kicker">BEFORE THE CALL</p><h2 id="contact-title">連絡を待つ間に、確認しておきたいこと</h2><p>連絡方法や返答期限は、大学ごとに違います。受験した年度の募集要項を手元に用意しましょう。</p></div>
        <ol class="contact-list">
          <li><h3>登録した電話番号とマイページを確認</h3><p>本人・保護者の連絡先が使える状態か確認してください。知らない番号からの着信も、大学からの連絡の可能性があります。発表・通知方法は大学の案内に従いましょう。</p></li>
          <li><h3>返答・入学手続きの期限を確認</h3><p>合格の連絡を受けたら、返答と入金・書類提出の期限を確認してください。「翌日まで待てる」とは限りません。入学意思や他大学の手続きも、家族で相談しておきましょう。</p></li>
          <li><h3>終了は大学のお知らせで確認</h3><p>3月末で終了する大学も、4月に動く可能性のある大学もあります。予備校の報告が止まったことだけで、繰上げ終了とは判断しないでください。</p></li>
        </ol>
        <div class="contact-evidence"><p>大学ごとの案内例</p><ul><li><a href="https://www.tohoku-mpu.ac.jp/admission/qa/" target="_blank" rel="noopener noreferrer">東北医科薬科大学：電話連絡の注意事項 ↗</a></li><li><a href="https://www.toho-u.ac.jp/info_exam/med_2026ippan.pdf" target="_blank" rel="noopener noreferrer">東邦大学：2026年度要項の返答期限（p.14） ↗</a></li><li><a href="https://www.fujita-hu.ac.jp/admission/q-and-a.html" target="_blank" rel="noopener noreferrer">藤田医科大学：4月の繰上げについて ↗</a></li></ul><p>年度が異なる要項を、そのまま2027年度のルールとして使わないでください。</p></div>
      </div>
    </section>
    <section class="kuriage-cta" aria-labelledby="kuriage-cta-title">
      <div class="content-narrow"><p class="kuriage-cta__eyebrow">NEXT STEP</p><h2 id="kuriage-cta-title">入試の不安は、ひとつずつ整理しましょう。</h2><p>繰上げを待つ間の判断や、これからの受験準備について、レクサス教育センターにご相談ください。</p><div class="kuriage-cta__actions"><a class="button button--red" href="/reservation/">個別相談</a><a class="button button--outline" href="/top/information-shiritsu/">私立医学部の大学別情報</a></div></div>
    </section>
  </main>
</SiteLayout>

<style>
  .kuriage-page { --kuriage-accent: var(--red); }
  .kuriage-hero__eyebrow, .kuriage-kicker, .kuriage-cta__eyebrow { color: var(--red); background: transparent; padding: 0; border-radius: 0; }
  .kuriage-hero h1 { font-size: clamp(2rem, 4.3vw, 3.6rem); line-height: 1.35; }
  .kuriage-hero__lead { font-weight: 500; }
  .mobile-break { display: none; }
  .checked-date { margin: 0; color: var(--muted); font-size: .85rem; }
  .year-notice { width: min(100%, 800px); box-sizing: border-box; border: 1px solid var(--line); border-left: 4px solid var(--red); background: #fffaf6; padding: 20px 24px; text-align: left; font-size: .95rem; line-height: 1.8; }
  .year-notice strong { color: var(--red); }
  .year-notice p { margin: 6px 0 12px; }
  .year-notice a { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .kuriage-nav { background: #fff; }
  .kuriage-nav a { box-shadow: none; }
  .waitlist-heading { margin-bottom: 26px; }
  .waitlist-heading h2 { margin: 12px 0; font-size: clamp(1.5rem, 3vw, 2.3rem); font-family: var(--font-serif); line-height: 1.5; }
  .waitlist-heading > p:last-child:not(.kuriage-kicker) { color: var(--muted); line-height: 1.85; }
  .reading-guide { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--line); background: #faf9f6; padding: 22px; gap: 16px 30px; }
  .reading-guide p { margin: 8px 0 0; font-size: .95rem; line-height: 1.85; }
  .reading-guide__warning { grid-column: 1 / -1; border-top: 1px solid var(--line); padding-top: 14px; }
  .reading-guide__warning strong { color: var(--red); }
  .evidence-badge { display: inline-block; border: 1px solid; border-radius: 3px; padding: 2px 7px; font-size: .72rem; font-weight: 700; line-height: 1.6; }
  .evidence-badge--official { color: #8f0808; border-color: #dfb7b7; background: #fff4f4; }
  .evidence-badge--prep { color: #535149; border-color: #cbc8bf; background: #f4f3ef; }
  .source-policy { margin-top: 16px; line-height: 1.85; font-size: .9rem; color: var(--muted); }
  .source-policy summary { cursor: pointer; width: fit-content; color: var(--ink); font-weight: 700; }
  .source-policy p { max-width: 960px; }
  .kuriage-school-index { margin: 32px 0; }
  .kuriage-school-index a { box-shadow: none; border-radius: 4px; }
  .result-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .result-card { min-width: 0; border: 1px solid var(--line); border-top: 3px solid var(--red); background: #fff; scroll-margin-top: 135px; }
  .result-card__header { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 12px; padding: 20px; border-bottom: 1px solid var(--line); }
  .result-card__header > span:first-child { color: var(--red); font-size: .8rem; font-weight: 700; }
  .result-card__header h3 { margin: 0; font-size: 1.3rem; line-height: 1.5; }
  .result-card__year { margin-left: auto; font-size: .78rem; color: var(--muted); white-space: nowrap; }
  .result-list { margin: 0; }
  .result-row { display: grid; grid-template-columns: minmax(95px, .8fr) minmax(0, 2fr); gap: 16px; padding: 20px; }
  .result-row + .result-row { border-top: 1px solid var(--line); }
  .result-row dt { font-size: .9rem; font-weight: 700; line-height: 1.8; }
  .result-row dd { margin: 0; min-width: 0; }
  .result-row__badges { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .metric-label { font-size: .72rem; color: var(--muted); }
  .result-row__value { margin: 8px 0; font-size: 1.05rem; font-weight: 700; line-height: 1.7; }
  .result-row__date { margin: 0 0 6px; color: var(--muted); font-size: .75rem; line-height: 1.8; }
  .source-link { display: inline; font-size: .77rem; color: #5d4e43; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; line-height: 1.9; }
  .result-row--notice { background: #fffaf6; }
  .result-card__note { padding: 16px 20px; background: #f8f7f4; border-top: 1px solid var(--line); }
  .result-card__note p, .result-note { margin: 0; font-size: .83rem; color: #625c55; line-height: 1.85; }
  .waitlist-faq-section { background: #faf9f6; }
  .waitlist-faq-list { display: grid; gap: 16px; max-width: 960px; }
  .waitlist-faq-list article { padding: 24px; border: 1px solid var(--line); background: #fff; scroll-margin-top: 130px; }
  .waitlist-faq-list h3 { margin: 0 0 12px; font-size: 1.15rem; line-height: 1.7; }
  .waitlist-faq-list h3 span { margin-right: 10px; color: var(--red); }
  .waitlist-faq-list p { margin: 0; line-height: 1.9; font-size: .97rem; }
  .contact-list { counter-reset: contact; list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; max-width: 960px; }
  .contact-list li { counter-increment: contact; border: 1px solid var(--line); padding: 22px 24px; }
  .contact-list h3 { margin: 0 0 10px; font-size: 1.15rem; line-height: 1.7; }
  .contact-list h3::before { content: "0" counter(contact); margin-right: 14px; color: var(--red); font-size: .9rem; }
  .contact-list p { margin: 0; line-height: 1.9; }
  .contact-evidence { font-size: .86rem; line-height: 1.9; margin-top: 24px; color: var(--muted); }
  .contact-evidence ul { padding-left: 20px; }
  .contact-evidence a { text-decoration: underline; text-underline-offset: 3px; }
  .kuriage-cta { background: #fffaf6; border-top: 1px solid var(--line); color: var(--ink); }
  .kuriage-cta p:not(.kuriage-cta__eyebrow) { color: var(--muted); font-weight: 500; }
  .kuriage-cta .button--outline { background: #fff; color: var(--red); border: 1px solid var(--red); }
  .sr-only { position: absolute; left: 0; top: 0; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 760px) {
    .reading-guide, .result-grid { grid-template-columns: minmax(0, 1fr); }
    .result-row { grid-template-columns: minmax(88px, .7fr) minmax(0, 1.7fr); gap: 12px; padding: 18px 16px; }
    .result-card__header { padding: 16px; }
    .result-card__header h3 { font-size: 1.2rem; }
    .result-card__note { padding: 14px 16px; }
    .year-notice { padding: 16px; }
    .waitlist-faq-list article, .contact-list li { padding: 20px; }
    .mobile-break { display: block; }
  }
  @media (max-width: 380px) { .result-row { grid-template-columns: minmax(0, 1fr); gap: 8px; } }
  @media print {
    .kuriage-nav, .kuriage-school-index, .kuriage-cta, .source-policy { display: none; }
    .result-grid { display: block; }
    .result-card { break-inside: avoid; margin-bottom: 16px; }
    .kuriage-section { padding: 24px 0; }
  }
</style>
