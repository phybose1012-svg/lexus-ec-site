---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { seo } from "../../data/home";
import {
  waitlistCheckedAt, waitlistFaqs,
} from "../../data/medicalWaitlist";
import { waitlistTableSchools } from "../../data/medicalWaitlistTables";
import { publicWaitlistInformation, publicWaitlistResult } from "../../data/medicalWaitlistPublic";
import { waitlistTableValue, waitlistEvidenceDate } from "../../data/medicalWaitlistPresentation";
import { waitlistFootnotes } from "../../data/medicalWaitlistFootnotes";

const canonical = "https://lexus-ec.com/kuriage-information/";
const datasetPath = "/data/medical-waitlist.json";
const pageTitle = "【2025・2026年度追加】私立医学部の補欠・繰上げ合格情報と過去一覧｜医学部予備校レクサス";
const pageDescription = "私立医学部の補欠・繰上げ合格情報。2024年度以前の過去一覧に、2025・2026年度の31大学の情報を追加。人数・補欠順位を大学別・年度別の表で掲載しています。";
const formatDate = (date: string) => date.replace(/^(\d{4})-(\d{2})-(\d{2})$/, (_, year, month, day) => `${year}年${Number(month)}月${Number(day)}日`);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "CollectionPage", "@id": `${canonical}#webpage`, url: canonical, name: pageTitle,
      description: pageDescription, inLanguage: "ja", dateModified: waitlistCheckedAt,
      mainEntity: { "@id": `${canonical}#dataset` }, breadcrumb: { "@id": `${canonical}#breadcrumb` } },
    { "@type": "Dataset", "@id": `${canonical}#dataset`, name: "私立医学部の繰上げ・追加合格情報：2025・2026年度と過去一覧",
      description: "表は数値を中心に掲載し、数値の意味と情報の種類は各大学の注記に記載。同じ意味の数値は年度をまたいで説明。大学公式情報・大学発表や大学への確認に基づく間接情報・受験生の合格報告を区別し、確認できない出典は未確認と明記。個別の合格報告は最終到達順位とは限らず、未確認や「-」は0人を意味しない。",
      url: `${canonical}#school-data`, inLanguage: "ja", temporalCoverage: "2012/2026", dateModified: waitlistCheckedAt,
      creator: { "@type": "Organization", name: "レクサス教育センター", url: "https://lexus-ec.com/" },
      distribution: { "@type": "DataDownload", contentUrl: `https://lexus-ec.com${datasetPath}`, encodingFormat: "application/json" },
      variableMeasured: ["繰上・追加合格者数", "繰上合格連絡者数", "入学許可者数", "補欠到達順位", "個別の合格報告", "情報の対象日"] },
    { "@type": "FAQPage", "@id": `${canonical}#definition`, inLanguage: "ja",
      mainEntity: waitlistFaqs.map((faq) => ({ "@type": "Question", name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer } })) },
    { "@type": "BreadcrumbList", "@id": `${canonical}#breadcrumb`, itemListElement: [
      { "@type": "ListItem", position: 1, name: "レクサス教育センター", item: "https://lexus-ec.com/" },
      { "@type": "ListItem", position: 2, name: "補欠・繰上げ合格情報", item: canonical },
    ] },
  ],
};
---

<SiteLayout title={pageTitle} description={pageDescription} canonical={canonical} ogImage={seo.ogImage} mainContentId="kuriage-main">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    <link rel="alternate" type="application/json" href={datasetPath} title="私立医学部繰上げ合格データ：2025・2026年度と過去一覧" />
  </Fragment>
  <main id="kuriage-main" class="kuriage-page">
    <section class="kuriage-hero" aria-labelledby="kuriage-title">
      <div class="content kuriage-hero__inner">
        <img class="kuriage-hero__logo-strip" src="/assets/legacy/wp-content/uploads/2024/11/背景ロゴだらけメニュー透明3-1024x74.png" alt="" loading="eager" width="1024" height="74" />
        <p class="kuriage-hero__eyebrow">WAITLIST Q&A</p>
        <h1 id="kuriage-title">医学部 繰上げ合格のQ&A</h1>
        <p class="kuriage-hero__lead">正規合格、補欠、繰上げ合格の違いから、大学別の繰上げデータまで。2025・2026年度の情報を、これまでの年度と一緒に表で確認できます。</p>
        <p class="checked-date">情報の最終確認：<time datetime={waitlistCheckedAt}>{formatDate(waitlistCheckedAt)}</time></p>
        <div class="kuriage-hero__actions">
          <a class="button button--red" href="/request-documents/">資料請求</a>
          <a class="button button--blue" href="/reservation/">個別相談</a>
        </div>
      </div>
    </section>

    <nav class="kuriage-nav" aria-label="繰上げ合格Q&Aの目次">
      <div class="content kuriage-nav__grid">
        <a href="#definition"><span>QUESTION 01</span><strong>正規・補欠・繰上げ</strong></a>
        <a href="#count"><span>QUESTION 02</span><strong>どのくらい繰り上がるか</strong></a>
        <a href="#school-data"><span>QUESTION 03</span><strong>大学別データ</strong></a>
      </div>
    </nav>

    <section id="definition" class="kuriage-section kuriage-section--definition">
      <div class="content">
        <div class="kuriage-question">
          <span class="kuriage-question__mark">Q</span>
          <div><p class="kuriage-kicker">QUESTION 01</p><h2>{waitlistFaqs[0].question}</h2></div>
        </div>
        <div class="kuriage-answer">
          <p>繰上げ合格も正式な合格です。入学後の扱いが別になるものではありません。</p>
          <p>{waitlistFaqs[0].answer}</p>
        </div>
        <div class="kuriage-definition-grid" aria-label="合格区分の整理">
          <article><span>01</span><h3>正規合格者</h3><p>最初の合格発表で合格と判定された受験者。二次試験合格者と同義で使われることがあります。</p></article>
          <article><span>02</span><h3>補欠者</h3><p>欠員が生じたとき、繰上げ合格の対象になり得る受験者。大学によって番号・ランク・群の出し方が異なります。</p></article>
          <article><span>03</span><h3>繰上げ合格者</h3><p>正規合格者の辞退などにより、後から合格となった受験者。補欠合格者・追加合格者と呼ばれることもあります。</p></article>
        </div>
        <div class="kuriage-caution-grid">
          <p><strong class="waitlist-qa-title">{waitlistFaqs[2].question}</strong>{waitlistFaqs[2].answer}</p>
          <p><strong class="waitlist-qa-title">{waitlistFaqs[3].question}</strong>{waitlistFaqs[3].answer}</p>
        </div>
      </div>
    </section>

    <section id="count" class="kuriage-section kuriage-section--count">
      <div class="content">
        <div class="kuriage-question">
          <span class="kuriage-question__mark">Q</span>
          <div><p class="kuriage-kicker">QUESTION 02</p><h2>{waitlistFaqs[1].question}</h2></div>
        </div>
        <div class="kuriage-answer"><p>{waitlistFaqs[1].answer}</p></div>
        <div class="kuriage-example" aria-label="繰上げ合格者数の見方">
          <div><p class="kuriage-example__label">計算例</p><strong>繰上げ合格の連絡70人 − 入学辞退20人 ＝ 掲載人数50人</strong></div>
          <p>入学辞退者を含まない人数が公表されている場合の例です。この場合、実際に合格の連絡を受けたのは70人で、掲載される50人より多くなります。</p>
        </div>
      </div>
    </section>

    <section id="school-data" class="kuriage-section kuriage-section--data" aria-labelledby="results-title">
      <div class="content">
        <div class="kuriage-question">
          <span class="kuriage-question__mark">Q</span>
          <div><p class="kuriage-kicker">QUESTION 03</p><h2 id="results-title">だいたい補欠何番まで回ってくるの？</h2></div>
        </div>
        <div class="kuriage-answer">
          <p>2025・2026年度を、各大学の表の先頭に追加しています。2024年度以前の数値は従来の表記のまま掲載しています。</p>
          <p>各表の下に、数値の意味と情報の種類を記載しています。受験生からの合格報告は最終結果とは限りません。「—」「-」は未確認で、0人ではありません。</p>
          <p>2027年度の補欠・繰上げ合格状況は、各大学の入試後に判明します。<a href="/private-medical-school-admissions-schedule-2027/">2027年度の入試日程を見る →</a></p>
        </div>
        <div class="kuriage-school-index" aria-label="大学別データの一覧">
          {waitlistTableSchools.map((school) => <a href={"#" + school.id}>{school.name}</a>)}
        </div>
        <div class="kuriage-school-grid">
          {waitlistTableSchools.map((school) => (
            <article id={school.id} class:list={["kuriage-school-card", "kuriage-school-card--tone-" + school.tone, { "kuriage-school-card--wide": school.columns.length >= 4 }]} aria-labelledby={school.id + "-title"}>
              <header class="kuriage-school-card__header">
                <p class="kuriage-school-card__eyebrow">{String(school.number).padStart(2, "0")}</p>
                <h3 id={school.id + "-title"}>{school.name}</h3>
              </header>
              <div class="kuriage-table-wrap" tabindex="0" role="region" aria-label={school.name + "の年度別繰上げ合格情報"}>
                <table class="kuriage-data-table" aria-describedby={school.id + "-notes"}>
                  <caption>{school.name}の繰上げ合格情報</caption>
                  <thead><tr><th scope="col">年度</th>{school.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
                  <tbody>
                    {school.rows.map((row) => (
                      <tr data-year={row.year} data-legacy={row.legacy ? "true" : "false"} style={"--waitlist-column-count:" + school.columns.length}>
                        <th scope="row">{row.year}</th>
                        {row.cells.map((cell, columnIndex) => (
                          <td data-label={school.columns[columnIndex]}>
                            {cell.legacyValue !== undefined ? cell.legacyValue : cell.records.length > 0 ? waitlistTableValue(cell.records[0]) : <span class="waitlist-empty" title="数値未確認。0人ではありません。">—</span>}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <ul id={school.id + "-notes"} class="kuriage-school-card__notes">
                {waitlistFootnotes(school).map((note) => (
                  <li><strong>{note.label}：</strong>{note.text}</li>
                ))}
                {school.annotations.flatMap(({ year, records }) => records.map((record) => (
                  <li><strong>補足：</strong>{year}年度・{record.route}：{publicWaitlistResult(record)}{record.asOf && <>（<time datetime={record.asOf}>{waitlistEvidenceDate(record)}</time>時点）</>}。{publicWaitlistInformation(record)}。</li>
                )))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="kuriage-cta" aria-labelledby="kuriage-cta-title">
      <div class="content-narrow">
        <p class="kuriage-cta__eyebrow">NEXT STEP</p>
        <h2 id="kuriage-cta-title">繰上げを待つだけでなく、次の判断を早くする。</h2>
        <p>補欠番号や繰上げ状況は、志望順位、入学手続き、次年度への準備に直結します。数字だけで迷わず、現在地と選択肢を整理しましょう。</p>
        <div class="kuriage-cta__actions">
          <a class="button button--red" href="/request-documents/">資料請求</a>
          <a class="button button--blue" href="/reservation/">個別相談</a>
          <a class="button button--green" href="/top/information-shiritsu/">大学別情報</a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  /* Preserve the original page/card/table design and compact, non-linked values. */
  .checked-date { margin: 0; color: var(--muted); font-size: .85rem; }
  .waitlist-qa-title { display: block; margin-bottom: 8px; color: var(--ink); }
  .kuriage-school-card { min-width: 0; }
  .kuriage-data-table tbody td { font-variant-numeric: tabular-nums; }
  .waitlist-empty { color: var(--muted); }
  @media (max-width: 680px) {
    .kuriage-data-table tbody td { align-items: baseline; overflow-wrap: anywhere; }
    .kuriage-data-table tbody th { grid-row: 1 / span var(--waitlist-column-count); }
  }
</style>
