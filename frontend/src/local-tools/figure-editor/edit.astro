---
import AdminLayout from "../../layouts/AdminLayout.astro";
import FigureEditorIsland from "./FigureEditorIsland.tsx";

// このページは astro.config.mjs が「vendor/figure-editor/ が置いてあるときだけ」
// 経路へ差し込む。だから src/pages/ の下ではなくここに居る。置いていない環境
// （Cloudflare Pages のクリーンな clone）ではビルドの視界に入らない。
//
// 経路に入っていても本番ドメインには出さない（/admin/editor と同じ扱い）。
if ((import.meta.env.CF_PAGES_BRANCH || "") === "main") {
  return Astro.redirect("/", 302);
}

// 図の指定はクエリで受ける。静的出力なのでページ自体は 1 枚だけ作り、
// どの図を開くかはブラウザ側（アイランド）が読む。
---

<AdminLayout title="図版を直す | LEXUS E.C. Admin" active="editor">
  <section class="admin-page-head">
    <div>
      <p class="admin-eyebrow">Past exam figure editor</p>
      <h1>図版を直す</h1>
      <p>
        過去問ページの図をその場で直します。保存すると SVG・manifest の寸法・
        再編集用の控えがまとめて書き換わり、その図は生成スクリプトの上書きから
        外れます。手元（127.0.0.1）では <code>npm run admin:api</code> が
        作業ツリーへ直接書き、ステージングでは GitHub の
        <code>staging</code> へ 1 コミットとして送ります（反映はビルドのあと）。
      </p>
    </div>
  </section>

  <div class="figure-editor-page">
    {/* client:only で載せる。手で createRoot すると、Astro が入れる React の
        前置き（Fast Refresh）が無いまま動いて `$RefreshSig$ is not defined`
        で止まる（実測）。どの図を開くかは島が自分でクエリから読む。 */}
    <FigureEditorIsland client:only="react" />
  </div>

  <style is:global>
    .figure-editor-page {
      /* エディタは高さいっぱいに広がる作り。画面の残りを全部渡す。 */
      height: calc(100vh - 12rem);
      min-height: 32rem;
      border: 1px solid #d4d4d4;
      border-radius: 0.75rem;
      overflow: hidden;
      background: #ffffff;
    }

    .figure-editor-island {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .figure-editor-island__bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid #e5e5e5;
      background: #fafafa;
      font-size: 0.8125rem;
      color: #525252;
    }

    .figure-editor-island__editor {
      flex: 1 1 auto;
      min-height: 0;
    }

    .figure-editor-island__notice {
      padding: 1.5rem;
      color: #525252;
    }

    .figure-editor-island__forget {
      padding: 0.125rem 0.625rem;
      border: 1px solid #d4d4d4;
      border-radius: 0.25rem;
      background: transparent;
      font: inherit;
      color: #737373;
      cursor: pointer;
    }

    .figure-editor-island__token {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }

    .figure-editor-island__token label {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }

    .figure-editor-island__token input {
      width: 12rem;
      padding: 0.125rem 0.375rem;
      border: 1px solid #d4d4d4;
      border-radius: 0.25rem;
      font: inherit;
    }

    .figure-editor-island__token button {
      padding: 0.125rem 0.625rem;
      border: 1px solid #c8d3df;
      border-radius: 0.25rem;
      background: #f5f8fb;
      font: inherit;
      cursor: pointer;
    }

    .figure-editor-island__warnings {
      border-top: 1px solid #e5e5e5;
      padding: 0.5rem 0.75rem;
      font-size: 0.8125rem;
      max-height: 8rem;
      overflow-y: auto;
    }
  </style>
</AdminLayout>
