---
interface Props {
  current: "general" | "special" | "venues" | "planner";
}

const { current } = Astro.props;

const schedulePages = [
  {
    id: "general",
    href: "/private-medical-school-admissions-schedule-2027/",
    label: ["一般・共通テスト", "利用の日程"],
  },
  {
    id: "special",
    href: "/private-medical-school-special-admissions-schedule-2027/",
    label: ["総合型・学校推薦", "などの日程"],
  },
  {
    id: "planner",
    href: "/private-medical-school-admission-planner-2027/",
    label: ["受験校・", "日程を組む"],
  },
  {
    id: "venues",
    href: "/private-medical-school-exam-venues-hotels-2027/",
    label: ["試験会場・", "周辺ホテル"],
  },
] as const;
---

<nav class="admissions-page-switcher" aria-label="2027年度 私立医学部の入試情報を切り替える">
  <p class="admissions-page-switcher__label">
    2027年度 入試情報
  </p>
  <div class="admissions-page-switcher__options">
    {
      schedulePages.map((page) => {
        const isCurrent = current === page.id;
        return (
          <a
            class:list={[
              "admissions-page-switcher__option",
              `admissions-page-switcher__option--${page.id}`,
              { "is-current": isCurrent },
            ]}
            href={page.href}
            aria-current={isCurrent ? "page" : undefined}
          >
            <strong>{page.label.map((part) => <span>{part}</span>)}</strong>
            <span class="admissions-page-switcher__indicator" aria-hidden="true">
              {isCurrent ? "✓" : "→"}
            </span>
          </a>
        );
      })
    }
  </div>
</nav>
