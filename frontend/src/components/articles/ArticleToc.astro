---
export interface ArticleTocItem {
  id: string;
  text: string;
  level?: 2 | 3;
}

interface Props {
  items?: ArticleTocItem[];
  alignEntries?: boolean;
}

const { items = [], alignEntries = false } = Astro.props;
const visibleItems = items.filter((item) => item.id && item.text);
---

{visibleItems.length > 0 && (
  <nav class:list={["article-toc", alignEntries && "article-toc--aligned"]} aria-label="記事の目次">
    <p class="article-toc__title">目次</p>
    <ol>
      {visibleItems.map((item) => (
        <li class:list={[item.level === 3 && "article-toc__item--child"]}>
          <a href={`#${item.id}`}>{item.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  for (const toc of document.querySelectorAll<HTMLElement>(".article-toc--aligned")) {
    const entries = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')).flatMap((link) => {
      const id = decodeURIComponent(link.hash.slice(1));
      const heading = document.getElementById(id);
      return heading ? [{ heading, link }] : [];
    });
    if (!entries.length) continue;

    let active: HTMLAnchorElement | null = null;
    let frame = 0;

    const select = (link: HTMLAnchorElement) => {
      if (active === link) return;
      toc.querySelector('[aria-current="location"]')?.removeAttribute("aria-current");
      link.setAttribute("aria-current", "location");
      active = link;
    };

    const selectFromHash = () => {
      const entry = entries.find(({ link }) => link.hash === window.location.hash);
      if (entry) select(entry.link);
      return Boolean(entry);
    };

    const selectFromScroll = () => {
      frame = 0;
      const topPadding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      let current = entries[0];
      for (const entry of entries) {
        const margin = parseFloat(getComputedStyle(entry.heading).scrollMarginTop) || 0;
        if (entry.heading.getBoundingClientRect().top <= topPadding + margin + 4) current = entry;
        else break;
      }
      select(current.link);
    };

    for (const { link } of entries) link.addEventListener("click", () => select(link));
    window.addEventListener("hashchange", () => { if (!selectFromHash()) selectFromScroll(); });
    window.addEventListener("scroll", () => {
      if (!frame) frame = requestAnimationFrame(selectFromScroll);
    }, { passive: true });
    if (!selectFromHash()) selectFromScroll();
  }
</script>

<style>
  :global(html:has(.article-toc--aligned)) {
    scroll-padding-top: 78px;
  }

  @media (max-width: 960px) {
    :global(html:has(.article-toc--aligned)) {
      scroll-padding-top: calc(var(--mobile-header-actions-height, 86px) + var(--mobile-header-top-inset, 0px) + 14px);
    }
  }

  :global(.article-page:has(.article-toc--aligned) .article-content :is(h2, h3)[id]:target) {
    outline: 2px solid #a96945;
    outline-offset: 2px;
    border-radius: 4px;
    background-color: #f7eedf;
  }

  .article-toc--aligned li {
    display: grid;
    grid-template-columns: 1.3rem minmax(0, 1fr);
    column-gap: 8px;
    align-items: baseline;
    padding-left: 0;
  }

  .article-toc--aligned li::before {
    margin-right: 0;
    font-variant-numeric: tabular-nums;
  }

  .article-toc--aligned .article-toc__item--child a {
    display: grid;
    grid-template-columns: 0.45rem minmax(0, 1fr);
    column-gap: 0.4rem;
    align-items: start;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .article-toc--aligned .article-toc__item--child a::before {
    content: "";
    height: 0.42rem;
    margin-block-start: 0.28rem;
    border-inline-start: 1px solid var(--muted);
    border-block-end: 1px solid var(--muted);
  }

  :global(.article-page--interview-prep-guide) .article-toc--aligned li.article-toc__item--child {
    counter-increment: none;
  }

  :global(.article-page--interview-prep-guide) .article-toc--aligned li.article-toc__item--child::before {
    content: "";
  }

  @media (max-width: 680px) {
    :global(.article-page--interview-prep-guide) .article-toc--aligned .article-toc__item--child a {
      font-size: 0.78125rem;
    }
  }

  .article-toc--aligned a[aria-current="location"] {
    border-radius: 4px;
    background: #f7eedf;
    box-shadow: inset 0 -2px #8b351f;
    color: #752412;
    font-weight: 800;
  }
</style>
