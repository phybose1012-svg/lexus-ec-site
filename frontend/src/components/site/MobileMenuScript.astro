<script is:inline>
  (() => {
    const toggle = document.querySelector("[data-mobile-menu-toggle]");
    const panel = document.getElementById("mobile-menu-panel");
    if (!toggle || !panel) return;

    const viewport = window.visualViewport;
    const mobile = window.matchMedia("(max-width: 960px)");
    const root = document.documentElement;
    let frame = 0;
    const setOpen = (open) => {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      root.classList.toggle("mobile-menu-open", open);
      if (open) updateHeight();
    };

    // The toolbar can sit below branding, stick to the top, or scroll with the page.
    function updateHeight() {
      if (panel.hidden) return;
      if (!toggle.getClientRects().length) {
        setOpen(false);
        return;
      }
      const viewportBottom = viewport ? viewport.offsetTop + viewport.height : window.innerHeight;
      const availableHeight = Math.max(0, viewportBottom - panel.getBoundingClientRect().top);
      panel.style.setProperty("--mobile-menu-available-height", `${availableHeight}px`);
    }

    function scheduleViewportUpdate() {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        // The bar follows the visible viewport at normal zoom. A pinch zoom
        // can pan independently and should not pull the bar over the content.
        const top = mobile.matches && viewport && Math.abs(viewport.scale - 1) < 0.01
          ? Math.max(0, viewport.offsetTop)
          : 0;
        const inset = `${top}px`;
        if (root.style.getPropertyValue("--mobile-viewport-offset-top") !== inset) {
          root.style.setProperty("--mobile-viewport-offset-top", inset);
        }
        updateHeight();
      });
    }

    toggle.addEventListener("click", () => setOpen(panel.hidden));
    panel.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) setOpen(false);
    });
    window.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || panel.hidden) return;
      const focusWasInMenu = panel.contains(document.activeElement);
      setOpen(false);
      if (focusWasInMenu) toggle.focus({ preventScroll: true });
    });
    window.addEventListener("resize", scheduleViewportUpdate);
    window.addEventListener("scroll", () => {
      if (!panel.hidden) scheduleViewportUpdate();
    }, { passive: true });
    window.addEventListener("pageshow", scheduleViewportUpdate);
    viewport?.addEventListener("resize", scheduleViewportUpdate);
    viewport?.addEventListener("scroll", scheduleViewportUpdate);
    scheduleViewportUpdate();
  })();
</script>
