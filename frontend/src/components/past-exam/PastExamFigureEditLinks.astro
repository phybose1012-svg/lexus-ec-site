---
/**
 * 図版に「直す」を出す（開発中だけ）。
 *
 * 押すと `/admin/figures/edit` が開き、その図が FIBONA に読み込まれる。
 *
 * **本番には 1 バイトも出さない。** 判定は astro.config.mjs の 1 箇所。
 *  - main のビルドでは、このコンポーネントも行き先の経路も作られない。
 *  - 配布物 vendor/figure-editor/ が無いときも同じ（押した先が 404 になる
 *    組み合わせを作らない）。
 *
 * ステージングでは出す。あちらでも直せるようにしたので（書き戻しは
 * functions/admin/api/past-exam-figures.ts が GitHub へコミットする）、
 * 実行時にホスト名で隠す必要はなくなった。
 *
 * 見た目は script が要素へ直に付ける。`<style>` をこの条件分岐の中に置くと
 * Astro の巻き上げに乗らず、`<style is:global>` という不正な属性のまま HTML へ
 * 出てしまう（staging のビルドで実測）。
 */
interface Props {
  /** 図版パッケージ ID（manifest の packageId）。 */
  packageId: string;
}

const { packageId } = Astro.props;
// astro.config.mjs が配る値。行き先の経路を差し込むかどうかと同じ判定なので、
// 「ボタンはあるのに 404」という組み合わせにならない。
const show = import.meta.env.LEXUS_FIGURE_EDITOR === true;
---

{show && (
  <script is:inline define:vars={{ packageId }}>
    {
      const style = [
        "display:block",
        "width:fit-content",
        "margin:6px auto 0",
        "padding:2px 10px",
        "border:1px solid #c8d3df",
        "border-radius:999px",
        "background:#f5f8fb",
        "color:#52657b",
        "font-size:0.8125rem",
        "line-height:1.8",
        "text-decoration:none",
      ].join(";");
      for (const figure of document.querySelectorAll("figure.past-exam-figure[data-figure-id]")) {
        const figureId = figure.dataset.figureId;
        if (!/^[a-z0-9-]+$/.test(figureId ?? "")) continue;
        const link = document.createElement("a");
        link.className = "past-exam-figure__edit";
        link.setAttribute("style", style);
        link.href = `/admin/figures/edit?package=${encodeURIComponent(packageId)}&figure=${encodeURIComponent(figureId)}`;
        link.textContent = "✏️ 直す";
        link.title = `${figureId} を図形エディタで開く`;
        figure.appendChild(link);
      }
      // 印刷には出さない。要素ごと消えるので、印刷用の規則は要らない。
      window.addEventListener("beforeprint", () => {
        for (const link of document.querySelectorAll(".past-exam-figure__edit")) {
          link.style.display = "none";
        }
      });
      window.addEventListener("afterprint", () => {
        for (const link of document.querySelectorAll(".past-exam-figure__edit")) {
          link.style.display = "block";
        }
      });
    }
  </script>
)}
