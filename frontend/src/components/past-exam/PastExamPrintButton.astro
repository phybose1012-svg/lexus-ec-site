---
type Props = {
  label: string;
  printTitle: string;
};

const { label, printTitle } = Astro.props;
---

<button
  type="button"
  class="past-exam-print-button"
  data-past-exam-print
  data-print-title={printTitle}
>
  <span aria-hidden="true">⎙</span>
  {label}
</button>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-past-exam-print]");
    if (!(button instanceof HTMLButtonElement)) return;

    let titleBeforePrint = null;

    const clearPrintState = () => {
      document.body.classList.remove("is-printing-past-exam-document");
      if (titleBeforePrint !== null) {
        document.title = titleBeforePrint;
        titleBeforePrint = null;
      }
    };

    button.addEventListener("click", () => {
      clearPrintState();
      document.body.classList.add("is-printing-past-exam-document");
      titleBeforePrint = document.title;
      document.title = button.dataset.printTitle || document.title;
      window.print();
    });

    window.addEventListener("afterprint", clearPrintState);
  })();
</script>
