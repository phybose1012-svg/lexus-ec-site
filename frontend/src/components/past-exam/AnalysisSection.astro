---
import PastExamBrandDivider from "./PastExamBrandDivider.astro";

interface Props {
  id?: string;
  headingId: string;
  number: string;
  title: string;
  tone?: "white" | "muted";
  character?: "none" | "lexus" | "oni";
}

const { id, headingId, number, title, tone = "white", character = "none" } = Astro.props;
---

<section class:list={["analysis-section", { "analysis-section--muted": tone === "muted" }]} id={id} aria-labelledby={headingId}>
  <div class="content">
    <PastExamBrandDivider character={character} />
    <div class="analysis-section-heading"><span>{number}</span><h2 id={headingId}>{title}</h2></div>
    <slot />
  </div>
</section>
