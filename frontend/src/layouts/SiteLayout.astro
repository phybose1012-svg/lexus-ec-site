---
import BaseLayout from "./BaseLayout.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import "../styles/pages.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  mainContentId?: string;
}

const { title, description, canonical, ogImage, ogImageAlt, noindex, mainContentId } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} ogImageAlt={ogImageAlt} noindex={noindex} mainContentId={mainContentId}>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <SiteHeader />
  <slot />
  <SiteFooter />
</BaseLayout>
