          ],
          "status": "confirmed"
        },
        {
          "label": "受験票印刷",
          "value": "2026年11月24日（火）9:00から。各自で印刷し持参。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "試験日・受付",
          "value": "2026年11月28日（土）。受付8:30～8:45。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "合格発表",
          "value": "2026年12月10日（木）18時ごろ。Post@net。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "入学手続期間",
          "value": "2026年12月11日（金）～12月22日（火）。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        }
      ],
      "examRows": [
        {
          "label": "出願資格・推薦",
          "value": "日本国内の高校または中等教育学校後期課程を2026年3月に卒業、または2027年3月卒業見込み。 学校長の推薦を受け、人物・学力・医師としての適性等を備えること。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "評定・出席条件",
          "value": "全体3.7以上、かつ数学・理科・外国語の各教科も3.7以上（理数科は理数・外国語）。卒業者は全学年、卒業見込みは第3学年第1学期まで。在学中の出席状況が良好であること。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "高校での履修条件",
          "value": "数学Ⅰ・Ⅱ・Ⅲ・A・B・C、物理基礎・物理／化学基礎・化学／生物基礎・生物のうち2科目以上、英語コミュニケーションⅠ・Ⅱ・Ⅲを履修または履修見込み。理数科は要項指定の対応科目による。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "専願・併願制限",
          "value": "合格時に本人・保護者が入学を確約する専願。愛知県地域特別枠A方式とは併願不可。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "提出書類",
          "value": "入学志願書、学校長の推薦書（厳封）、調査書（2026年4月以降発行、厳封）、誓約書。指定書式と自署等を確認する。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "小論文",
          "value": "9:00～10:00、60分、5段階評価。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "数学",
          "value": "数学Ⅰ・Ⅱ・A、数学B（数列）、数学C（ベクトル・平面上の曲線と複素数平面）。数学Ⅲは試験範囲に含まない。 10:30～11:30、60分、100点、記述式。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "外国語",
          "value": "英語コミュニケーションⅠ・Ⅱ・Ⅲ、論理・表現Ⅰ・Ⅱ・Ⅲ。 11:40～12:40、60分、100点、記述式。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "面接",
          "value": "13:30～。個人面接、5段階評価。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "合否判定",
          "value": "推薦書・調査書、基礎学力試験、小論文、面接を総合評価。得点・評価が著しく低い科目等がある場合は不合格となることがある。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "面接所要時間",
          "value": "個人ごとの面接時間・人数・配点への数値換算は確認した要項に未公表。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "unpublished"
        }
      ],
      "venueRows": [
        {
          "label": "試験会場",
          "value": "愛知医科大学1号館（大学本館）。",
          "sourceIds": [
            "guidelines-2027"
          ],
          "status": "confirmed"
        }
      ],
      "notes": [
        {
          "text": "誓約書は本人自署欄と保護者氏名・押印欄がある。提出時の記入方法は正式要項・書式に従う。",
          "sourceIds": [
            "pledge-form"
          ]
        },
        {
          "text": "推薦書には勉学態度、特別活動・課外活動、人物の特徴、医学への志向性等を記入する。",
          "sourceIds": [
            "recommendation-form"
          ]
        },
        {
          "text": "履修条件には数学Ⅲが含まれるが、この選抜の数学試験には数学Ⅲを含まない。",
          "sourceIds": [
            "guidelines-2027"
          ]
        }
      ]
    },
