      "examRows": [
        {
          "label": "指定校枠・資格",
          "value": "大学指定の高校等の2026年3月卒業者または2027年3月卒業見込み。全体・数学・理科・外国語の学習成績が各3.8以上で学校長推薦、合格時入学確約。1校4名まで推薦。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "一般公募枠・資格",
          "value": "高校等の2026年3月卒業者または2027年3月卒業見込み。全体・数学・理科・外国語の学習成績が各4.0以上で学校長推薦、合格時入学確約。1校2名まで推薦。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "埼玉県地域枠・現要項の参考条件",
          "value": "出願資格のまとめには、指定校以外は学習成績4.0以上・1校2名以内、指定校は3.8以上・1校4名以内と記載。ただし募集人員・資格などの確定詳細は認可後の別募集要項を確認。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "埼玉県地域枠・確定詳細",
          "value": "出願資格などの確定詳細は未公表。臨時定員増の認可後、大学受験生サイトの別募集要項で案内。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "unpublished"
        },
        {
          "label": "特別枠・資格",
          "value": "高校等の2026年3月卒業者または2027年3月卒業見込みで学校長推薦、合格時入学確約。指定の英語資格検定・科学オリンピック等の好成績または同等の入賞実績が必要。推薦人数制限なし。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "適性検査Ⅰ・数学",
          "value": "数学Ⅰ・Ⅱ、数学A、数学B（数列）、数学C（ベクトル）。9:00～9:30、20点。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "適性検査Ⅰ・理科",
          "value": "物理・化学・生物の3領域から試験当日に2領域選択。9:50～10:50、40点（20点×2）。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "適性検査Ⅰ・英語",
          "value": "英語コミュニケーションⅠ～Ⅲ、論理・表現Ⅰ～Ⅲ。11:10～11:40、20点。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "適性検査Ⅱ・小論文",
          "value": "和文。12:00～12:30、20点。適性検査は全科目記述式、計100点。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "面接",
          "value": "面接票記入12:40～13:00（判定に使用しない）。面接は14:00～17:00頃、段階評価。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        },
        {
          "label": "判定",
          "value": "適性検査・面接・調査書を多面的・総合的に判定。定員未充足は地域枠以外の推薦枠、なお不足なら一般前期で募集。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        }
      ],
      "venueRows": [
        {
          "label": "試験会場",
          "value": "埼玉医科大学 毛呂山キャンパス カタロスタワー。",
          "sourceIds": [
            "guide-2027"
          ],
          "status": "confirmed"
        }
      ],
      "notes": [
        {
          "text": "埼玉県地域枠19名は文部科学省への臨時定員増申請予定数です。認可・詳細が確定するまで、出願資格や選考内容を前年情報で補わないでください。",
          "sourceIds": [
            "guide-2027"
          ]
        },
        {
          "text": "指定校枠への出願者は一般公募枠にも出願したものとみなし、枠ごとに受験番号が付されます。",
          "sourceIds": [
            "guide-2027"
          ]
        },
        {
          "text": "特別枠の英語資格・科学オリンピック等の個別基準は公式要項23ページ（PDF27ページ）を確認してください。",
          "sourceIds": [
            "guide-2027"
          ]
        }
      ]
    },
