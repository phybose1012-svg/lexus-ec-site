              {
                "label": "(1)",
                "value": "ア \\(\\sqrt{5gr}\\)／イ \\(2r\\)／ウ \\(6\\)／エ \\(3\\)／オ \\(\\frac{2}{3}R\\)"
              },
              {
                "label": "(2)",
                "value": "カ \\(8\\)／キ \\(\\sqrt{\\frac{GM}{R}}\\)"
