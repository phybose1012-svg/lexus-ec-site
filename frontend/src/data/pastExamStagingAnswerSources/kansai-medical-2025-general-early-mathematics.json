            "major_question_id": "major-question-02"
          },
          {
            "type": "heading",
            "level": 3,
            "text": "(3)",
            "major_question_id": "major-question-02"
          },
          {
            "type": "formula",
            "latex": "S=m+(m+1)+\\cdots+n",
