    "pageUnit": "major_question",
    "sharedInstructionsHtml": "<section class=\"source-page-card question-shared-instructions\" data-question-shared-instructions><div class=\"page-kicker\">全大問共通</div><h2>数学</h2><p class=\"prose\">（60分）</p><p class=\"prose\">※解答に際しての注意事項：答えまでの過程を記すこと。</p></section>",
