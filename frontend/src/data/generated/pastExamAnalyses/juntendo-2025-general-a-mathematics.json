        {
          "id": "math-q2-c",
          "label": "（c）",
          "title": "共有点が接点だけの場合",
          "note": "他に共有点がない条件から3重解と決まる。x=−3 が本当に極値かの確認まで書く。",
          "difficulty": 1,
          "weak": 0,
          "strong": 0,
          "points": 8
        }
      ],
