  "profiles": [
    {
      "id": "weak",
      "title": "数学が苦手なら",
      "text": "基本レベルでも短時間で答えが出るとは限りません。独立して解ける短い問題を探し、点数を積み上げましょう。前問の結果が必要な設問は、その結果を確保できてから取り組みます。"
    },
    {
      "id": "strong",
      "title": "数学が得意なら",
      "text": "基本レベル・基本＋αレベルの取りこぼしをなくすことを最優先にします。長い計算や条件整理に時間がかかる問題は、残り時間を確認してから着手しましょう。"
    }
  ],
  "majorQuestions": [
    {
      "id": "math-q1",
      "label": "第Ⅰ問",
      "title": "三角関数を含む対数関数と整数値条件",
      "subtitle": "三角関数・指数関数・対数関数・2次関数",
      "summary": "三角式の真数を二次関数へ変換し、定義域、最大値、指数式が整数となる解の個数と総和を調べる。",
      "studyAction": "二倍角公式で真数を二次式へ直す。真数条件を解いて三角関数の定義域へ戻す",
      "requirements": [
        2.2,
        3.9,
        3.5,
        3.4,
        3.5
      ],
      "subquestions": [
        {
          "id": "math-q1-1",
          "label": "(1)",
          "title": "二倍角公式を用いて真数をtの二次式で表す。",
          "note": "後続の基礎となる短い式変形である。",
          "difficulty": 0,
          "weak": 0,
          "strong": 0,
          "points": 6
        },
        {
          "id": "math-q1-2",
          "label": "(2)",
          "title": "真数条件からfの定義域を求める。",
          "note": "真数条件の典型で、単位円の確認まで一本道である。",
          "difficulty": 1,
          "weak": 0,
          "strong": 0,
          "points": 6
        },
        {
          "id": "math-q1-3",
          "label": "(3)",
          "title": "二次関数の最大値からfの最大値とcosxを求める。",
          "note": "平方完成で安定して得点できる。",
          "difficulty": 2,
          "weak": 0,
          "strong": 0,
          "points": 7
        },
        {
          "id": "math-q1-4",
          "label": "(4)",
          "title": "5のf乗が整数となるxの個数と総和を求める。",
          "note": "場合分けを図で整理すれば処理できるが、数え落としに注意を要する。",
          "difficulty": 2,
          "weak": 1,
          "strong": 0,
          "points": 7
        },
        {
          "id": "math-q1-5",
          "label": "(5)",
          "title": "20のf乗が整数となるxの個数と総和を近似対数で求める。",
          "note": "近似計算と解数の対応が長く、最後に回す候補である。",
          "difficulty": 3,
          "weak": 1,
          "strong": 0,
          "points": 8
        }
      ],
      "questionsPath": "/past-exam-library/kindai/2025/mathematics/questions/#major-question-01",
      "answersPath": "/past-exam-library/kindai/2025/mathematics/answers/#major-question-01"
    },
    {
      "id": "math-q2",
      "label": "第Ⅱ問",
      "title": "硬貨列の漸化式と二項確率の最大項",
      "subtitle": "確率・数列",
      "summary": "偏りのある硬貨について基本確率、連続する表を禁じた列の漸化式、二項確率が一意に最大となる条件を扱う。",
      "studyAction": "余事象で確率を求める。末尾で場合分けして漸化式を立てる",
      "requirements": [
        1,
        3.4,
        3.6,
        3.6,
        3.6
      ],
      "subquestions": [
        {
          "id": "math-q2-1",
          "label": "(1)",
          "title": "3回投げたときの基本的な二項確率を求める。",
          "note": "典型公式で短時間に独立得点できる。",
          "difficulty": 0,
          "weak": 0,
          "strong": 0,
          "points": 6
        },
        {
          "id": "math-q2-2i",
          "label": "(2)(i)",
          "title": "連続する表を禁じた長さ2〜4の列を数える。",
          "note": "小規模列挙で確実に回収でき、次問の準備にもなる。",
          "difficulty": 1,
          "weak": 0,
          "strong": 0,
          "points": 6
        },
        {
          "id": "math-q2-2ii",
          "label": "(2)(ii)",
          "title": "末尾別の漸化式を用いてX5とX10の確率を求める。",
          "note": "漸化式が立てば反復計算で進められる。",
          "difficulty": 2,
          "weak": 0,
          "strong": 0,
          "points": 7
        },
        {
          "id": "math-q2-3",
          "label": "(3)",
          "title": "二つの確率条件を満たすpの範囲を求める。",
          "note": "文章条件の解釈と不等式処理が長く、時間配分上は最後の候補である。",
          "difficulty": 3,
          "weak": 1,
          "strong": 0,
          "points": 8
        }
      ],
      "questionsPath": "/past-exam-library/kindai/2025/mathematics/questions/#major-question-02",
      "answersPath": "/past-exam-library/kindai/2025/mathematics/answers/#major-question-02"
    },
    {
      "id": "math-q3",
      "label": "第Ⅲ問",
      "title": "球と平面の交円上を動く点と面積最小",
      "subtitle": "ベクトル・図形と方程式・微分法",
      "summary": "座標空間の正三角形と平面までの距離を求め、球との交円上の点の座標条件から三角形の面積を一変数化して最小化する。",
      "studyAction": "空間座標で距離と面積を求める。対称性から垂足を重心と見抜く",
      "requirements": [
        3.2,
        3.4,
        3,
        3.4,
        3.4
      ],
      "subquestions": [
        {
          "id": "math-q3-1",
          "label": "(1)",
          "title": "BCの中点までの距離と正三角形ABCの面積を求める。",
          "note": "公式適用で確実に独立得点できる。",
          "difficulty": 0,
          "weak": 0,
          "strong": 0,
          "points": 5
        },
        {
          "id": "math-q3-2",
          "label": "(2)",
          "title": "原点から平面ABCまでの距離を求める。",
          "note": "対称性を見抜けば計算は短い。",
          "difficulty": 1,
          "weak": 0,
          "strong": 0,
          "points": 6
        },
        {
          "id": "math-q3-3i",
          "label": "(3)(i)",
          "title": "球と平面の交円Dの半径を求める。",
          "note": "前問の距離を使う定型処理である。",
          "difficulty": 0,
          "weak": 0,
          "strong": 0,
          "points": 6
        },
        {
          "id": "math-q3-3ii",
          "label": "(3)(ii)",
          "title": "q+rとqrをpで表す。",
          "note": "二つの基本式を連立して順に整理できる。",
          "difficulty": 1,
          "weak": 0,
          "strong": 0,
          "points": 6
        },
        {
          "id": "math-q3-3iii",
          "label": "(3)(iii)",
          "title": "q,rが実数となる判別式からpの範囲を求める。",
          "note": "和と積が得られていれば判別式の典型問題になる。",
          "difficulty": 2,
          "weak": 0,
          "strong": 0,
          "points": 7
        },
        {
          "id": "math-q3-3iv",
          "label": "(3)(iv)",
          "title": "三角形PQRの面積をpで表して最小値を求める。",
          "note": "計算量が最も多く、前半の確実な得点後に扱うべき設問である。",
          "difficulty": 3,
          "weak": 1,
          "strong": 1,
          "points": 9
        }
      ],
