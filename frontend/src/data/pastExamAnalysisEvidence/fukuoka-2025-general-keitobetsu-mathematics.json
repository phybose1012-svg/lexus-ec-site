        4.5
      ],
      "subquestions": [
        {
          "id": "math-q3-i",
          "label": "(i)",
          "difficulty": "標準レベル",
          "weak": "後回し",
          "strong": "今解く！",
          "points": 14,
          "difficultyReason": "共有点条件を 2/a=\\sin2x に変形し、区間内で解が1つとなる水平線を決めた後、分数関数を微分して接線を作る必要がある。",
          "strategyReason": "倍角公式で共有点個数をグラフに帰着し、接点と微分係数を順に求める再現可能な経路である。苦手層は空欄短問後、 2/a=\\sin2x まで変形できる見通しが立った時点で戻る。",
          "prerequisites": {
            "weak_subject": [],
            "strong_subject": []
          }
        },
        {
          "id": "math-q3-ii",
          "label": "(ii)",
          "difficulty": "標準レベル",
          "weak": "捨てる！",
          "strong": "後回し",
          "points": 15,
          "difficultyReason": "曲線の上下関係から積分を立て、 1/\\cos x を u=\\sin x と部分分数で対数積分へ変形する長い計算を正確に記述する必要がある。",
          "strategyReason": "面積の立式後、分母を因数分解して部分分数と対数評価を進める長い記述計算である。苦手層は他の空欄と(i)を優先し回収対象外とする。得意層は(i)を完了し、残り15分程度を確保してから戻る。",
