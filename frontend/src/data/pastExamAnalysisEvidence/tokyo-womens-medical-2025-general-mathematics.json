        2.3
      ],
      "subquestions": [
        {
          "id": "math-q1-1",
          "label": "①",
          "difficulty": "基本レベル",
          "weak": "今解く！",
          "strong": "今解く！",
          "points": 9,
          "difficultyReason": "『123』を1個のかたまりとして7個を並べる典型的な確率計算。",
          "strategyReason": "全体を 9! 、条件を満たす並びを 7! とする一本道で、短時間に9点を狙える。",
          "prerequisites": {
            "weak_subject": [],
            "strong_subject": []
          }
        },
        {
          "id": "math-q1-2",
          "label": "②",
          "difficulty": "基本レベル",
          "weak": "今解く！",
          "strong": "今解く！",
          "points": 9,
          "difficultyReason": "変数を入れ換え、 dy/dx=1/(dx/dy) と三角関数の恒等式を使う典型問題。",
          "strategyReason": "逆関数の微分公式と 1+\\tan^2y=1/\\cos^2y が直結し、処理量が少ない。",
          "prerequisites": {
            "weak_subject": [],
            "strong_subject": []
          }
        },
        {
          "id": "math-q1-3",
          "label": "③",
          "difficulty": "基本＋αレベル",
          "weak": "今解く！",
          "strong": "今解く！",
          "points": 9,
          "difficultyReason": "赤白の回数の組を漏れなく列挙し、各組について二項係数で順序を数えて合計する。",
          "strategyReason": "2x+y=8 の5組を列挙して組合せを足す再現可能な手順であり、計算量も管理できる。",
          "prerequisites": {
            "weak_subject": [],
            "strong_subject": []
          }
        }
      ]
    },
    {
      "id": "math-q2",
      "label": "第2問",
      "sourceTitle": "正多面体の外接球・内接球",
      "requirements": [
        5,
        3,
        3,
        4,
        4
      ],
      "subquestions": [
        {
          "id": "math-q2-1",
          "label": "①",
          "difficulty": "標準レベル",
          "weak": "後回し",
          "strong": "今解く！",
          "points": 9,
          "difficultyReason": "立体の断面を読み、底面の重心と高さ、外接球中心の位置関係を順に組み立てる必要がある。",
          "strategyReason": "断面を作れば三平方で進むが、立体の高さと球中心の関係を図から正しく設定する必要がある。苦手層は独立短問を先に確保してから戻る。",
          "prerequisites": {
            "weak_subject": [],
            "strong_subject": []
          }
        },
        {
          "id": "math-q2-2",
          "label": "②",
          "difficulty": "標準レベル",
          "weak": "後回し",
          "strong": "後回し",
          "points": 9,
          "difficultyReason": "正八面体の断面と内接円を読み、面積を2通りに表して半径を決める必要がある。",
          "strategyReason": "断面の辺長と内接円への高さを対応させるまでが重い。短い確率・微分・距離公式の問題を先に解き、立体図を落ち着いて再構成できる時間に戻る。",
          "prerequisites": {
            "weak_subject": [],
            "strong_subject": []
          }
        }
      ]
    },
    {
