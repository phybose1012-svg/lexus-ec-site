          "difficulty": "基本＋αレベル",
          "weak": "今解く！",
          "strong": "今解く！",
          "points": 9,
          "difficultyReason": "共有点の x 座標を与える2次方程式を作り、判別式 D>0 と k>0 を併用する。",
          "strategyReason": "交点条件を判別式へ移す典型問題で、計算も短い。",
          "prerequisites": {
            "weak_subject": [],
            "strong_subject": []
          }
        },
        {
          "id": "math-q3-2",
