          "id": "math-q4-3",
          "label": "③",
          "difficulty": "標準レベル",
          "weak": "後回し",
          "strong": "後回し",
          "points": 9,
          "difficultyReason": "原点をFへ取り直し、2本の線分の方向を複素数の差で表して90度回転を読み取る。",
          "strategyReason": "計算自体は短いが、原点変更と線分方向の対応を図から再構成する必要がある。第1・3問の短問を確保し、第4問①②の回転表現に慣れてから戻る。",
          "prerequisites": {
            "weak_subject": [],
            "strong_subject": []
          }
        }
      ]
    }
