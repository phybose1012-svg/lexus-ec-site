  "majorQuestions": [
    {
      "id": "phys-q1",
      "label": "[1]",
      "sourceTitle": "鉛直面内の円運動と軌道から離れない条件",
      "requirements": [
        2.5,
        2.8,
        2.5,
        2.2,
        3.5
      ],
      "subquestions": [
        {
          "id": "phys-q1-a",
          "label": "ア",
          "difficulty": "標準レベル",
          "weak": "後回し",
          "strong": "今解く！",
          "points": 6,
          "difficultyReason": "任意角 \\theta で速さと垂直抗力を表し、円弧端で抗力が最小になることまで判断する必要がある。",
          "strategyReason": "仮6点。エネルギー保存と円運動の定型連立だが、角度と抗力の向きを読み違えやすい。得意層は先に式を確立し、苦手層は回折格子や熱力学の基本項目を回収後に戻る。",
          "prerequisites": {
            "weak_subject": [],
            "strong_subject": []
          }
        },
        {
          "id": "phys-q1-b",
          "label": "イ",
          "difficulty": "標準レベル",
          "weak": "後回し",
          "strong": "今解く！",
          "points": 5,
          "difficultyReason": "二つの高さ条件が同時に成り立つためのパラメータ条件へ不等式を変形する。",
          "strategyReason": "仮5点。アの結果を正しく使えば短いが、前問の不等式に依存する。苦手層は独立した基本問題を優先し、アを解けた場合に続ける。",
          "prerequisites": {
            "weak_subject": [
              "phys-q1-a"
            ],
            "strong_subject": [
              "phys-q1-a"
            ]
          }
        },
        {
          "id": "phys-q1-c",
          "label": "ウ",
          "difficulty": "標準レベル",
          "weak": "後回し",
          "strong": "今解く！",
          "points": 5,
          "difficultyReason": "内側円運動では抗力の向きが外側円弧と逆になるため、運動方程式を図から正しく立てる必要がある。",
          "strategyReason": "仮5点。内側円運動の定型式だが、角度の基準と高さ a(1+\\cos\\theta') の対応確認が要る。苦手層は時間が残れば図を描き直して処理する。",
          "prerequisites": {
            "weak_subject": [],
            "strong_subject": []
          }
        },
        {
          "id": "phys-q1-d",
          "label": "エ",
          "difficulty": "標準レベル",
          "weak": "後回し",
          "strong": "今解く！",
          "points": 5,
          "difficultyReason": "ウで導いた抗力の式へ \\theta'=0 を代入し、境界条件を不等式として読む。",
          "strategyReason": "仮5点。ウの抗力式を再利用すれば短いが前問依存がある。苦手層はウを解けたときだけ連続して回収する。",
          "prerequisites": {
            "weak_subject": [
              "phys-q1-c"
            ],
            "strong_subject": [
              "phys-q1-c"
            ]
          }
        },
        {
          "id": "phys-q1-e",
          "label": "オ",
          "difficulty": "基本＋αレベル",
          "weak": "後回し",
          "strong": "今解く！",
          "points": 6,
          "difficultyReason": "既出の外側円弧通過条件と半円筒到達条件を代入して共通範囲を取る。",
          "strategyReason": "仮6点。アとエの条件整理が済めば代入中心だが、複数条件を落としやすい。苦手層は前半を解けた場合にまとめて処理する。",
          "prerequisites": {
            "weak_subject": [
              "phys-q1-a",
              "phys-q1-d"
            ],
            "strong_subject": [
              "phys-q1-a",
              "phys-q1-d"
            ]
          }
        },
        {
          "id": "phys-q1-f",
          "label": "カ",
          "difficulty": "基本＋αレベル",
          "weak": "後回し",
          "strong": "今解く！",
          "points": 5,
          "difficultyReason": "アで得た上限式へ数値条件を代入し、オと同じ共通範囲の右端を確定する。",
          "strategyReason": "仮5点。アの式があれば代入だけで、オと同時に回収できる。苦手層も前提を満たした場合は短時間で記入する。",
          "prerequisites": {
            "weak_subject": [
              "phys-q1-a",
              "phys-q1-e"
            ],
            "strong_subject": [
              "phys-q1-a",
              "phys-q1-e"
            ]
          }
        }
      ]
    },
