        "sections": [
          {
            "title": "問題21　2重解を因数分解から読む",
            "blocks": [
              {
                "type": "formula",
                "purposeId": "factor-polynomial",
                "latex": "f(x)=(x-3)^2(x^2+10x+16)=(x-3)^2(x+2)(x+8)"
              },
              {
                "type": "prose",
                "text": "\\(x=3\\) は2重解で、\\(x=-2,-8\\) は単解です。"
              },
              {
                "type": "result",
                "text": "\\(k=3\\)。正解はタです。"
              }
            ]
          },
          {
            "title": "問題22・23　導関数の符号から極値を判定する",
            "blocks": [
              {
                "type": "formula",
                "purposeId": "differentiate",
                "latex": "f'(x)=4x^3+12x^2-70x-6=2(x-3)(2x^2+12x+1)"
              },
              {
                "type": "formula",
                "purposeId": "find-extrema-candidates",
                "latex": "f'(x)=0\\quad\\Longrightarrow\\quad x=\\alpha=-3-\\frac{\\sqrt{34}}2,\\quad x=\\beta=-3+\\frac{\\sqrt{34}}2,\\quad x=3"
              },
              {
                "type": "prose",
                "text": "\\(\\alpha<\\beta<3\\) で、\\(f'\\) の符号は左から負、正、負、正と変わります。したがって \\(\\alpha\\) と3で極小、\\(\\beta\\) で極大です。さらに \\(-8<\\alpha<-2\\) では因数分解した \\(f(x)\\) が負で、\\(f(3)=0\\) なので、最小値は \\(x=\\alpha\\) でとります。"
              },
              {
                "type": "table",
                "variant": "variation",
                "caption": "\\(f(x)\\) の増減表",
                "headers": [
                  "\\(x\\)",
                  "\\(-\\infty\\)",
                  "",
                  "\\(\\alpha\\)",
                  "",
                  "\\(\\beta\\)",
                  "",
                  "\\(3\\)",
                  "",
                  "\\(+\\infty\\)"
                ],
                "rows": [
                  [
                    "\\(f'(x)\\)",
                    "",
                    "−",
                    "0",
                    "+",
                    "0",
                    "−",
                    "0",
                    "+",
                    ""
                  ],
                  [
                    "\\(f(x)\\)",
                    "\\(+\\infty\\)",
                    "\\(\\searrow\\)",
                    "\\(m\\) 最小",
                    "\\(\\nearrow\\)",
                    "\\(M\\) 極大",
                    "\\(\\searrow\\)",
                    "\\(0\\) 極小",
                    "\\(\\nearrow\\)",
                    "\\(+\\infty\\)"
                  ]
                ]
              },
              { "type": "figure", "assetId": "ans-q21-25-quartic-graph" },
              {
                "type": "result",
                "text": "\\(p=\\alpha=-3-\\frac{\\sqrt{34}}2\\)（問題22・カ）、\\(q=\\beta=-3+\\frac{\\sqrt{34}}2\\)（問題23・マ）です。"
              }
            ]
          },
          {
            "title": "問題24　2つの極値の和を求める",
            "blocks": [
              {
                "type": "prose",
                "text": "\\(\\alpha\\)、\\(\\beta\\) は \\(2x^2+12x+1=0\\) の2解です。多項式の割り算で、この関係をそのまま使える恒等式を作ります。"
              },
              {
                "type": "formula",
                "purposeId": "reduce-by-equation",
                "latex": "f(x)=\\left(\\frac12x^2-x-\\frac{47}{4}\\right)(2x^2+12x+1)+136x+\\frac{623}{4}"
              },
              {
                "type": "prose",
                "text": "\\(x=\\alpha,\\beta\\) では第1項が0になるので、両方の点で \\(f(x)=136x+\\frac{623}{4}\\) です。また、解と係数の関係から \\(\\alpha+\\beta=-6\\) です。"
              },
              {
                "type": "formula",
                "purposeId": "evaluate-extrema",
                "latex": "M+m=136(\\alpha+\\beta)+2\\cdot\\frac{623}{4}=136(-6)+\\frac{623}{2}=-\\frac{1009}{2}"
              },
              {
                "type": "result",
                "text": "\\(2|M+m|=1009\\)。正解はワです。"
              }
            ]
          },
          {
            "title": "問題25　x軸と囲まれる部分を積分する",
            "blocks": [
              {
                "type": "prose",
                "text": "因数分解から、\\(f(x)\\geqq0\\) の部分で \\(x\\) 軸と有限に囲まれるのは \\(-2\\leqq x\\leqq3\\) です。\\(x=3\\) は2重解なので、グラフはここで \\(x\\) 軸に接します。"
              },
              {
                "type": "formula",
                "purposeId": "definite-integral",
                "latex": "\\begin{aligned}S&=\\int_{-2}^{3}(x-3)^2(x+2)(x+8)\\,dx\\\\&=\\int_{-5}^{0}(t^4+16t^3+55t^2)\\,dt=\\frac{1250}{3}\\qquad(t=x-3)\\end{aligned}"
              },
              {
                "type": "result",
                "text": "\\(\\sqrt{\\frac{3S}{2}}=\\sqrt{625}=25\\)。正解はナです。"
              }
            ]
          }
