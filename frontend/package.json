{
  "name": "lexus-ec-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:api": "node ./scripts/admin-local-api.mjs",
    "figure-editor:sync": "node ./scripts/sync-figure-editor.mjs",
    "figure-editor:check": "tsc -p tsconfig.figure-editor.json",
    "past-exam:import": "node ../.agents/skills/past-exam-question-importer/scripts/import-question-page.mjs",
    "past-exam:notation": "node ./scripts/normalize-past-exam-notation.mjs",
    "past-exam:answers": "node ../.agents/skills/past-exam-answer-author/scripts/build-all-answer-pages.mjs",
    "past-exam:answers:test": "node --test ../.agents/skills/past-exam-answer-author/scripts/build-answer-page.test.mjs",
    "past-exam:analyses": "node ./scripts/build-past-exam-analyses.mjs",
    "past-exam:analyses:test": "node --test ./scripts/past-exam-analysis.test.mjs",
    "past-exam:ui:test": "node --test ./scripts/past-exam-ui.test.mjs",
    "past-exam:seo:test": "node --test ./scripts/past-exam-seo.test.mjs",
    "past-exam:physics:test": "node --test ./scripts/past-exam-physics.test.mjs",
    "past-exam:figures:iwate-2025-mathematics": "node ./scripts/build-iwate-2025-mathematics-figures.mjs",
    "past-exam:figures:juntendo-2025-mathematics": "node ./scripts/build-juntendo-2025-general-a-mathematics-figures.mjs",
    "past-exam:mathematics-figures:test": "node --test ./scripts/past-exam-mathematics-figures.test.mjs",
    "past-exam:figure-handoff:test": "node --test ./scripts/past-exam-figure-handoff.test.mjs",
    "past-exam:juntendo-mathematics:test": "node --test ./scripts/past-exam-juntendo-2025-mathematics.test.mjs",
    "past-exam:notation:test": "node --test ./scripts/past-exam-notation.test.mjs",
    "dev": "node ./scripts/astro-command.mjs dev --host 127.0.0.1",
    "build": "node ./scripts/verify-build-inputs.mjs && npm run past-exam:answers && npm run past-exam:analyses && node ./scripts/astro-command.mjs check && node ./scripts/astro-command.mjs build",
    "preview": "node ./scripts/astro-command.mjs preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^6.0.5",
    "@penrose/core": "^3.3.1",
    "@phybose1012-svg/figure-editor": "file:vendor/figure-editor",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "playwright-core": "^1.61.0"
  }
}
